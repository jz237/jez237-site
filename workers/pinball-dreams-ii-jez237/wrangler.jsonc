{
  "name": "pinball-dreams-ii-jez237",
  "main": "index.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "LEADERBOARD_DB",
      "database_name": "pinball-dreams-hd-scores",
      "database_id": "c629f8e2-ad3a-4094-a39e-f4e5216d58d3"
    }
  ],
  "routes": [
    {
      "pattern": "jez237.com/games/2026-07-14/pinball-dreams-ii",
      "zone_name": "jez237.com"
    },
    {
      "pattern": "jez237.com/games/2026-07-14/pinball-dreams-ii/*",
      "zone_name": "jez237.com"
    }
  ]
}
