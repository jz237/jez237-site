+uint32_t audiodevice_take_reply(void) {
+    if(!reply_head) return 0;
+    struct AudioReply* node=reply_head;
+    uint32_t address=swap32(node->address);
+    reply_head=node->next;
+    if(!reply_head)reply_tail=0;
+    free(node);
+    return address;
