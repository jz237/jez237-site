diff --git a/d2/main/fx.c b/d2/main/fx.c
new file mode 100644
index 0000000..ecbc045
--- /dev/null
+++ b/d2/main/fx.c
@@ -0,0 +1,1247 @@
+/*
+ * Light halos, smoke and sparks (browser edition).
+ *
+ * Halos glow over the lamps of the mine's light textures, placed where the lamp's bright
+ * pixels are on each wall the renderer draws, and go out with the light. Missiles leave smoke
+ * trails, damaged robots smoke harder the closer they are to dying, and shots and explosions
+ * throw sparks. Purely visual: nothing here feeds back into the game, and it has its own
+ * random numbers so the game's (and demos') stay as they were. The page's Effects option
+ * (Module.d2options.effects) turns it off.
+ */
+
+#define GL_GLEXT_PROTOTYPES
+#include <GL/gl.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "fx.h"
+#include "segment.h"
+#include "gameseg.h"
+#include "game.h"
+#include "gameseq.h"
+#include "robot.h"
+#include "weapon.h"
+#include "laser.h"
+#include "player.h"
+#include "bm.h"
+#include "textures.h"
+#include "vclip.h"
+#include "piggy.h"
+#include "palette.h"
+#include "render.h"
+#include "../3d/globvars.h"
+#include "ogl_init.h"
+#include "internal.h"
+#ifdef __EMSCRIPTEN__
+#include "../arch/web/web.h"
+#endif
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+// for tests: lit sides seen, halos drawn, particles, vertices in the last 3D view
+static int fx_stats[4];
+EMSCRIPTEN_KEEPALIVE int *d2web_test_fx_stats(void) { return fx_stats; }
+#define STAT(i, v) (fx_stats[i] = (v))
+#else
+#define STAT(i, v)
+#endif
+
+static int fx_enabled(void)
+{
+#ifdef __EMSCRIPTEN__
+	return d2web_option(D2WEB_OPTION_EFFECTS);
+#else
+	return 0;
+#endif
+}
+
+// fireballs, shockwaves, debris and scorch marks
+static int boom_enabled(void)
+{
+#ifdef __EMSCRIPTEN__
+	return d2web_option(D2WEB_OPTION_EXPLOSIONS);
+#else
+	return 0;
+#endif
+}
+
+int fx_replaces_fireballs(void)
+{
+	return boom_enabled();
+}
+
+static unsigned fx_seed = 0x2545f491;
+static float frand(void)	// 0..1
+{
+	fx_seed = fx_seed * 1664525u + 1013904223u;
+	return (fx_seed >> 8) * (1.0f / 16777216.0f);
+}
+
+static float dot(const float *a, const float *b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
+static float len(const float *a) { return sqrtf(dot(a, a)); }
+static void fv(const vms_vector *v, float *o) { o[0] = f2fl(v->x); o[1] = f2fl(v->y); o[2] = f2fl(v->z); }
+static void madd(float *o, const float *a, const float *b, float s) { for (int k = 0; k < 3; k++) o[k] = a[k] + b[k] * s; }
+static float smooth(float e0, float e1, float x)
+{
+	float t = (x - e0) / (e1 - e0);
+	t = t < 0 ? 0 : t > 1 ? 1 : t;
+	return t * t * (3 - 2 * t);
+}
+
+static void rand_dir(float *d)
+{
+	float l2;
+	do {
+		for (int k = 0; k < 3; k++)
+			d[k] = frand() * 2 - 1;
+		l2 = dot(d, d);
+	} while (l2 > 1 || l2 < 0.01f);
+	l2 = 1 / sqrtf(l2);
+	for (int k = 0; k < 3; k++)
+		d[k] *= l2;
+}
+
+// ---------------------------------------------------------------------------------------
+// Particles
+
+enum { FX_SMOKE, FX_SPARK, FX_GLOW, FX_FIRE, FX_RING, FX_DEBRIS };
+
+typedef struct particle {
+	float pos[3], vel[3];
+	float age, life;	// seconds
+	float size, grow;	// half size in world units, growth per second
+	float angle, spin;
+	float drag;
+	float rgb[3], alpha;
+	float acc;			// debris: time toward its next smoke puff
+	unsigned char kind;
+	short seg;			// sparks and debris: the segment they're in (-1: not tracked), to bounce off walls
+} particle;
+
+#define MAX_PARTICLES 2048
+static particle particles[MAX_PARTICLES];
+static int n_particles;
+
+static int spawn_seg = -1;	// the segment the effect being made is in (fx_impact, fx_hit, fx_explosion)
+
+static particle *spawn(int kind)
+{
+	particle *p = n_particles < MAX_PARTICLES ? &particles[n_particles++] : &particles[(int)(frand() * (MAX_PARTICLES - 1))];
+	memset(p, 0, sizeof(*p));
+	p->kind = kind;
+	p->alpha = 1;
+	p->seg = kind == FX_SPARK || kind == FX_DEBRIS ? spawn_seg : -1;
+	return p;
+}
+
+// how lit the segment is, for smoke (which the game's lighting doesn't reach)
+static float seg_light(int segnum)
+{
+	float l = segnum >= 0 && segnum <= Highest_segment_index ? f2fl(Segments[segnum].static_light) : 0.6f;
+	return l < 0.25f ? 0.25f : l > 1 ? 1 : l;
+}
+
+static void smoke(const float *pos, const float *vel, float size, float grow, float life, float grey, float alpha, int segnum)
+{
+	particle *p = spawn(FX_SMOKE);
+	float l = grey * (0.45f + 0.55f * seg_light(segnum));
+	memcpy(p->pos, pos, sizeof(p->pos));
+	memcpy(p->vel, vel, sizeof(p->vel));
+	p->size = size;
+	p->grow = grow;
+	p->life = life;
+	p->angle = frand() * 6.283f;
+	p->spin = (frand() - 0.5f) * 1.2f;
+	p->drag = 1.2f;
+	p->rgb[0] = p->rgb[1] = p->rgb[2] = l;
+	p->rgb[2] *= 1.04f;
+	p->alpha = alpha;
+}
+
+// sparks fly out of pos, off the surface with this normal when there is one
+static void sparks(const float *pos, const float *normal, int n, const float *rgb, float speed, float life)
+{
+	for (int i = 0; i < n; i++) {
+		particle *p = spawn(FX_SPARK);
+		float d[3];
+		rand_dir(d);
+		if (normal) {
+			float s = dot(d, normal);
+			if (s < 0)
+				madd(d, d, normal, -2 * s);
+			madd(d, d, normal, 0.5f);
+			s = 1 / len(d);
+			for (int k = 0; k < 3; k++)
+				d[k] *= s;
+			madd(p->pos, pos, normal, 0.15f);
+		} else
+			memcpy(p->pos, pos, sizeof(p->pos));
+		for (int k = 0; k < 3; k++)
+			p->vel[k] = d[k] * speed * (0.35f + 0.65f * frand());
+		p->life = life * (0.45f + 0.55f * frand());
+		p->size = 0.12f + 0.08f * frand();
+		p->drag = 2.5f;
+		memcpy(p->rgb, rgb, sizeof(p->rgb));
+	}
+}
+
+static void glow(const float *pos, float size, float life, const float *rgb, float alpha)
+{
+	particle *p = spawn(FX_GLOW);
+	memcpy(p->pos, pos, sizeof(p->pos));
+	p->size = size;
+	p->life = life;
+	memcpy(p->rgb, rgb, sizeof(p->rgb));
+	p->alpha = alpha;
+}
+
+// the color a weapon's shots glow in (as the colored dynamic light finds it), made hot
+static void weapon_color(object *weapon, float *rgb)
+{
+	weapon_info *wi = &Weapon_info[weapon->id];
+	grs_bitmap *bm = NULL;
+	float m;
+	if (wi->render_type == WEAPON_RENDER_LASER || wi->render_type == WEAPON_RENDER_BLOB)
+		bm = &GameBitmaps[wi->bitmap.index];
+	else if (wi->render_type == WEAPON_RENDER_VCLIP && wi->weapon_vclip >= 0)
+		bm = &GameBitmaps[Vclip[wi->weapon_vclip].frames[0].index];
+	rgb[0] = 1, rgb[1] = 0.7f, rgb[2] = 0.35f;	// matter: hot metal
+	if (bm && !wi->matter) {
+		float c[3] = { (float)bm->avg_color_rgb[0], (float)bm->avg_color_rgb[1], (float)bm->avg_color_rgb[2] };
+		m = c[0] > c[1] ? c[0] : c[1];
+		m = m > c[2] ? m : c[2];
+		if (m > 0)
+			for (int k = 0; k < 3; k++)
+				rgb[k] = 0.35f + 0.65f * c[k] / m;	// toward white: sparks are hot
+	}
+}
+
+// ---------------------------------------------------------------------------------------
+// Explosions: layered fireballs that cool from white-hot to red, a shockwave, glowing debris
+// that trails smoke, and scorch marks that stay on the walls a while
+
+static void fire_puffs(const float *p, float s, int n, float life, float delay)
+{
+	for (int i = 0; i < n; i++) {
+		particle *q = spawn(FX_FIRE);
+		float d[3];
+		rand_dir(d);
+		q->age = -delay * (0.6f + 0.8f * frand());
+		madd(q->pos, p, d, s * 0.35f * frand());
+		for (int k = 0; k < 3; k++)
+			q->vel[k] = d[k] * s * (0.6f + 0.9f * frand());
+		q->drag = 3.0f;
+		q->size = s * (0.1f + 0.1f * frand());
+		q->grow = s * (0.3f + 0.3f * frand());
+		q->life = life * (0.65f + 0.5f * frand());
+		q->angle = frand() * 6.283f;
+		q->spin = (frand() - 0.5f) * 2.5f;
+	}
+}
+
+static void shockwave(const float *p, float s)
+{
+	particle *q = spawn(FX_RING);
+	memcpy(q->pos, p, sizeof(q->pos));
+	q->size = s * 0.3f;
+	q->grow = s * 9.0f;
+	q->life = 0.38f;
+}
+
+static void debris(const float *p, float s, int n)
+{
+	for (int i = 0; i < n; i++) {
+		particle *q = spawn(FX_DEBRIS);
+		float d[3], speed = (s * 4 + 14) * (0.35f + 0.65f * frand());
+		rand_dir(d);
+		memcpy(q->pos, p, sizeof(q->pos));
+		for (int k = 0; k < 3; k++)
+			q->vel[k] = d[k] * speed;
+		q->drag = 0.7f;
+		q->size = (0.12f + 0.25f * frand()) * (s < 3 ? 1 : s / 3 > 2.5f ? 2.5f : s / 3);
+		q->life = 1.4f + frand() * 1.2f;
+		q->angle = frand() * 6.283f;
+		q->spin = (frand() - 0.5f) * 14;
+	}
+}
+
+#define MAX_DECALS 96
+typedef struct decal {
+	float pos[3], t1[3], t2[3];	// center, half axes along the wall
+	float age, life, alpha, ember;
+} decal;
+static decal decals[MAX_DECALS];
+static int n_decals, next_decal;
+
+static void scorch(int segnum, int sidenum, const float *p, float size, float alpha, float life, float ember)
+{
+	side *sd = &Segments[segnum].sides[sidenum];
+	float n[3], a[3] = { 0, 0, 0 }, t1[3], t2[3], l, c, sn, ang = frand() * 6.283f;
+	decal *d;
+	if (sd->wall_num != -1)	// doors and such move: the mark would float
+		return;
+	fv(&sd->normals[0], n);
+	a[fabsf(n[0]) < 0.6f ? 0 : 1] = 1;
+	t1[0] = n[1] * a[2] - n[2] * a[1];
+	t1[1] = n[2] * a[0] - n[0] * a[2];
+	t1[2] = n[0] * a[1] - n[1] * a[0];
+	l = 1 / len(t1);
+	for (int k = 0; k < 3; k++)
+		t1[k] *= l;
+	t2[0] = n[1] * t1[2] - n[2] * t1[1];
+	t2[1] = n[2] * t1[0] - n[0] * t1[2];
+	t2[2] = n[0] * t1[1] - n[1] * t1[0];
+	d = n_decals < MAX_DECALS ? &decals[n_decals++] : &decals[next_decal++ % MAX_DECALS];
+	c = cosf(ang) * size;
+	sn = sinf(ang) * size;
+	for (int k = 0; k < 3; k++) {
+		d->t1[k] = t1[k] * c + t2[k] * sn;
+		d->t2[k] = t2[k] * c - t1[k] * sn;
+	}
+	madd(d->pos, p, n, 0.04f);
+	d->age = 0;
+	d->life = life;
+	d->alpha = alpha;
+	d->ember = ember;
+}
+
+// embers: small hot bits that drift out slowly and glow a long while
+static void embers(const float *p, float s, int n)
+{
+	float hot[3] = { 1.4f, 0.62f, 0.2f };
+	for (int i = 0; i < n; i++) {
+		particle *q;
+		sparks(p, NULL, 1, hot, 4 + s * 1.2f, 2.6f);
+		q = &particles[n_particles - 1];
+		q->drag = 0.5f;
+		q->size = 0.06f + 0.05f * frand();
+		q->life = 1.6f + 1.8f * frand();
+	}
+}
+
+// a blast of size s (the exploding thing's radius), in stages: a white flash, the fireball, billows of
+// fire a moment later, embers, then slow dark smoke
+static void blast(const float *p, float s)
+{
+	float flash[3] = { 1.6f, 1.4f, 1.1f }, core[3] = { 1.5f, 1.0f, 0.55f };
+	int n = (int)(7 + s * 0.5f);
+	glow(p, s * 1.5f, 0.1f, flash, 0.4f);
+	glow(p, s * 0.7f, 0.35f, core, 0.35f);
+	fire_puffs(p, s, n > 16 ? 16 : n, 1.1f + s * 0.03f, 0);
+	fire_puffs(p, s * 1.15f, n > 16 ? 8 : n / 2, 1.3f + s * 0.035f, 0.16f);	// the billows after
+	shockwave(p, s);
+	n = (int)(5 + s * 0.6f);
+	debris(p, s, n > 14 ? 14 : n);
+	n = (int)(8 + s * 1.5f);
+	embers(p, s, n > 30 ? 30 : n);
+	if (fx_enabled())
+		for (int i = 0; i < 8; i++) {
+			float d[3], at[3];
+			particle *q;
+			rand_dir(d);
+			madd(at, p, d, s * 0.3f);
+			for (int k = 0; k < 3; k++)
+				d[k] *= s * 0.25f;
+			smoke(at, d, s * 0.45f, s * 0.35f, 4.0f + frand() * 1.5f, 0.2f, 0.95f, -1);
+			q = &particles[n_particles - 1];
+			q->age = -(0.1f + 0.15f * frand());	// rolls up through the fire, darkening it
+		}
+}
+
+void fx_impact(object *weapon, int segnum, int sidenum, vms_vector *pos)
+{
+	spawn_seg = segnum;
+	weapon_info *wi = &Weapon_info[weapon->id];
+	float p[3], n[3], rgb[3];
+	if (boom_enabled()) {
+		fv(pos, p);
+		fv(&Segments[segnum].sides[sidenum].normals[0], n);
+		if (wi->damage_radius) {
+			float s = f2fl(wi->impact_size), at[3];
+			s = s < 2.5f ? 2.5f : s;
+			madd(at, p, n, s * 0.3f);
+			blast(at, s);
+			scorch(segnum, sidenum, p, s * 0.9f, 0.85f, 40, 1);
+		} else if (wi->matter)
+			scorch(segnum, sidenum, p, 0.4f, 0.7f, 20, 0);
+		else
+			scorch(segnum, sidenum, p, 0.75f, 0.45f, 12, 0.6f);
+	}
+	if (!fx_enabled())
+		return;
+	fv(pos, p);
+	fv(&Segments[segnum].sides[sidenum].normals[0], n);
+	weapon_color(weapon, rgb);
+	if (wi->damage_radius) {	// missiles
+		float hot[3] = { 1, 0.75f, 0.4f }, at[3];
+		sparks(p, n, 28, hot, 38, 1.0f);
+		for (int i = 0; i < 4; i++) {
+			float d[3];
+			rand_dir(d);
+			madd(at, p, n, 1.5f);
+			madd(d, d, n, 1.2f);
+			for (int k = 0; k < 3; k++)
+				d[k] *= 1.5f;
+			smoke(at, d, 2.2f, 2.4f, 2.4f + frand(), 0.28f, 0.5f, segnum);
+		}
+	} else if (wi->matter)	// vulcan, gauss: metal sparks
+		sparks(p, n, 7, rgb, 32, 0.4f);
+	else {	// lasers: a hot splash of sparks and a flash in the shot's color
+		float hot[3] = { rgb[0] * 1.6f, rgb[1] * 1.6f, rgb[2] * 1.6f };
+		sparks(p, n, 16, hot, 30, 0.5f);
+		glow(p, 1.6f, 0.14f, hot, 0.4f);
+		glow(p, 0.7f, 0.28f, rgb, 0.5f);
+	}
+}
+
+void fx_hit(object *weapon, vms_vector *pos)
+{
+	spawn_seg = weapon->segnum;
+	float p[3], rgb[3];
+	fv(pos, p);
+	if (boom_enabled() && Weapon_info[weapon->id].damage_radius) {
+		float s = f2fl(Weapon_info[weapon->id].impact_size);
+		blast(p, s < 2.5f ? 2.5f : s);
+	}
+	if (!fx_enabled())
+		return;
+	weapon_color(weapon, rgb);
+	sparks(p, NULL, Weapon_info[weapon->id].damage_radius ? 16 : 6, rgb, 24, 0.35f);
+}
+
+void fx_explosion(vms_vector *pos, int segnum, fix size)
+{
+	spawn_seg = segnum;
+	float p[3], s = f2fl(size), hot[3] = { 1, 0.7f, 0.35f };
+	int n = (int)(18 + s * 2.5f);
+	fv(pos, p);
+	if (boom_enabled())
+		blast(p, s);
+	if (!fx_enabled())
+		return;
+	sparks(p, NULL, n > 60 ? 60 : n, hot, 28 + s * 3, 1.1f);
+	n = (int)(3 + s / 3);
+	for (int i = 0; i < (n > 9 ? 9 : n); i++) {
+		float d[3], at[3];
+		rand_dir(d);
+		madd(at, p, d, s * 0.25f);
+		for (int k = 0; k < 3; k++)
+			d[k] *= s * 0.35f;
+		smoke(at, d, s * 0.35f, s * 0.3f, 2.6f + frand() * 1.2f, 0.32f, 0.6f, segnum);
+	}
+}
+
+// trails: puffs every TRAIL_STEP units along each missile's path
+#define TRAIL_STEP 1.1f
+static int trail_sig[MAX_OBJECTS];
+static float trail_last[MAX_OBJECTS][3], trail_acc[MAX_OBJECTS];
+static float smoke_acc[MAX_OBJECTS];
+static int smoke_sig[MAX_OBJECTS];
+
+static int is_missile(object *obj)
+{
+	weapon_info *wi = &Weapon_info[obj->id];
+	if (!wi->matter || wi->render_type != WEAPON_RENDER_POLYMODEL)
+		return 0;
+	switch (obj->id) {
+		case PROXIMITY_ID: case SUPERPROX_ID: case PMINE_ID: case ROBOT_SUPERPROX_ID:
+			return 0;
+	}
+	return 1;
+}
+
+static void missile_trail(object *obj, int objnum)
+{
+	float tail[3], back[3], d[3], l;
+	int n = 0;
+	fv(&obj->pos, tail);
+	fv(&obj->orient.fvec, back);
+	madd(tail, tail, back, -f2fl(obj->size) * 0.8f);
+	if (trail_sig[objnum] != obj->signature) {
+		trail_sig[objnum] = obj->signature;
+		memcpy(trail_last[objnum], tail, sizeof(tail));
+		trail_acc[objnum] = TRAIL_STEP;
+		return;
+	}
+	for (int k = 0; k < 3; k++)
+		d[k] = tail[k] - trail_last[objnum][k];
+	l = len(d);
+	for (float at = TRAIL_STEP - trail_acc[objnum]; at <= l && n < 16; at += TRAIL_STEP, n++) {
+		float p[3], v[3], hot[3] = { 1, 0.6f, 0.25f };
+		madd(p, trail_last[objnum], d, at / l);
+		rand_dir(v);
+		for (int k = 0; k < 3; k++)
+			v[k] *= 0.5f;
+		smoke(p, v, 0.5f, 1.6f, 1.1f + frand() * 0.5f, 0.85f, 0.5f, obj->segnum);
+		if (!n)
+			glow(p, 1.0f, 0.12f, hot, 0.6f);
+	}
+	trail_acc[objnum] = fmodf(trail_acc[objnum] + l, TRAIL_STEP);
+	memcpy(trail_last[objnum], tail, sizeof(tail));
+}
+
+// damaged robots (and other players' ships) smoke, harder the closer they are to dying
+static void damage_smoke(object *obj, int objnum, float dt)
+{
+	fix full = obj->type == OBJ_ROBOT ? Robot_info[obj->id].strength : i2f(100);
+	float frac, rate, pos[3], vel[3], view[3], s = f2fl(obj->size);
+	if (full <= 0 || obj->shields <= 0 || obj->shields >= full / 2)
+		return;
+	if (obj->type == OBJ_ROBOT ? Robot_info[obj->id].cloak_type : (Players[obj->id].flags & PLAYER_FLAGS_CLOAKED))
+		return;
+	fv(&obj->pos, pos);
+	fv(&View_position, view);
+	for (int k = 0; k < 3; k++)
+		view[k] -= pos[k];
+	if (len(view) > 250)
+		return;
+	if (smoke_sig[objnum] != obj->signature) {
+		smoke_sig[objnum] = obj->signature;
+		smoke_acc[objnum] = 0;
+	}
+	frac = f2fl(obj->shields) / f2fl(full);	// below 0.5
+	rate = 2 + (0.5f - frac) * 10;		// puffs per second
+	smoke_acc[objnum] += dt * rate;
+	fv(&obj->mtype.phys_info.velocity, vel);
+	while (smoke_acc[objnum] >= 1) {
+		float p[3], v[3];
+		smoke_acc[objnum] -= 1;
+		rand_dir(v);
+		madd(p, pos, v, s * 0.3f);
+		for (int k = 0; k < 3; k++)
+			v[k] = v[k] * 0.9f + vel[k] * 0.25f;
+		smoke(p, v, s * 0.22f, s * 0.35f, 1.4f + frand() * 0.7f, 0.26f, 0.55f, obj->segnum);
+	}
+	if (frac < 0.2f && frand() < dt * 1.5f) {
+		float hot[3] = { 1, 0.7f, 0.35f };
+		sparks(pos, NULL, 4, hot, 18, 0.4f);
+	}
+}
+
+static int fx_level = -1000;
+static void level_changed(void);
+
+void fx_frame(void)
+{
+	float dt = f2fl(FrameTime);
+	if (Current_level_num != fx_level)
+		level_changed();
+	if (dt <= 0)
+		return;
+	if (dt > 0.1f)
+		dt = 0.1f;
+	for (int i = 0; i < n_particles;) {
+		particle *p = &particles[i];
+		float drag;
+		if (p->age < 0) {	// a later stage of a blast, waiting its turn
+			p->age += dt;
+			i++;
+			continue;
+		}
+		p->age += dt;
+		if (p->age >= p->life) {
+			*p = particles[--n_particles];
+			continue;
+		}
+		drag = expf(-p->drag * dt);
+		for (int k = 0; k < 3; k++)
+			p->vel[k] *= drag;
+		if (p->seg >= 0 && p->seg <= Highest_segment_index) {	// ricochet off the walls instead of flying through them
+			vms_vector np;
+			int s;
+			np.x = fl2f(p->pos[0] + p->vel[0] * dt);
+			np.y = fl2f(p->pos[1] + p->vel[1] * dt);
+			np.z = fl2f(p->pos[2] + p->vel[2] * dt);
+			if ((s = find_point_seg(&np, p->seg)) < 0) {
+				float d[3];
+				rand_dir(d);
+				for (int k = 0; k < 3; k++)
+					p->vel[k] = -p->vel[k] * 0.45f + d[k] * len(p->vel) * 0.25f;
+			} else
+				p->seg = s;
+		}
+		for (int k = 0; k < 3; k++)
+			p->pos[k] += p->vel[k] * dt;
+		p->size += p->grow * dt;
+		p->angle += p->spin * dt;
+		i++;
+	}
+	for (int i = 0; i < n_decals;) {
+		decals[i].age += dt;
+		if (decals[i].age >= decals[i].life) {
+			decals[i] = decals[--n_decals];
+			continue;
+		}
+		i++;
+	}
+	if (!fx_enabled() && !boom_enabled()) {
+		n_particles = n_decals = 0;
+		return;
+	}
+	for (int i = 0, n = n_particles; i < n; i++) {	// hot debris trails smoke
+		particle *p = &particles[i];
+		if (p->kind != FX_DEBRIS || p->age > 1.1f)
+			continue;
+		for (p->acc += dt; p->acc > 0.045f; p->acc -= 0.045f) {
+			float v[3];
+			for (int k = 0; k < 3; k++)
+				v[k] = p->vel[k] * 0.08f;
+			smoke(p->pos, v, 0.22f, 1.1f, 0.7f + frand() * 0.4f, 0.32f, 0.5f * (1 - p->age / 1.1f), -1);
+			p = &particles[i];	// (spawning can move nothing, but stay safe)
+		}
+	}
+	if (!fx_enabled())
+		return;
+	for (int i = 0; i <= Highest_object_index; i++) {
+		object *obj = &Objects[i];
+		if (obj->type == OBJ_WEAPON && is_missile(obj))
+			missile_trail(obj, i);
+		else if (obj->type == OBJ_ROBOT || (obj->type == OBJ_PLAYER && obj != Viewer && (Game_mode & GM_MULTI)))
+			damage_smoke(obj, i, dt);
+	}
+}
+
+// ---------------------------------------------------------------------------------------
+// Light halos
+
+// Where a light texture's lamps are: its bright pixels, one spot per connected patch.
+#define MAX_SPOTS 4
+typedef struct light_spots {
+	signed char n;		// -1: not looked at yet
+	float u[MAX_SPOTS], v[MAX_SPOTS], r[MAX_SPOTS];	// texture units
+	float rgb[3];
+} light_spots;
+static light_spots tex_spots[MAX_TEXTURES];
+
+#define MAX_TEX_SIZE 256
+static unsigned char spot_mask[MAX_TEX_SIZE * MAX_TEX_SIZE];
+static unsigned short spot_stack[MAX_TEX_SIZE * MAX_TEX_SIZE];
+
+static light_spots *texture_spots(int tmap)
+{
+	light_spots *ls = &tex_spots[tmap];
+	grs_bitmap *bm;
+	unsigned char *px;
+	int w, h, maxl = 0, thresh;
+	double rgb[3] = { 0, 0, 0 };
+	int nbright = 0, nopaque = 0;
+	float area[MAX_SPOTS];
+
+	if (ls->n >= 0)
+		return ls;
+	ls->n = 0;
+	// lava, water and force fields glow all over: no lamps there
+	if (TmapInfo[tmap].flags & (TMI_VOLATILE | TMI_WATER | TMI_FORCE_FIELD))
+		return ls;
+	PIGGY_PAGE_IN(Textures[tmap]);
+	bm = &GameBitmaps[Textures[tmap].index];
+	w = bm->bm_w;
+	h = bm->bm_h;
+	if (w <= 0 || h <= 0 || w > MAX_TEX_SIZE || h > MAX_TEX_SIZE || !bm->bm_data)
+		return ls;
+	px = ogl_bitmap_indices(bm);
+#define LUM(c) (gr_palette[(c) * 3] * 30 + gr_palette[(c) * 3 + 1] * 59 + gr_palette[(c) * 3 + 2] * 11)	// 0..6300
+	for (int i = 0; i < w * h; i++)
+		if (px[i] < 254 && LUM(px[i]) > maxl)
+			maxl = LUM(px[i]);
+	if (maxl < 3800)	// no lamp bright enough to glow
+		return ls;
+	thresh = maxl * 82 / 100;
+	for (int i = 0; i < w * h; i++) {
+		spot_mask[i] = px[i] < 254 && LUM(px[i]) >= thresh;
+		if (px[i] < 254)
+			nopaque++;
+		if (spot_mask[i]) {
+			for (int k = 0; k < 3; k++)
+				rgb[k] += gr_palette[px[i] * 3 + k];
+			nbright++;
+		}
+	}
+#undef LUM
+	if (nbright < 3 || nbright > nopaque * 35 / 100)	// a glowing surface, not a lamp
+		return ls;
+	// connected patches, biggest kept
+	for (int start = 0; start < w * h; start++) {
+		int sp = 0, n = 0;
+		double sx = 0, sy = 0;
+		if (spot_mask[start] != 1)
+			continue;
+		spot_mask[start] = 2;
+		spot_stack[sp++] = start;
+		while (sp) {
+			int i = spot_stack[--sp], x = i % w, y = i / w;
+			int nb[4] = { x > 0 ? i - 1 : -1, x < w - 1 ? i + 1 : -1, y > 0 ? i - w : -1, y < h - 1 ? i + w : -1 };
+			n++;
+			sx += x + 0.5;
+			sy += y + 0.5;
+			for (int k = 0; k < 4; k++)
+				if (nb[k] >= 0 && spot_mask[nb[k]] == 1) {
+					spot_mask[nb[k]] = 2;
+					spot_stack[sp++] = nb[k];
+				}
+		}
+		if (n < 4)
+			continue;
+		int slot = ls->n < MAX_SPOTS ? ls->n++ : -1;
+		if (slot < 0) {	// replace the smallest if this one is bigger
+			slot = 0;
+			for (int k = 1; k < MAX_SPOTS; k++)
+				if (area[k] < area[slot])
+					slot = k;
+			if (area[slot] >= n)
+				continue;
+		}
+		area[slot] = n;
+		ls->u[slot] = sx / n / w;
+		ls->v[slot] = sy / n / h;
+		ls->r[slot] = sqrtf(n / 3.14159f) / w;
+	}
+	{
+		float m = 0;
+		for (int k = 0; k < 3; k++) {
+			ls->rgb[k] = rgb[k] / nbright;
+			m = ls->rgb[k] > m ? ls->rgb[k] : m;
+		}
+		for (int k = 0; k < 3; k++)	// the lamp's color, a little toward white
+			ls->rgb[k] = 0.3f + 0.7f * ls->rgb[k] / m;
+	}
+	return ls;
+}
+
+// the sides drawn in this view that may carry a lamp
+#define MAX_LIT_SIDES 1024
+static int lit_sides[MAX_LIT_SIDES], n_lit_sides;
+static unsigned short side_stamp[MAX_SEGMENTS][MAX_SIDES_PER_SEGMENT], pass = 1;
+
+void fx_note_face(int segnum, int sidenum)
+{
+	side *sd = &Segments[segnum].sides[sidenum];
+	if (side_stamp[segnum][sidenum] == pass || n_lit_sides >= MAX_LIT_SIDES)
+		return;
+	side_stamp[segnum][sidenum] = pass;
+	if (TmapInfo[sd->tmap_num].lighting > 0 || (sd->tmap_num2 && TmapInfo[sd->tmap_num2 & 0x3fff].lighting > 0))
+		lit_sides[n_lit_sides++] = segnum * MAX_SIDES_PER_SEGMENT + sidenum;
+}
+
+static void level_changed(void)
+{
+	fx_level = Current_level_num;
+	n_particles = n_decals = 0;
+	for (int i = 0; i < MAX_TEXTURES; i++)
+		tex_spots[i].n = -1;
+	memset(trail_sig, 0, sizeof(trail_sig));
+	memset(smoke_sig, 0, sizeof(smoke_sig));
+}
+
+// ---------------------------------------------------------------------------------------
+// Drawing
+
+typedef struct fxvert {
+	float pos[3];
+	float tex[2];
+	float color[4];
+} fxvert;
+
+#define MAX_HALOS 768
+#define MAX_FX_VERTS ((MAX_PARTICLES + MAX_HALOS) * 6)
+static fxvert fx_verts[MAX_FX_VERTS];
+static int n_verts;
+static float view_rows[3][3], view_pos[3], cam_right[3], cam_up[3];
+static GLuint glow_tex, smoke_tex, fire_tex, ring_tex, chunk_tex, scorch_tex;
+
+static void to_view(const float *p, float *o)
+{
+	float d[3] = { p[0] - view_pos[0], p[1] - view_pos[1], p[2] - view_pos[2] };
+	o[0] = dot(view_rows[0], d);
+	o[1] = dot(view_rows[1], d);
+	o[2] = -dot(view_rows[2], d);
+}
+
+static void vert(const float *p, float u, float v, const float *rgb, float a)
+{
+	fxvert *fv = &fx_verts[n_verts++];
+	to_view(p, fv->pos);
+	fv->tex[0] = u;
+	fv->tex[1] = v;
+	fv->color[0] = rgb[0];
+	fv->color[1] = rgb[1];
+	fv->color[2] = rgb[2];
+	fv->color[3] = a;
+}
+
+// a quad through the four world points, as two triangles
+static void quad(const float *a, const float *b, const float *c, const float *d, const float *rgb, float alpha)
+{
+	if (n_verts + 6 > MAX_FX_VERTS)
+		return;
+	vert(a, 0, 0, rgb, alpha); vert(b, 1, 0, rgb, alpha); vert(c, 1, 1, rgb, alpha);
+	vert(a, 0, 0, rgb, alpha); vert(c, 1, 1, rgb, alpha); vert(d, 0, 1, rgb, alpha);
+}
+
+// a camera-facing square, turned by angle
+static void billboard(const float *p, float size, float angle, const float *rgb, float alpha)
+{
+	float c = cosf(angle) * size, s = sinf(angle) * size, r[3], u[3], q[4][3];
+	for (int k = 0; k < 3; k++) {
+		r[k] = cam_right[k] * c + cam_up[k] * s;
+		u[k] = cam_up[k] * c - cam_right[k] * s;
+		q[0][k] = p[k] - r[k] + u[k];
+		q[1][k] = p[k] + r[k] + u[k];
+		q[2][k] = p[k] + r[k] - u[k];
+		q[3][k] = p[k] - r[k] - u[k];
+	}
+	quad(q[0], q[1], q[2], q[3], rgb, alpha);
+}
+
+// a spark: a glow stretched along its path, facing the camera
+static void streak(const float *head, const float *tail, float width, const float *rgb, float alpha)
+{
+	float d[3], to[3], side[3], q[4][3], l;
+	for (int k = 0; k < 3; k++) {
+		d[k] = head[k] - tail[k];
+		to[k] = view_pos[k] - head[k];
+	}
+	side[0] = d[1] * to[2] - d[2] * to[1];
+	side[1] = d[2] * to[0] - d[0] * to[2];
+	side[2] = d[0] * to[1] - d[1] * to[0];
+	l = len(side);
+	if (l < 1e-6f)
+		return;
+	l = width / l;
+	for (int k = 0; k < 3; k++) {
+		float e = d[k] * 0.3f;	// the glow's round ends reach past the path
+		q[0][k] = head[k] + e + side[k] * l;
+		q[1][k] = head[k] + e - side[k] * l;
+		q[2][k] = tail[k] - e - side[k] * l;
+		q[3][k] = tail[k] - e + side[k] * l;
+	}
+	quad(q[0], q[1], q[2], q[3], rgb, alpha);
+}
+
+enum { TEX_GLOW, TEX_SMOKE, TEX_FIRE, TEX_RING, TEX_CHUNK, TEX_SCORCH };
+
+// layered value noise (0..1), for fire and smoke that look like they have depth
+static float lattice(int x, int y, int seed)
+{
+	unsigned h = (unsigned)(x * 374761393 + y * 668265263 + seed * 2147483647u);
+	h = (h ^ (h >> 13)) * 1274126177u;
+	return ((h ^ (h >> 16)) & 0xffff) / 65535.0f;
+}
+static float vnoise2(float x, float y, int seed)
+{
+	int ix = (int)floorf(x), iy = (int)floorf(y);
+	float fx = x - ix, fy = y - iy;
+	fx = fx * fx * (3 - 2 * fx);
+	fy = fy * fy * (3 - 2 * fy);
+	float a = lattice(ix, iy, seed), b = lattice(ix + 1, iy, seed), c = lattice(ix, iy + 1, seed), d = lattice(ix + 1, iy + 1, seed);
+	return (a + (b - a) * fx) * (1 - fy) + (c + (d - c) * fx) * fy;
+}
+static float fbm(float x, float y, int seed)
+{
+	float v = 0, amp = 0.5f, tot = 0;
+	for (int o = 0; o < 5; o++, x *= 2.03f, y *= 2.03f, amp *= 0.5f) {
+		v += vnoise2(x, y, seed + o * 17) * amp;
+		tot += amp;
+	}
+	return v / tot;
+}
+
+static GLuint make_texture(int kind)
+{
+	static unsigned char img[256 * 256 * 4];
+	int S = kind == TEX_FIRE || kind == TEX_SMOKE ? 256 : 64;
+	GLuint t;
+	for (int y = 0; y < S; y++)
+		for (int x = 0; x < S; x++) {
+			float dx = (x + 0.5f) / (S / 2) - 1, dy = (y + 0.5f) / (S / 2) - 1, r = sqrtf(dx * dx + dy * dy), a, shade = 1;
+			float th = atan2f(dy, dx);
+			if (kind == TEX_FIRE) {
+				// a turbulent ball of flame: ragged licks at the edge, dark wisps of soot inside
+				float n = fbm(dx * 2.6f + 7.1f, dy * 2.6f + 3.3f, 11);
+				float w = fbm(dx * 5.3f + 1.7f, dy * 5.3f + 9.2f, 29);
+				a = smooth(1.0f, 0.12f, r + (n - 0.5f) * 1.1f) * (0.45f + 0.9f * n);
+				shade = 0.45f + 0.75f * smooth(0.25f, 0.75f, w) * (1 - 0.35f * r);
+			} else if (kind == TEX_RING) {
+				float q = (r - 0.72f) / 0.13f;
+				a = expf(-q * q) * smooth(1.0f, 0.9f, r) * (0.8f + 0.2f * sinf(th * 11));
+			} else if (kind == TEX_CHUNK) {
+				// a jagged lump of metal, lit from one side
+				float rr = 0.62f + 0.2f * sinf(th * 3 + 1) + 0.12f * sinf(th * 5 + 2.3f);
+				a = smooth(rr, rr - 0.1f, r);
+				shade = 0.55f + 0.45f * (0.5f - 0.35f * (dx + dy) - 0.3f * r);
+			} else if (kind == TEX_SCORCH) {
+				// soot, densest in the middle, with a ragged edge and streaks out from the blast
+				float n = 0.5f + 0.25f * sinf(th * 9 + 0.4f) * sinf(r * 13) + 0.2f * sinf(th * 23 + 1.7f);
+				a = smooth(1.0f, 0.25f, r + (n - 0.5f) * 0.35f) * (0.75f + 0.25f * n);
+			} else if (kind == TEX_SMOKE) {
+				// a billowing puff, lit from above: rounded lumps, brighter tops, darker undersides
+				float n = fbm(dx * 2.2f + 4.4f, dy * 2.2f + 8.8f, 43);
+				float b = fbm(dx * 4.5f + 2.5f, dy * 4.5f + 6.1f, 61);
+				a = smooth(1.0f, 0.2f, r + (n - 0.5f) * 0.9f) * (0.35f + 0.95f * n);
+				shade = 0.5f + 0.35f * (0.5f - dy * 0.5f) + 0.3f * (b - 0.5f);
+			} else
+				a = expf(-r * r * 5.5f) * smooth(1.0f, 0.7f, r);	// a glow that fades to nothing at the edge
+			a = a < 0 ? 0 : a > 1 ? 1 : a;
+			shade = shade < 0 ? 0 : shade > 1 ? 1 : shade;
+			img[(y * S + x) * 4] = img[(y * S + x) * 4 + 1] = img[(y * S + x) * 4 + 2] = (unsigned char)(shade * 255);
+			img[(y * S + x) * 4 + 3] = (unsigned char)(a * 255);
+		}
+	glGenTextures(1, &t);
+	glBindTexture(GL_TEXTURE_2D, t);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, S, S, 0, GL_RGBA, GL_UNSIGNED_BYTE, img);
+	glGenerateMipmap(GL_TEXTURE_2D);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	return t;
+}
+
+static int inside(const float *a, const float *b, const float *c, float u, float v, float *w)
+{
+	float d = (b[1] - c[1]) * (a[0] - c[0]) + (c[0] - b[0]) * (a[1] - c[1]);
+	if (fabsf(d) < 1e-6f)
+		return 0;
+	w[0] = ((b[1] - c[1]) * (u - c[0]) + (c[0] - b[0]) * (v - c[1])) / d;
+	w[1] = ((c[1] - a[1]) * (u - c[0]) + (a[0] - c[0]) * (v - c[1])) / d;
+	w[2] = 1 - w[0] - w[1];
+	return w[0] >= -0.02f && w[1] >= -0.02f && w[2] >= -0.02f;
+}
+
+static void halo(const float *at, const float *normal, float radius, const float *rgb)
+{
+	float to[3], dist, facing, fade, size, pull, p[3], c[3];
+	for (int k = 0; k < 3; k++)
+		to[k] = view_pos[k] - at[k];
+	dist = len(to);
+	if (dist < 0.01f)
+		return;
+	for (int k = 0; k < 3; k++)
+		to[k] /= dist;
+	facing = dot(normal, to);
+	size = radius * 5 + 1.5f;
+	size = size < 2 ? 2 : size > 10 ? 10 : size;
+	fade = smooth(0.05f, 0.5f, facing) * smooth(size * 0.4f, size * 1.5f, dist) * 0.5f;
+	if (fade < 0.01f)
+		return;
+	// Toward the camera, so its wall seen at an angle doesn't cut it (made smaller to look the
+	// same size from there).
+	pull = size * 2.5f < dist * 0.6f ? size * 2.5f : dist * 0.6f;
+	madd(p, at, to, pull);
+	for (int k = 0; k < 3; k++)
+		c[k] = rgb[k] * fade;
+	billboard(p, size * (dist - pull) / dist, 0, c, 1);
+}
+
+static void side_halos(int segnum, int sidenum)
+{
+	segment *seg = &Segments[segnum];
+	side *sd = &seg->sides[sidenum];
+	int t2 = sd->tmap_num2 & 0x3fff, rot = (sd->tmap_num2 >> 14) & 3, count = 0;
+	float P[4][3], U[4][2], n[3], minu = 1e9f, maxu = -1e9f, minv = 1e9f, maxv = -1e9f, scale, e0, e1;
+	light_spots *ls;
+
+	if (Light_subtracted[segnum] & (1 << sidenum))	// shot out or switched off
+		return;
+	if (sd->tmap_num2 && TmapInfo[t2].lighting > 0)
+		ls = texture_spots(t2);
+	else {
+		ls = texture_spots(sd->tmap_num);
+		rot = 0;
+	}
+	if (ls->n <= 0)
+		return;
+	for (int k = 0; k < 4; k++) {
+		fv(&Vertices[seg->verts[Side_to_verts[sidenum][k]]], P[k]);
+		U[k][0] = f2fl(sd->uvls[k].u);
+		U[k][1] = f2fl(sd->uvls[k].v);
+		minu = U[k][0] < minu ? U[k][0] : minu;
+		maxu = U[k][0] > maxu ? U[k][0] : maxu;
+		minv = U[k][1] < minv ? U[k][1] : minv;
+		maxv = U[k][1] > maxv ? U[k][1] : maxv;
+	}
+	fv(&sd->normals[0], n);
+	{	// world units per texture repeat
+		float d[3], du = U[1][0] - U[0][0], dv = U[1][1] - U[0][1];
+		for (int k = 0; k < 3; k++)
+			d[k] = P[1][k] - P[0][k];
+		e0 = sqrtf(du * du + dv * dv) > 1e-4f ? len(d) / sqrtf(du * du + dv * dv) : 0;
+		du = U[2][0] - U[1][0];
+		dv = U[2][1] - U[1][1];
+		for (int k = 0; k < 3; k++)
+			d[k] = P[2][k] - P[1][k];
+		e1 = sqrtf(du * du + dv * dv) > 1e-4f ? len(d) / sqrtf(du * du + dv * dv) : 0;
+		scale = e0 && e1 ? (e0 + e1) / 2 : e0 + e1;
+	}
+	for (int s = 0; s < ls->n; s++) {
+		float u = ls->u[s], v = ls->v[s];
+		// the overlay is turned on the wall as the texture merger turns it
+		switch (rot) {
+			case 1: u = ls->v[s]; v = 1 - ls->u[s]; break;
+			case 2: u = 1 - ls->u[s]; v = 1 - ls->v[s]; break;
+			case 3: u = 1 - ls->v[s]; v = ls->u[s]; break;
+		}
+		// every repeat of the texture on this side
+		for (int i = (int)floorf(minu - u); i <= (int)ceilf(maxu - u) && count < 16; i++)
+			for (int j = (int)floorf(minv - v); j <= (int)ceilf(maxv - v) && count < 16; j++) {
+				float w[3], at[3];
+				int a = 0, b = 1, c = 2;
+				if (!inside(U[0], U[1], U[2], u + i, v + j, w)) {
+					if (!inside(U[0], U[2], U[3], u + i, v + j, w))
+						continue;
+					b = 2;
+					c = 3;
+				}
+				for (int k = 0; k < 3; k++)
+					at[k] = P[a][k] * w[0] + P[b][k] * w[1] + P[c][k] * w[2];
+				halo(at, n, ls->r[s] * scale, ls->rgb);
+				count++;
+			}
+	}
+}
+
+static int smoke_order[MAX_PARTICLES];
+static float smoke_depth[MAX_PARTICLES];
+static int far_first(const void *a, const void *b)
+{
+	float da = smoke_depth[*(const int *)a], db = smoke_depth[*(const int *)b];
+	return da < db ? 1 : da > db ? -1 : 0;
+}
+
+static void draw(GLuint tex, int first, int count)
+{
+	if (count <= 0)
+		return;
+	glBindTexture(GL_TEXTURE_2D, tex);
+	glDrawArrays(GL_TRIANGLES, first, count);
+}
+
+// fire cools from white-hot through orange to deep red (brighter than white for the glow)
+static void fire_color(float t, float *c)
+{
+	static const float k[4][3] = { { 1.3f, 1.1f, 0.75f }, { 1.05f, 0.5f, 0.17f }, { 0.45f, 0.13f, 0.035f }, { 0.1f, 0.02f, 0.01f } };
+	static const float at[4] = { 0, 0.15f, 0.5f, 1 };
+	int i = t < at[1] ? 0 : t < at[2] ? 1 : 2;
+	float f = (t - at[i]) / (at[i + 1] - at[i]), fade = smooth(0, 0.06f, t) * (1 - t);
+	for (int j = 0; j < 3; j++)
+		c[j] = (k[i][j] + (k[i + 1][j] - k[i][j]) * f) * fade;
+}
+
+// what fx_render draws, in order: each a texture and a blend over a range of fx_verts
+typedef struct batch {
+	GLuint *tex;
+	int additive, first;
+} batch;
+static batch batches[8];
+static int n_batches;
+
+static void batch_begin(GLuint *tex, int additive)
+{
+	batches[n_batches].tex = tex;
+	batches[n_batches].additive = additive;
+	batches[n_batches].first = n_verts;
+	n_batches++;
+}
+
+int fx_blasts(float (*pos)[4], float (*prm)[4], int max)
+{
+	int n = 0;
+	if (!boom_enabled())
+		return 0;
+	for (int i = 0; i < n_particles && n < max; i++) {
+		particle *p = &particles[i];
+		float v[3];
+		if (p->kind != FX_RING || p->age < 0)
+			continue;
+		to_view(p->pos, v);	// (view_rows are this frame's: fx_render ran before the post pass)
+		if (v[2] > -0.5f)
+			continue;
+		pos[n][0] = v[0], pos[n][1] = v[1], pos[n][2] = v[2], pos[n][3] = p->size;
+		prm[n][0] = p->age / p->life, prm[n][1] = p->grow / 9, prm[n][2] = prm[n][3] = 0;
+		n++;
+	}
+	return n;
+}
+
+void fx_render(void)
+{
+	int n_smoke = 0, scissor, boom = boom_enabled();
+	pass = pass == 0xffff ? 1 : pass + 1;
+	if (!fx_enabled() && !boom) {
+		n_lit_sides = 0;
+		return;
+	}
+	if (Current_level_num != fx_level)
+		level_changed();
+	for (int r = 0; r < 3; r++) {
+		const vms_vector *row = r == 0 ? &View_matrix.rvec : r == 1 ? &View_matrix.uvec : &View_matrix.fvec;
+		fv(row, view_rows[r]);
+	}
+	fv(&View_position, view_pos);
+	fv(&Unscaled_matrix.rvec, cam_right);
+	fv(&Unscaled_matrix.uvec, cam_up);
+	n_verts = 0;
+	n_batches = 0;
+
+	// scorch marks darken the walls; fresh ones still glow
+	batch_begin(&scorch_tex, 0);
+	for (int i = 0; i < n_decals; i++) {
+		decal *d = &decals[i];
+		float q[4][3], dark[3] = { 0.03f, 0.025f, 0.02f };
+		for (int k = 0; k < 3; k++) {
+			q[0][k] = d->pos[k] - d->t1[k] - d->t2[k];
+			q[1][k] = d->pos[k] + d->t1[k] - d->t2[k];
+			q[2][k] = d->pos[k] + d->t1[k] + d->t2[k];
+			q[3][k] = d->pos[k] - d->t1[k] + d->t2[k];
+		}
+		quad(q[0], q[1], q[2], q[3], dark, d->alpha * (1 - smooth(d->life * 0.7f, d->life, d->age)));
+	}
+	batch_begin(&scorch_tex, 1);
+	for (int i = 0; i < n_decals; i++) {
+		decal *d = &decals[i];
+		float q[4][3], f = 1 - smooth(0, 1.8f, d->age), c[3];
+		if (d->ember <= 0 || f <= 0)
+			continue;
+		f *= f * d->ember;
+		c[0] = 2.0f * f, c[1] = 0.55f * f, c[2] = 0.12f * f;
+		for (int k = 0; k < 3; k++) {
+			q[0][k] = d->pos[k] - d->t1[k] * 0.7f - d->t2[k] * 0.7f;
+			q[1][k] = d->pos[k] + d->t1[k] * 0.7f - d->t2[k] * 0.7f;
+			q[2][k] = d->pos[k] + d->t1[k] * 0.7f + d->t2[k] * 0.7f;
+			q[3][k] = d->pos[k] - d->t1[k] * 0.7f + d->t2[k] * 0.7f;
+		}
+		quad(q[0], q[1], q[2], q[3], c, 1);
+	}
+
+	// smoke, far to near, blended over what is behind it
+	batch_begin(&smoke_tex, 0);
+	for (int i = 0; i < n_particles; i++)
+		if (particles[i].kind == FX_SMOKE && particles[i].age >= 0) {
+			float v[3];
+			to_view(particles[i].pos, v);
+			if (v[2] > -0.5f)	// behind the camera
+				continue;
+			smoke_depth[i] = -v[2];
+			smoke_order[n_smoke++] = i;
+		}
+	qsort(smoke_order, n_smoke, sizeof(int), far_first);
+	for (int i = 0; i < n_smoke; i++) {
+		particle *p = &particles[smoke_order[i]];
+		float t = p->age / p->life;
+		billboard(p->pos, p->size, p->angle, p->rgb, p->alpha * smooth(0, 0.08f, t) * (1 - t) * sqrtf(1 - t));
+	}
+
+	// debris: dark lumps, glowing while still hot
+	batch_begin(&chunk_tex, 0);
+	for (int i = 0; i < n_particles; i++) {
+		particle *p = &particles[i];
+		float heat, c[3], t;
+		if (p->kind != FX_DEBRIS || p->age < 0)
+			continue;
+		t = p->age / p->life;
+		heat = 1 - smooth(0, 1.0f, p->age);
+		c[0] = 0.13f + 1.5f * heat;
+		c[1] = 0.11f + 0.6f * heat * heat;
+		c[2] = 0.1f + 0.15f * heat * heat * heat;
+		billboard(p->pos, p->size, p->angle, c, 1 - smooth(0.85f, 1, t));
+	}
+
+	// flames and shockwaves, added to the light
+	batch_begin(&fire_tex, 1);
+	for (int i = 0; i < n_particles; i++) {
+		particle *p = &particles[i];
+		float c[3];
+		if (p->kind != FX_FIRE || p->age < 0)
+			continue;
+		fire_color(p->age / p->life, c);
+		for (int k = 0; k < 3; k++)
+			c[k] *= 0.5f;	// overlapping puffs add up: dimmer each, so they keep their shape
+		billboard(p->pos, p->size, p->angle, c, 1);
+	}
+	batch_begin(&ring_tex, 1);
+	for (int i = 0; i < n_particles; i++) {
+		particle *p = &particles[i];
+		float t, f, c[3];
+		if (p->kind != FX_RING || p->age < 0)
+			continue;
+		t = p->age / p->life;
+		f = (1 - t) * (1 - t) * 0.45f;
+		c[0] = 1.5f * f, c[1] = 1.15f * f, c[2] = 0.75f * f;
+		billboard(p->pos, p->size, 0, c, 1);
+	}
+	batch_begin(&glow_tex, 1);
+
+	// glows: halos, sparks, flashes, added to the light
+	STAT(0, n_lit_sides);
+	{
+		int before = n_verts;
+		for (int i = 0; i < n_lit_sides && fx_enabled(); i++)
+			side_halos(lit_sides[i] / MAX_SIDES_PER_SEGMENT, lit_sides[i] % MAX_SIDES_PER_SEGMENT);
+		STAT(1, (n_verts - before) / 6);
+	}
+	n_lit_sides = 0;
+	for (int i = 0; i < n_particles; i++) {
+		particle *p = &particles[i];
+		float t = p->age / p->life, c[3];
+		if (p->age < 0)
+			continue;
+		if (p->kind == FX_SPARK) {
+			float tail[3], f = (1 - t) * (1 - t);
+			// cools from white-hot to the weapon's color and red
+			c[0] = p->rgb[0] * f;
+			c[1] = p->rgb[1] * f * (1 - 0.45f * t);
+			c[2] = p->rgb[2] * f * (1 - 0.8f * t);
+			madd(tail, p->pos, p->vel, -0.06f);
+			streak(p->pos, tail, p->size, c, 1);
+		} else if (p->kind == FX_GLOW) {
+			float f = p->alpha * (1 - t);
+			for (int k = 0; k < 3; k++)
+				c[k] = p->rgb[k] * f;
+			billboard(p->pos, p->size * (1 + t), 0, c, 1);
+		} else if (p->kind == FX_DEBRIS && p->age < 1.0f) {	// its hot glow, along its path
+			float tail[3], h = 1 - p->age;
+			h *= h;
+			c[0] = 1.4f * h, c[1] = 0.55f * h, c[2] = 0.15f * h;
+			madd(tail, p->pos, p->vel, -0.035f);
+			streak(p->pos, tail, p->size * 1.3f, c, 1);
+		}
+	}
+	STAT(2, n_particles);
+	STAT(3, n_verts);
+	if (!n_verts)
+		return;
+
+	batches[n_batches].first = n_verts;	// the end of the last one
+	if (!glow_tex) {
+		glow_tex = make_texture(TEX_GLOW);
+		smoke_tex = make_texture(TEX_SMOKE);
+		fire_tex = make_texture(TEX_FIRE);
+		ring_tex = make_texture(TEX_RING);
+		chunk_tex = make_texture(TEX_CHUNK);
+		scorch_tex = make_texture(TEX_SCORCH);
+	}
+	scissor = glIsEnabled(GL_SCISSOR_TEST);
+	glDisable(GL_SCISSOR_TEST);
+	glDisable(GL_CULL_FACE);
+	glDepthMask(GL_FALSE);
+	OGL_ENABLE(TEXTURE_2D);
+	glVertexPointer(3, GL_FLOAT, sizeof(fxvert), fx_verts[0].pos);
+	glTexCoordPointer(2, GL_FLOAT, sizeof(fxvert), fx_verts[0].tex);
+	glColorPointer(4, GL_FLOAT, sizeof(fxvert), fx_verts[0].color);
+	glEnableClientState(GL_VERTEX_ARRAY);
+	glEnableClientState(GL_TEXTURE_COORD_ARRAY);
+	glEnableClientState(GL_COLOR_ARRAY);
+	for (int i = 0; i < n_batches; i++) {
+		glBlendFunc(GL_SRC_ALPHA, batches[i].additive ? GL_ONE : GL_ONE_MINUS_SRC_ALPHA);
+		draw(*batches[i].tex, batches[i].first, batches[i + 1].first - batches[i].first);
+	}
+	glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	glDisableClientState(GL_COLOR_ARRAY);
+	glDisableClientState(GL_TEXTURE_COORD_ARRAY);
+	glDisableClientState(GL_VERTEX_ARRAY);
+	glDepthMask(GL_TRUE);
+	glEnable(GL_CULL_FACE);
+	if (scissor)
+		glEnable(GL_SCISSOR_TEST);
+}
