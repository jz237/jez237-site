+	if (!img)
+		return 0;
+	memset(pdata, 0, sizeof(*pdata));
+	pdata->width = w;
+	pdata->height = h;
+	pdata->depth = 8;
+	pdata->channels = 4;
+	pdata->color = 1;
+	pdata->alpha = n == 2 || n == 4;
+	pdata->data = img;
+	return 1;
