+			add_light_cand(obj_light_emission, obj->segnum, &obj->pos, objnum);
+	}
+
+	select_pp_lights();
+	for (vv = 0; vv < N_light_cands; vv++) {
+		light_cand *c = &Light_cands[vv];
+		pp_apply = c->pp;
+		apply_light(c->e, c->seg, &c->pos, n_render_vertices, render_vertices, vert_segnum_list, c->objnum);
 	}
+	pp_apply = 0;
 }
 
