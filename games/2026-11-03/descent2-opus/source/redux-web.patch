diff --git a/d2/arch/web/library_d2web.js b/d2/arch/web/library_d2web.js
new file mode 100644
index 0000000..7e1ff1a
--- /dev/null
+++ b/d2/arch/web/library_d2web.js
@@ -0,0 +1,356 @@
+// Emscripten JS library: browser glue for the Descent II web build.
+// The page fills Module.d2cd.tracks[n] with object URLs of the ripped CD tracks
+// (index = CD track number; track 1 is the data track and stays empty).
+
+addToLibrary({
+  $D2CD__postset: 'D2CD.init();',
+  $D2CD: {
+    audio: null,
+    first: 0,
+    last: 0,
+    cur: 0,
+    state: 0, // 0 stopped, 1 playing, 2 paused
+    volume: 1,
+    // status for the page (and tests): which CD track is playing and where
+    init() {
+      Module.cdStatus = () => ({
+        state: D2CD.state,
+        track: D2CD.cur,
+        time: D2CD.audio ? D2CD.audio.currentTime : 0,
+        paused: D2CD.audio ? D2CD.audio.paused : true,
+        volume: D2CD.volume,
+      });
+    },
+    tracks() {
+      return (Module.d2cd && Module.d2cd.tracks) || [];
+    },
+    el() {
+      if (!D2CD.audio) {
+        D2CD.audio = new Audio();
+        D2CD.audio.preload = 'auto';
+        D2CD.audio.addEventListener('ended', () => {
+          if (D2CD.state !== 1) return;
+          if (D2CD.cur < D2CD.last && D2CD.start(D2CD.cur + 1)) return;
+          D2CD.state = 0;
+        });
+      }
+      return D2CD.audio;
+    },
+    start(n) {
+      const url = D2CD.tracks()[n];
+      if (!url) return false;
+      const a = D2CD.el();
+      D2CD.cur = n;
+      a.src = url;
+      a.volume = D2CD.volume;
+      a.play().catch((e) => console.warn('CD audio play failed', e));
+      D2CD.state = 1;
+      if (Module.onCdTrack) Module.onCdTrack(n);
+      return true;
+    },
+  },
+
+  d2web_cd_numtracks__deps: ['$D2CD'],
+  d2web_cd_numtracks: () => {
+    const t = D2CD.tracks();
+    return t.length ? t.length - 1 : 0;
+  },
+
+  d2web_cd_play__deps: ['$D2CD'],
+  d2web_cd_play: (first, last) => {
+    const n = D2CD.tracks().length - 1;
+    if (first < 1 || first > n) return 0;
+    D2CD.first = first;
+    D2CD.last = Math.min(Math.max(last, first), n);
+    return D2CD.start(first) ? 1 : 0;
+  },
+
+  d2web_cd_stop__deps: ['$D2CD'],
+  d2web_cd_stop: () => {
+    if (D2CD.audio) D2CD.audio.pause();
+    D2CD.state = 0;
+  },
+
+  d2web_cd_pause__deps: ['$D2CD'],
+  d2web_cd_pause: () => {
+    if (D2CD.state === 1 && D2CD.audio) {
+      D2CD.audio.pause();
+      D2CD.state = 2;
+    }
+  },
+
+  d2web_cd_resume__deps: ['$D2CD'],
+  d2web_cd_resume: () => {
+    if (D2CD.state === 2 && D2CD.audio) {
+      D2CD.audio.play().catch(() => {});
+      D2CD.state = 1;
+    }
+  },
+
+  d2web_cd_status__deps: ['$D2CD'],
+  d2web_cd_status: () => D2CD.state,
+
+  d2web_cd_track__deps: ['$D2CD'],
+  d2web_cd_track: () => D2CD.cur,
+
+  d2web_cd_volume__deps: ['$D2CD'],
+  d2web_cd_volume: (v) => {
+    D2CD.volume = Math.max(0, Math.min(8, v)) / 8;
+    if (D2CD.audio) D2CD.audio.volume = D2CD.volume;
+  },
+
+  // MIDI music is played by the page's General MIDI synth (Module.d2midi, see d2loader.js).
+  d2web_midi_play: (data, len, loop) => {
+    if (!Module.d2midi) return 0;
+    Module.d2midi.play(HEAPU8.slice(data, data + len), !!loop);
+    return 1;
+  },
+  d2web_midi_stop: () => { if (Module.d2midi) Module.d2midi.stop(); },
+  d2web_midi_pause: () => { if (Module.d2midi) Module.d2midi.pause(); },
+  d2web_midi_resume: () => { if (Module.d2midi) Module.d2midi.resume(); },
+  d2web_midi_pause_resume: () => { if (Module.d2midi) Module.d2midi.toggle(); },
+  d2web_midi_volume: (v) => { if (Module.d2midi) Module.d2midi.volume(Math.max(0, Math.min(8, v)) / 8); },
+
+  // Music folder: the page fills Module.d2music with object URLs of the player's own music
+  // files, songs[SONG_*] (title, briefing, endlevel, endgame, credits) and levels[] in play order.
+  $D2Music__postset: 'D2Music.init();',
+  $D2Music: {
+    audio: null,
+    state: 0, // 0 stopped, 1 playing, 2 paused
+    volume: 1,
+    label: '', // 'song 0' or 'level 3', for the page and tests
+    level: -1, // levels[] index while level music plays
+    next: null, // started when the current file ends
+    init() {
+      Module.musicStatus = () => ({
+        state: D2Music.state,
+        playing: D2Music.label,
+        level: D2Music.level,
+        time: D2Music.audio ? D2Music.audio.currentTime : 0,
+        paused: D2Music.audio ? D2Music.audio.paused : true,
+        volume: D2Music.volume,
+      });
+    },
+    set() {
+      return Module.d2music || { songs: [], levels: [] };
+    },
+    el() {
+      if (!D2Music.audio) {
+        D2Music.audio = new Audio();
+        D2Music.audio.preload = 'auto';
+        D2Music.audio.addEventListener('ended', () => {
+          if (D2Music.state !== 1) return;
+          if (D2Music.next) D2Music.next();
+          else D2Music.state = 0;
+        });
+      }
+      return D2Music.audio;
+    },
+    start(url, loop, label, next) {
+      const a = D2Music.el();
+      a.src = url;
+      a.loop = loop;
+      a.volume = D2Music.volume;
+      a.play().catch((e) => console.warn('Music play failed', e));
+      D2Music.state = 1;
+      D2Music.label = label;
+      D2Music.next = next || null;
+      if (Module.onMusicTrack) Module.onMusicTrack(label);
+    },
+    // level music plays through the playlist and wraps, like the CD
+    playLevel(i) {
+      const levels = D2Music.set().levels;
+      D2Music.level = ((i % levels.length) + levels.length) % levels.length;
+      D2Music.start(levels[D2Music.level], levels.length === 1, 'level ' + D2Music.level,
+        () => D2Music.playLevel(D2Music.level + 1));
+    },
+  },
+
+  d2web_music_has__deps: ['$D2Music'],
+  d2web_music_has: (songnum) => {
+    const s = D2Music.set();
+    if (songnum < 0) return s.levels.length || s.songs.some(Boolean) ? 1 : 0;
+    if (songnum >= 5) return s.levels.length ? 1 : 0; // SONG_FIRST_LEVEL_SONG
+    return s.songs[songnum] ? 1 : 0;
+  },
+
+  d2web_music_song__deps: ['$D2Music'],
+  d2web_music_song: (songnum, repeat, thenCredits) => {
+    const songs = D2Music.set().songs;
+    const url = songs[songnum];
+    if (!url) return 0;
+    D2Music.level = -1;
+    // the title plays once and hands over to the looping credits song, as on the CD
+    if (thenCredits && songs[4] && songnum !== 4) {
+      D2Music.start(url, false, 'song ' + songnum, () => D2Music.start(songs[4], true, 'song 4'));
+    } else {
+      D2Music.start(url, !!repeat, 'song ' + songnum);
+    }
+    return 1;
+  },
+
+  d2web_music_level__deps: ['$D2Music'],
+  d2web_music_level: (levelsong, offset) => {
+    if (!D2Music.set().levels.length) return 0;
+    D2Music.playLevel(offset && D2Music.level >= 0 ? D2Music.level + offset : levelsong);
+    return 1;
+  },
+
+  d2web_music_stop__deps: ['$D2Music'],
+  d2web_music_stop: () => {
+    if (D2Music.audio) D2Music.audio.pause();
+    D2Music.state = 0;
+    D2Music.label = '';
+    D2Music.next = null;
+  },
+
+  d2web_music_pause__deps: ['$D2Music'],
+  d2web_music_pause: () => {
+    if (D2Music.state === 1 && D2Music.audio) {
+      D2Music.audio.pause();
+      D2Music.state = 2;
+    }
+  },
+
+  d2web_music_resume__deps: ['$D2Music'],
+  d2web_music_resume: () => {
+    if (D2Music.state === 2 && D2Music.audio) {
+      D2Music.audio.play().catch(() => {});
+      D2Music.state = 1;
+    }
+  },
+
+  d2web_music_pause_resume__deps: ['$D2Music', 'd2web_music_pause', 'd2web_music_resume'],
+  d2web_music_pause_resume: () => {
+    if (D2Music.state === 1) _d2web_music_pause(); else _d2web_music_resume();
+  },
+
+  d2web_music_volume__deps: ['$D2Music'],
+  d2web_music_volume: (v) => {
+    D2Music.volume = Math.max(0, Math.min(8, v)) / 8;
+    if (D2Music.audio) D2Music.audio.volume = D2Music.volume;
+  },
+
+  // Chrome reports four gamepad slots, empty ones as null, and the stock SDL count includes
+  // them; count up to the last connected pad so device indices still line up.
+  SDL_NumJoysticks: () => {
+    const pads = navigator.getGamepads ? navigator.getGamepads() : [];
+    let n = 0;
+    for (let i = 0; i < pads.length; i++) if (pads[i]) n = i + 1;
+    return n;
+  },
+
+  // Browsers reveal a gamepad on its first button press; the engine rescans when this flips.
+  $D2Pads: { changed: false, hooked: false },
+  d2web_gamepads_changed__deps: ['$D2Pads'],
+  d2web_gamepads_changed: () => {
+    if (!D2Pads.hooked) {
+      D2Pads.hooked = true;
+      const mark = () => { D2Pads.changed = true; };
+      window.addEventListener('gamepadconnected', mark);
+      window.addEventListener('gamepaddisconnected', mark);
+    }
+    const changed = D2Pads.changed;
+    D2Pads.changed = false;
+    return changed ? 1 : 0;
+  },
+
+  // Touch controls: the page keeps their state in Module.d2touch (d2loader.js). The game
+  // reads controls several times a frame; each read in a frame gets the same stick and look
+  // values, and the first one the taps.
+  $D2Touch: { frame: 0, readFrame: -1, look: [0, 0] },
+  d2web_touch_read__deps: ['$D2Touch'],
+  d2web_touch_read: (out) => {
+    const t = Module.d2touch;
+    if (!t || !t.enabled) return 0;
+    t.lastRead = performance.now();
+    let taps = 0;
+    if (D2Touch.readFrame !== D2Touch.frame) {
+      D2Touch.readFrame = D2Touch.frame;
+      D2Touch.look = t.takeLook();
+      taps = t.takeTaps();
+    }
+    const o = out >> 2;
+    HEAPF32[o] = t.stickX;
+    HEAPF32[o + 1] = t.stickY;
+    HEAPF32[o + 2] = D2Touch.look[0];
+    HEAPF32[o + 3] = D2Touch.look[1];
+    HEAPF32[o + 4] = t.held;
+    HEAPF32[o + 5] = taps;
+    return 1;
+  },
+
+  d2web_option: (which) => {
+    const o = Module.d2options || {};
+    return o[['sharp', 'effects', 'glow', 'lighting', 'ao', 'haze', 'surfaces', 'explosions', 'reflections', 'ultra', 'invertPitch'][which]] === false ? 0 : 1;
+  },
+
+  // development: Module.d2tune[i] overrides a look constant while the game runs
+  d2web_tune: (i, def) => {
+    const t = Module.d2tune;
+    return t && typeof t[i] === 'number' ? t[i] : def;
+  },
+
+  d2web_gl_version: () => (GL.currentContext ? GL.currentContext.version : 0),
+
+  d2web_shader_source__deps: ['$UTF8ToString'],
+  d2web_shader_source: (shader, src) => {
+    GLctx.shaderSource(GL.shaders[shader], UTF8ToString(src));
+  },
+
+  d2web_frame_wait__deps: ['$D2Touch'],
+  d2web_frame_wait__async: true,
+  d2web_frame_wait: () => Asyncify.handleSleep((wakeUp) => {
+    D2Touch.frame++;
+    if (Module.onFrame) Module.onFrame();
+    requestAnimationFrame(() => wakeUp());
+  }),
+
+  // Relative mouse motion for pointer-locked flight controls.
+  $D2Mouse: {
+    dx: 0,
+    dy: 0,
+    hooked: false,
+    hook() {
+      if (D2Mouse.hooked) return;
+      D2Mouse.hooked = true;
+      document.addEventListener('mousemove', (e) => {
+        if (document.pointerLockElement !== Module.canvas) return;
+        D2Mouse.dx += e.movementX || 0;
+        D2Mouse.dy += e.movementY || 0;
+      });
+    },
+  },
+  SDL_GetRelativeMouseState__deps: ['$D2Mouse'],
+  SDL_GetRelativeMouseState: (px, py) => {
+    D2Mouse.hook();
+    if (px) HEAP32[px >> 2] = Math.round(D2Mouse.dx);
+    if (py) HEAP32[py >> 2] = Math.round(D2Mouse.dy);
+    D2Mouse.dx = 0;
+    D2Mouse.dy = 0;
+    return 0;
+  },
+
+  d2web_quit: () => {
+    FS.syncfs(false, (err) => {
+      if (err) console.warn('Saving to browser storage failed', err);
+      if (Module.onQuit) Module.onQuit();
+    });
+  },
+
+  $D2Saves: { timer: 0, busy: false, again: false },
+  d2web_sync_saves__deps: ['$D2Saves'],
+  d2web_sync_saves: () => {
+    if (D2Saves.timer) clearTimeout(D2Saves.timer);
+    D2Saves.timer = setTimeout(function run() {
+      D2Saves.timer = 0;
+      if (D2Saves.busy) { D2Saves.again = true; return; }
+      D2Saves.busy = true;
+      FS.syncfs(false, (err) => {
+        D2Saves.busy = false;
+        if (err) console.warn('Saving to browser storage failed', err);
+        if (D2Saves.again) { D2Saves.again = false; run(); }
+      });
+    }, 750);
+  },
+});
diff --git a/d2/arch/web/rbaudio_web.c b/d2/arch/web/rbaudio_web.c
new file mode 100644
index 0000000..bc5fa7e
--- /dev/null
+++ b/d2/arch/web/rbaudio_web.c
@@ -0,0 +1,157 @@
+/*
+ * Redbook (CD audio) for the browser build.
+ * Tracks come from the player's own Descent II disc image, ripped by the page.
+ */
+
+#include "pstypes.h"
+#include "rbaudio.h"
+#include "console.h"
+#include "timer.h"
+#include "web.h"
+
+static int initialised = 0;
+void (*redbook_finished_hook)() = NULL;
+
+void RBAExit()
+{
+	d2web_cd_stop();
+}
+
+void RBAInit()
+{
+	if (initialised)
+		return;
+	if (d2web_cd_numtracks() < 2)
+	{
+		con_printf(CON_NORMAL, "RBAudio: no CD audio tracks loaded\n");
+		return;
+	}
+	initialised = 1;
+	RBAList();
+}
+
+int RBAEnabled()
+{
+	return initialised;
+}
+
+int RBAPlayTrack(int a)
+{
+	if (!initialised)
+		return -1;
+	if (d2web_cd_play(a, a))
+	{
+		con_printf(CON_VERBOSE, "RBAudio: Playing track %i\n", a);
+		return a;
+	}
+	return -1;
+}
+
+void RBAStop()
+{
+	if (!initialised)
+		return;
+	d2web_cd_stop();
+	redbook_finished_hook = NULL;
+}
+
+void RBAEjectDisk()
+{
+	RBAStop();
+}
+
+void RBASetVolume(int volume)
+{
+	d2web_cd_volume(volume);
+}
+
+void RBAPause()
+{
+	if (initialised)
+		d2web_cd_pause();
+}
+
+int RBAResume()
+{
+	if (!initialised)
+		return -1;
+	d2web_cd_resume();
+	return 1;
+}
+
+int RBAPauseResume()
+{
+	if (!initialised)
+		return 0;
+	switch (d2web_cd_status())
+	{
+		case 1: d2web_cd_pause(); return 1;
+		case 2: d2web_cd_resume(); return 1;
+	}
+	return 0;
+}
+
+int RBAGetNumberOfTracks()
+{
+	if (!initialised)
+		return -1;
+	return d2web_cd_numtracks();
+}
+
+// the browser reports the end of the requested track range; check from the event loops
+void RBACheckFinishedHook()
+{
+	static fix64 last_check_time = 0;
+
+	if (!initialised)
+		return;
+	if ((timer_query() - last_check_time) >= F1_0)
+	{
+		if (d2web_cd_status() == 0 && redbook_finished_hook)
+		{
+			con_printf(CON_VERBOSE, "RBAudio: Playback done, calling finished-hook\n");
+			redbook_finished_hook();
+		}
+		last_check_time = timer_query();
+	}
+}
+
+// plays tracks first through last, inclusive
+int RBAPlayTracks(int first, int last, void (*hook_finished)(void))
+{
+	if (!initialised)
+		return 0;
+	redbook_finished_hook = hook_finished;
+	con_printf(CON_VERBOSE, "RBAudio: Playing tracks %i to %i\n", first, last);
+	return d2web_cd_play(first, last);
+}
+
+int RBAGetTrackNum()
+{
+	if (!initialised || d2web_cd_status() != 1)
+		return 0;
+	return d2web_cd_track();
+}
+
+int RBAPeekPlayStatus()
+{
+	if (!initialised)
+		return 0;
+	switch (d2web_cd_status())
+	{
+		case 1: return 1;
+		case 2: return -1;	// hack so it doesn't keep restarting paused music
+	}
+	return 0;
+}
+
+// songs.c uses GameCfg.OrigTrackOrder to accept the disc, so no CDDB id is needed
+unsigned long RBAGetDiscID()
+{
+	return 0;
+}
+
+void RBAList(void)
+{
+	con_printf(CON_VERBOSE, "RBAudio: %d CD tracks available\n", d2web_cd_numtracks());
+}
diff --git a/d2/arch/web/web.c b/d2/arch/web/web.c
new file mode 100644
index 0000000..83cbef0
--- /dev/null
+++ b/d2/arch/web/web.c
@@ -0,0 +1,449 @@
+/*
+ * Browser (Emscripten) replacements for desktop-only pieces:
+ * message boxes, GLU mipmapping and GL 1.1 calls WebGL lacks.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <emscripten.h>
+#include <SDL.h>
+#include "ogl_init.h"
+#include "messagebox.h"
+#include "hmp.h"
+#include "u_mem.h"
+#include "web.h"
+
+EM_JS(void, d2web_show_message, (const char *msg, int is_error), {
+	const text = UTF8ToString(msg);
+	if (is_error) console.error(text); else console.warn(text);
+	if (Module.onGameMessage) Module.onGameMessage(text, !!is_error);
+});
+
+EM_JS(void, d2web_cutscene_changed, (int on), {
+	if (Module.onCutscene) Module.onCutscene(!!on);
+});
+
+static int cutscene_depth, cutscene_skip;
+
+void d2web_cutscene(int begin)
+{
+	if (begin) {
+		if (cutscene_depth++ == 0)
+			d2web_cutscene_changed(1);
+	} else if (cutscene_depth > 0 && --cutscene_depth == 0) {
+		cutscene_skip = 0;
+		d2web_cutscene_changed(0);
+	}
+}
+
+// the page's Skip button: event_process sends Escape to the screen in front until the whole sequence is over
+EMSCRIPTEN_KEEPALIVE void d2web_skip_cutscene(void)
+{
+	if (cutscene_depth > 0)
+		cutscene_skip = 1;
+}
+
+int d2web_cutscene_skipping(void)
+{
+	return cutscene_skip && cutscene_depth > 0;
+}
+
