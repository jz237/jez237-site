+// Robot parts must line up with the game model's: same count and the same parent for each.
+static int parts_match(render_model& rm, polymodel *po) {
+	if (!rm.nsubs || rm.nsubs != po->n_models)
+		return 0;
+	for (int i = 0; i < rm.nsubs; i++)
+		if (i ? rm.parents[i] != po->submodel_parents[i] || rm.parents[i] >= i : rm.parents[i] != -1)
+			return 0;
+	return 1;
+}
+
+// Where each part is drawn: xf[i] maps the model's rest-pose coordinates of part i to the
+// pose the game model has now (column-major 4x4). Follows the interpreter's submodel calls:
+// a part rotates by its animation angles about its pivot, offset from its parent.
+// root < 0 draws the whole model; else just that part and what hangs off it, centered on
+// the part (debris).
+static void part_transforms(render_model& rm, polymodel *po, vms_angvec *anim_angles, int root,
+	float xf[][16], int *draw, float rot[][9]) {
+	float pivot[MAX_SUBMODELS][3], lin[MAX_SUBMODELS][9], ofs[MAX_SUBMODELS][3];
+	for (int i = 0; i < rm.nsubs; i++) {
+		int p = i ? rm.parents[i] : -1;
+		float o[3] = { f2fl(po->submodel_offsets[i].x), f2fl(po->submodel_offsets[i].y), f2fl(po->submodel_offsets[i].z) };
+		if (p < 0)
+			for (int k = 0; k < 3; k++)
+				pivot[i][k] = 0;
+		else
+			for (int k = 0; k < 3; k++)
+				pivot[i][k] = pivot[p][k] + o[k];
+		draw[i] = root < 0 || i == root || (p >= 0 && draw[p]);
+		if (!draw[i])
+			continue;
+		if (i == root || p < 0) {
+			// the root keeps the model's axes; a debris piece is centered on its own middle
+			for (int k = 0; k < 9; k++)
+				lin[i][k] = k % 4 ? 0 : 1;
+			for (int k = 0; k < 3; k++)
+				ofs[i][k] = i == root ? -0.5f * (f2fl((&po->submodel_mins[i].x)[k]) + f2fl((&po->submodel_maxs[i].x)[k])) : 0;
+		} else {
+			// child -> parent is R^T p + offset, R from the part's animation angles
+			vms_matrix r;
+			vms_angvec zero = { 0, 0, 0 };
+			vm_angles_2_matrix(&r, anim_angles ? &anim_angles[i] : &zero);
+			float rt[9] = {	// columns: rvec, uvec, fvec
+				f2fl(r.rvec.x), f2fl(r.rvec.y), f2fl(r.rvec.z),
+				f2fl(r.uvec.x), f2fl(r.uvec.y), f2fl(r.uvec.z),
+				f2fl(r.fvec.x), f2fl(r.fvec.y), f2fl(r.fvec.z) };
+			for (int c = 0; c < 3; c++)
+				for (int k = 0; k < 3; k++)
+					lin[i][c * 3 + k] = lin[p][k] * rt[c * 3] + lin[p][3 + k] * rt[c * 3 + 1] + lin[p][6 + k] * rt[c * 3 + 2];
+			for (int k = 0; k < 3; k++)
+				ofs[i][k] = lin[p][k] * o[0] + lin[p][3 + k] * o[1] + lin[p][6 + k] * o[2] + ofs[p][k];
+		}
+	}
+	for (int i = 0; i < rm.nsubs; i++) {
+		if (!draw[i])
+			continue;
+		float *m = xf[i];
+		for (int c = 0; c < 3; c++) {
+			for (int k = 0; k < 3; k++)
+				m[c * 4 + k] = lin[i][c * 3 + k];
+			m[c * 4 + 3] = 0;
+		}
+		// rest-pose vertex v is at v - pivot in the part's own coordinates
+		for (int k = 0; k < 3; k++)
+			m[12 + k] = ofs[i][k] - (lin[i][k] * pivot[i][0] + lin[i][3 + k] * pivot[i][1] + lin[i][6 + k] * pivot[i][2]);
+		m[15] = 1;
+		memcpy(rot[i], lin[i], sizeof(rot[i]));
+	}
+}
