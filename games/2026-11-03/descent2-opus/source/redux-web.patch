+GLint gluBuild2DMipmaps(GLenum target, GLint internalFormat, GLsizei width, GLsizei height,
+	GLenum format, GLenum type, const void *data)
+{
+	// WebGL wants the internal format to match the upload format
+	glTexImage2D(target, 0, format, width, height, 0, format, type, data);
+	if (is_pow2(width) && is_pow2(height))
+		glGenerateMipmap(target);
+	return 0;
+}
