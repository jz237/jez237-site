diff --git a/d2/main/plight.c b/d2/main/plight.c
new file mode 100644
index 0000000..5d48a6e
--- /dev/null
+++ b/d2/main/plight.c
@@ -0,0 +1,735 @@
+/*
+ * Per-pixel lighting of the mine's walls (browser edition, WebGL 2). Walls are drawn with a
+ * shader that lights each pixel from the nearest moving lights (shots, flares, explosions,
+ * the ship's glow and its headlight cone) instead of only blending between corners, gives
+ * the textures relief and highlights from the room's lamps, and makes the lamps' bright parts
+ * glow. The game's own corner lighting stays the base, so rooms keep their look, and only
+ * where a room is lit do surfaces shine (no highlights through walls).
+ */
+
+#define GL_GLEXT_PROTOTYPES
+#include <GL/gl.h>
+#include <GL/glext.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "plight.h"
+#include "inferno.h"
+#include "segment.h"
+#include "gameseg.h"
+#include "gameseq.h"
+#include "game.h"
+#include "object.h"
+#include "player.h"
+#include "lighting.h"
+#include "bm.h"
+#include "textures.h"
+#include "piggy.h"
+#include "palette.h"
+#include "timer.h"
+#include "../3d/globvars.h"
+#include "ogl_init.h"
+#ifdef __EMSCRIPTEN__
+#include "../arch/web/web.h"
+#endif
+
+#define LAMPS_PER_SEG 4
+#define LAMP_REACH 100.0f			// units from a segment's center to lamps that light it
+#define HEADLIGHT_EMISSION 10.0f	// lighting.c HEADLIGHT_SCALE
+
+static const char *world_vs =
+	"in vec4 a_position;\n"
+	"in vec4 a_texCoord0;\n"
+	"in vec4 a_color;\n"
+	"uniform mat4 u_modelView;\n"
+	"uniform mat4 u_projection;\n"
+	"out vec2 v_uv;\n"
+	"out vec4 v_color;\n"
+	"out vec3 v_pos;\n"
+	"void main() {\n"
+	"	vec4 p = u_modelView * a_position;\n"
+	"	v_uv = a_texCoord0.xy;\n"
+	"	v_color = a_color;\n"
+	"	v_pos = p.xyz;\n"
+	"	gl_Position = u_projection * p;\n"
+	"}\n";
+
+// Positions are in view space with the view's zoom and aspect undone (unscale), so lengths
+// are in mine units. Lights: xyz position, w reach; colors in the game's light units (a light
+// gives emission / distance, like lighting.c). The vertex color is the game's own light.
+static const char *world_fs =
+	"#define MAX_LIGHTS 16\n"
+	"#define MAX_LAMPS 4\n"
+	"uniform sampler2D tex;\n"
+	"uniform vec3 unscale;\n"
+	"uniform vec4 mat;\n"
+	"uniform float pools;\n"		// 1: the lamp pools shade it (0 for moving surfaces alone)			// emissive, bump, gloss, kind
+	"uniform vec2 texsize;\n"
+	"uniform int nlights;\n"
+	"uniform vec4 lpos[MAX_LIGHTS];\n"
+	"uniform vec3 lcol[MAX_LIGHTS];\n"
+	"uniform vec4 headpos;\n"		// xyz, w emission (0: off)
+	"uniform vec3 headdir;\n"
+	"uniform int nlamps;\n"
+	"uniform vec4 lamppos[MAX_LAMPS];\n"	// xyz, w strength
+	"uniform vec3 lampcol[MAX_LAMPS];\n"
+	"uniform vec4 tune[3];\n"	// relief, bump depth, headlight, moving-light shine; lamp shine, glow, light cap,
+					// moving-light gain; lamp pools: strength, dark away from lamps, bright near, reach
+	"in vec2 v_uv;\n"
+	"in vec4 v_color;\n"
+	"in vec3 v_pos;\n"
+	"out vec4 o;\n"
+	"uniform float time;\n"		// seconds
+	"uniform sampler2D hcolor;\n"	// last frame, for reflections
+	"uniform sampler2D hdepth;\n"
+	"uniform mat4 reproj;\n"		// this view's space to last frame's
+	"uniform vec3 hscale;\n"
+	"uniform vec2 refl;\n"			// strength, on
+	"uniform sampler2D nmap, gmap, emap;\n"	// material maps: normal, gloss (g) and metal (r), glow
+	"uniform vec3 maps;\n"			// which of them this texture has
+	"float hdist(vec2 uv) {\n"		// last frame's distance along its view axis, in units
+	"	float z = texture(hdepth, uv).r * 2.0 - 1.0;\n"
+	"	return 2.0 * 0.1 * 5000.0 / (5000.1 - z * 4999.9) / hscale.z;\n"
+	"}\n"
+	"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }\n"
+	"float hash2(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\n"
+	"float vnoise(vec2 p) {\n"
+	"	vec2 i = floor(p), f = fract(p);\n"
+	"	f = f * f * (3.0 - 2.0 * f);\n"
+	"	return mix(mix(hash2(i), hash2(i + vec2(1.0, 0.0)), f.x), mix(hash2(i + vec2(0.0, 1.0)), hash2(i + vec2(1.0)), f.x), f.y);\n"
+	"}\n"
+	// water: the slope of three crossing ripple trains, in texture units
+	"vec2 ripples(vec2 uv) {\n"
+	"	const float TAU = 6.2832;\n"
+	"	vec2 d1 = vec2(1.0, 0.3), d2 = vec2(-0.4, 1.0), d3 = vec2(0.7, -0.8);\n"
+	"	return d1 * cos(dot(uv, d1) * TAU * 3.0 + time * 1.7) * 3.0 * 0.5\n"
+	"		+ d2 * cos(dot(uv, d2) * TAU * 4.0 - time * 2.1) * 4.0 * 0.35\n"
+	"		+ d3 * cos(dot(uv, d3) * TAU * 7.0 + time * 2.9) * 7.0 * 0.15;\n"
+	"}\n"
+	"void main() {\n"
+	"	int kind = int(mat.w + 0.5);\n"	// 1 lava, 2 water, 3 force field
+	"	vec2 uv = v_uv;\n"
+	"	vec2 rip = vec2(0.0);\n"
+	"	if (kind == 1)\n"				// lava churns as it flows
+	"		uv += vec2(sin(v_uv.y * 9.4 + time * 0.7) + 0.5 * sin((v_uv.x + v_uv.y) * 12.6 - time * 1.1),\n"
+	"			cos(v_uv.x * 8.2 - time * 0.6) + 0.5 * cos((v_uv.x - v_uv.y) * 15.1 + time * 0.9)) * 0.011;\n"
+	"	else if (kind == 2) {\n"		// water bends what is under it
+	"		rip = ripples(v_uv);\n"
+	"		uv += rip * 0.004;\n"
+	"	} else if (kind == 3)\n"
+	"		uv.x += sin(v_uv.y * 18.8 + time * 4.0) * 0.004;\n"
+	"	vec4 c = texture(tex, uv);\n"
+	"	if (c.a < 0.02) discard;\n"
+	"	vec3 P = v_pos * unscale;\n"
+	"	vec3 dpx = dFdx(P), dpy = dFdy(P);\n"
+	"	vec3 N = normalize(cross(dpx, dpy));\n"
+	"	vec3 V = normalize(-P);\n"
+	"	if (dot(N, V) < 0.0) N = -N;\n"
+	// relief: height from the texture's brightness, through the surface's own uv frame; it
+	// fades out where texels get smaller than pixels, so distant walls don't shimmer
+	"	vec2 dux = dFdx(v_uv), duy = dFdy(v_uv);\n"
+	"	vec3 sx = cross(dpy, N), sy = cross(N, dpx);\n"
+	"	vec3 T = sx * dux.x + sy * duy.x, B = sx * dux.y + sy * duy.y;\n"
+	"	float ts = inversesqrt(max(max(dot(T, T), dot(B, B)), 1e-12));\n"
+	"	float foot = max(length(dux * texsize), length(duy * texsize));\n"
+	"	float bump = mat.y * (1.0 - smoothstep(0.7, 2.5, foot));\n"
+	"	vec3 Nb = N;\n"
+	"	if (maps.x > 0.5) {\n"		// a normal map: the surface's real shape (fading only far off; its mips smooth it)
+	"		vec3 n = texture(nmap, uv).xyz * 2.0 - 1.0;\n"
+	"		vec3 Nm = normalize(N * max(n.z, 0.05) + normalize(T) * n.x + normalize(B) * n.y);\n"
+	"		Nb = normalize(mix(N, Nm, (1.0 - smoothstep(2.0, 8.0, foot)) * tune[0].y / 5.0));\n"
+	"	} else if (bump > 0.001) {\n"
+	"		vec2 tx = vec2(1.0 / texsize.x, 0.0), ty = vec2(0.0, 1.0 / texsize.y);\n"
+	"		vec2 g = vec2(lum(texture(tex, uv + tx).rgb) - lum(texture(tex, uv - tx).rgb),\n"
+	"			lum(texture(tex, uv + ty).rgb) - lum(texture(tex, uv - ty).rgb)) * 0.5;\n"
+	"		Nb = normalize(N - (T * g.x + B * g.y) * ts * bump * tune[0].y);\n"
+	"	}\n"
+	"	if (kind == 2)\n"
+	"		Nb = normalize(Nb - (T * rip.x + B * rip.y) * ts * 0.05);\n"
+	"	float gloss = kind == 2 ? 0.85 : mat.z, metal = 0.0;\n"
+	"	if (maps.y > 0.5 && kind != 2) {\n"
+	"		vec2 gm = texture(gmap, uv).gr;\n"
+	"		gloss = gm.x;\n"
+	"		metal = gm.y;\n"
+	"	}\n"
+	"	float shin = mix(10.0, 48.0, gloss);\n"
+	"	vec3 base = v_color.rgb;\n"
+	"	float lit = min(lum(base) * 2.0, 1.0);\n"
+	// the room's lamps: the direction the bumps catch light from, and highlights
+	"	vec3 ld = vec3(0.0), spec = vec3(0.0), pool = vec3(0.0);\n"
+	"	float lw = 0.0;\n"
+	"	for (int i = 0; i < MAX_LAMPS; i++) {\n"
+	"		if (i >= nlamps) break;\n"
+	"		vec3 L = lamppos[i].xyz - P;\n"
+	"		float d2 = dot(L, L);\n"
+	"		L *= inversesqrt(d2);\n"
+	"		float f = max(dot(N, L), 0.0) * lamppos[i].w / (1.0 + d2 / 900.0);\n"
+	"		ld += L * f;\n"
+	"		lw += f;\n"
+	"		spec += lampcol[i] * f * pow(max(dot(Nb, normalize(L + V)), 0.0), shin);\n"
+	"		pool += lampcol[i] * max(dot(Nb, L), 0.0) * lamppos[i].w / (1.0 + d2 / (tune[2].w * tune[2].w));\n"
+	"	}\n"
+	// pools of the lamps' own colored light; away from them the room falls darker
+	"	float pa = lum(pool), amt = pa / (pa + 0.4);\n"
+	"	vec3 tint = pa > 1e-4 ? pool / pa : vec3(1.0);\n"
+	"	vec3 shade = mix(vec3(1.0), mix(vec3(tune[2].y), tint * tune[2].z, amt), tune[2].x * pools);\n"
+	// a pool lifts dim walls fully but walls the game already lights fully only a little
+	"	shade = 1.0 + (shade - 1.0) * mix(vec3(1.0), vec3(clamp(1.2 - lum(base), 0.15, 1.0)), step(1.0, shade));\n"
+	"	vec3 Ld = lw > 1e-4 ? normalize(ld) : V;\n"
+	"	float relief = clamp(1.0 + (dot(Nb, Ld) - dot(N, Ld)) * tune[0].x, 0.35, 1.7);\n"
+	"	spec *= gloss * lit * tune[1].x;\n"
+	// moving lights, per pixel
+	"	vec3 dyn = vec3(0.0);\n"
+	"	for (int i = 0; i < MAX_LIGHTS; i++) {\n"
+	"		if (i >= nlights) break;\n"
+	"		vec3 L = lpos[i].xyz - P;\n"
+	"		float d = length(L);\n"
+	"		L /= max(d, 1e-3);\n"
+	"		vec3 e = lcol[i] * (tune[1].w * smoothstep(lpos[i].w, lpos[i].w * 0.7, d) / max(d, 4.0));\n"
+	"		dyn += e * (0.25 + 0.75 * max(dot(Nb, L), 0.0));\n"
+	"		spec += e * pow(max(dot(Nb, normalize(L + V)), 0.0), shin) * gloss * tune[0].w;\n"
+	"	}\n"
+	"	if (headpos.w > 0.0) {\n"
+	"		vec3 L = headpos.xyz - P;\n"
+	"		float d = length(L);\n"
+	"		L /= max(d, 1e-3);\n"
+	"		float cd = dot(-L, headdir);\n"
+	"		float cone = smoothstep(0.5, 0.85, cd) * pow(cd, 4.0) * headpos.w * tune[0].z / (1.0 + d * d / 40000.0);\n"
+	"		float h = max(cone, headpos.w / 10.0 / max(d, 4.0));\n"
+	"		dyn += vec3(h) * (0.25 + 0.75 * max(dot(Nb, L), 0.0));\n"
+	"		spec += vec3(h) * pow(max(dot(Nb, normalize(L + V)), 0.0), shin) * gloss * 0.5;\n"
+	"	}\n"
+	"	vec3 light = min(base * relief * shade + dyn, vec3(tune[1].z));\n"
+	"	vec3 rgb = c.rgb * light * (1.0 - metal * 0.4) + spec * mix(vec3(1.0), c.rgb * 1.6, mix(0.5, 1.0, metal));\n"	// metal tints its shine
+	// a lamp's bright parts give light: they glow (or what its glow map says)
+	"	float m = max(max(c.r, c.g), c.b);\n"
+	"	if (maps.z > 0.5)\n"
+	"		rgb += texture(emap, uv).rgb * tune[1].y * 1.5;\n"
+	"	else\n"
+	"		rgb += c.rgb * smoothstep(0.55, 0.95, m) * mat.x * tune[1].y;\n"
+	// reflections: march the reflected ray through last frame's view until it passes behind
+	// what was seen there; shiny surfaces take that color, more at grazing angles
+	"	if (refl.y > 0.5 && gloss > 0.4) {\n"	// smooth metal and water, not rock
+	"		vec3 R = reflect(-V, normalize(mix(N, Nb, 0.35)));\n"	// the relief only ruffles it
+	"		float fres = 0.04 + 0.96 * pow(1.0 - max(dot(Nb, V), 0.0), 5.0);\n"
+	"		float amt = refl.x * gloss * gloss * mix(0.25, 1.0, fres) * min(lum(base) * 3.0, 1.0);\n"
+	"		if (refl.x > 50.0) rgb = vec3(0.15, 0.0, 0.15);\n"
+	"		vec3 X = P + N * 0.05;\n"
+	"		float st = 0.8;\n"
+	"		for (int i = 0; i < 14; i++) {\n"
+	"			if (amt < 0.01) break;\n"
+	"			X += R * st;\n"
+	"			st *= 1.32;\n"
+	"			vec3 xp = (reproj * vec4(X, 1.0)).xyz;\n"
+	"			if (xp.z > -0.2) break;\n"
+	"			vec3 e = xp * hscale;\n"
+	"			vec2 u = e.xy / -e.z * 0.5 + 0.5;\n"
+	"			if (any(lessThan(u, vec2(0.0))) || any(greaterThan(u, vec2(1.0)))) break;\n"
+	"			float sd = hdist(u), rd = -xp.z;\n"
+	"			if (rd > sd + 0.02) {\n"
+	"				if (rd < sd + st * 1.5 + 0.5) {\n"
+	"					vec2 f = smoothstep(0.0, 0.08, u) * smoothstep(1.0, 0.92, u);\n"
+	"					vec3 hit = texture(hcolor, u).rgb * f.x * f.y * (1.0 - float(i) / 14.0);\n"
+	"					rgb = refl.x > 50.0 ? hit + vec3(0.0, 0.2, 0.0) : rgb * (1.0 - amt * 0.3) + hit * amt;\n"	// > 50: test view
+	"				}\n"
+	"				break;\n"
+	"			}\n"
+	"		}\n"
+	"	}\n"
+	"	if (kind == 1)\n"				// lava glows, brightest where it is hottest, in slow waves
+	"		rgb += c.rgb * smoothstep(0.2, 0.7, m) * (0.5 + 0.7 * vnoise(uv * 5.0 + vec2(time * 0.2, -time * 0.13))) * 0.9;\n"
+	"	else if (kind == 2)\n"			// water: brighter at grazing angles, like a reflection
+	"		rgb += base * c.rgb * pow(1.0 - max(dot(Nb, V), 0.0), 4.0) * 0.6;\n"
+	"	else if (kind == 3)\n"			// force fields shimmer with running bands of energy
+	"		rgb += c.rgb * (0.5 + 0.5 * sin(v_uv.y * 37.7 - time * 5.0)) * (0.4 + 0.6 * vnoise(v_uv * 9.0 + time * 1.5)) * 1.1;\n"
+	"	o = vec4(rgb, c.a * v_color.a);\n"
+	"}\n";
+
+static struct {
+	int tried;
+	GLuint prog;
+	GLint pools, time, refl, reproj, hscale, tune, unscale, mat, texsize, nlights, lpos, lcol, headpos, headdir, nlamps, lamppos, lampcol, maps;
+} W;
+
+typedef struct lamp {
+	float pos[3];				// world, mine units
+	float col[3];
+	float strength;
+	short seg;
+	sbyte side;
+} lamp;
+
+static lamp Lamps[MAX_SEGMENTS * MAX_SIDES_PER_SEGMENT];
+static short Seg_lamps[MAX_SEGMENTS][LAMPS_PER_SEG];
+static ubyte Seg_nlamps[MAX_SEGMENTS];
+static int Built_level = -1000, Built_segs = -1;
+
+typedef struct texmat {
+	float gloss, bump;
+	char done;
+} texmat;
+
+static texmat Mats[MAX_TEXTURES];
+
+static struct {
+	int on, lit, seg, side, tmap1, tmap2;		// lit: per-pixel lighting (else only a moving surface)
+} Face;
+static int Frame_dirty, Lamps_seg = -1;
+
+static int ready(void)
+{
+	if (!W.tried) {
+		GLuint p;
+		W.tried = 1;
+#ifdef __EMSCRIPTEN__
+		if (d2web_gl_version() < 2)
+			return 0;
+#endif
+		if (!(p = W.prog = ogl_program3(world_vs, "", world_fs)))
+			return 0;
+		glUseProgram(p);
+		glUniform1i(glGetUniformLocation(p, "tex"), 0);
+		W.tune = glGetUniformLocation(p, "tune");
+		W.time = glGetUniformLocation(p, "time");
+		W.pools = glGetUniformLocation(p, "pools");
+		W.refl = glGetUniformLocation(p, "refl");
+		W.reproj = glGetUniformLocation(p, "reproj");
+		W.hscale = glGetUniformLocation(p, "hscale");
+		glUniform1i(glGetUniformLocation(p, "hcolor"), 1);
+		glUniform1i(glGetUniformLocation(p, "hdepth"), 2);
+		glUniform1i(glGetUniformLocation(p, "nmap"), 3);
+		glUniform1i(glGetUniformLocation(p, "gmap"), 4);
+		glUniform1i(glGetUniformLocation(p, "emap"), 5);
+		W.maps = glGetUniformLocation(p, "maps");
+		W.unscale = glGetUniformLocation(p, "unscale");
+		W.mat = glGetUniformLocation(p, "mat");
+		W.texsize = glGetUniformLocation(p, "texsize");
+		W.nlights = glGetUniformLocation(p, "nlights");
+		W.lpos = glGetUniformLocation(p, "lpos");
+		W.lcol = glGetUniformLocation(p, "lcol");
+		W.headpos = glGetUniformLocation(p, "headpos");
+		W.headdir = glGetUniformLocation(p, "headdir");
+		W.nlamps = glGetUniformLocation(p, "nlamps");
+		W.lamppos = glGetUniformLocation(p, "lamppos");
+		W.lampcol = glGetUniformLocation(p, "lampcol");
+		glUseProgram(0);
+	}
+	return W.prog != 0;
+}
+
+int plight_enabled(void)
+{
+#ifdef __EMSCRIPTEN__
+	return d2web_option(D2WEB_OPTION_LIGHTING) && ready();
+#else
+	return 0;
+#endif
+}
+
+// How shiny and how bumpy a texture looks, from its pixels: grey, smooth metal shines; colorful
+// or noisy rock barely does and has deeper relief.
+static texmat *material(int tmap)
+{
+	texmat *m = &Mats[tmap];
+	if (!m->done) {
+		grs_bitmap *bm = &GameBitmaps[Textures[tmap].index];
+		unsigned char *px;
+		float *l, sat = 0, noise = 0, rough;
+		int w, h, x, y, n = 0;
+
+		m->done = 1;
+		m->gloss = 0.3f;
+		m->bump = 0.8f;
+		PIGGY_PAGE_IN(Textures[tmap]);
+		w = bm->bm_w;
+		h = bm->bm_h;
+		if (w < 4 || h < 4 || !(px = ogl_bitmap_indices(bm)) || !(l = malloc(w * h * sizeof(float))))
+			return m;
+		for (y = 0; y < h; y++)
+			for (x = 0; x < w; x++) {
+				int c = px[y * w + x];
+				float r = gr_palette[c * 3] / 63.0f, g = gr_palette[c * 3 + 1] / 63.0f, b = gr_palette[c * 3 + 2] / 63.0f;
+				float mx = fmaxf(r, fmaxf(g, b)), mn = fminf(r, fminf(g, b));
+				l[y * w + x] = 0.299f * r + 0.587f * g + 0.114f * b;
+				if (c != 255 && mx > 0.05f) {
+					sat += (mx - mn) / mx;
+					n++;
+				}
+			}
+		for (y = 0; y < h; y++)
+			for (x = 0; x < w; x++) {
+				float avg = (l[y * w + (x + 1) % w] + l[y * w + (x + w - 1) % w] + l[((y + 1) % h) * w + x] + l[((y + h - 1) % h) * w + x]) / 4;
+				noise += fabsf(l[y * w + x] - avg);
+			}
+		free(l);
+		sat = n ? sat / n : 0;
+		noise /= w * h;
+		rough = fminf(fmaxf((noise - 0.015f) / 0.06f, 0), 1);
+		m->gloss = fminf(fmaxf(0.75f - sat * 1.6f, 0.08f), 0.7f) * (1 - rough * 0.85f);	// rock stays matte
+		m->bump = 0.55f + rough * 0.6f;
+	}
+	return m;
+}
+
+static void bitmap_color(int tmap, float *col)
+{
+	grs_bitmap *bm = &GameBitmaps[Textures[tmap].index];
+	float mx;
+	PIGGY_PAGE_IN(Textures[tmap]);
+	col[0] = bm->avg_color_rgb[0];
+	col[1] = bm->avg_color_rgb[1];
+	col[2] = bm->avg_color_rgb[2];
+	mx = fmaxf(col[0], fmaxf(col[1], col[2]));
+	if (mx <= 0) {
+		col[0] = col[1] = col[2] = 1;
+		return;
+	}
+	// a lamp's color, as bright as white (the average includes its dark frame)
+	col[0] = 0.3f + 0.7f * col[0] / mx;
+	col[1] = 0.3f + 0.7f * col[1] / mx;
+	col[2] = 0.3f + 0.7f * col[2] / mx;
+}
+
+// The lamps (sides with light-giving textures) of the level and the strongest few that reach
+// each segment through its open sides.
+static void build_lamps(void)
+{
+	static int visit[MAX_SEGMENTS], stamp;
+	static short queue[MAX_SEGMENTS];
+	static sbyte depth[MAX_SEGMENTS];
+	static int first[MAX_SEGMENTS + 1];
+	int seg, sn, n = 0;
+
+	Built_level = Current_level_num;
+	Built_segs = Highest_segment_index;
+	memset(Mats, 0, sizeof(Mats));
+	for (seg = 0; seg <= Highest_segment_index; seg++) {
+		first[seg] = n;
+		for (sn = 0; sn < MAX_SIDES_PER_SEGMENT; sn++) {
+			side *s = &Segments[seg].sides[sn];
+			int t1 = s->tmap_num, t2 = s->tmap_num2 & 0x3fff;
+			fix light = TmapInfo[t1].lighting + (t2 ? TmapInfo[t2].lighting : 0);
+			vms_vector c, nrm;
+			lamp *l;
+			if (Segments[seg].children[sn] != -1 || light <= 0)
+				continue;
+			compute_center_point_on_side(&c, &Segments[seg], sn);
+			vm_vec_avg(&nrm, &s->normals[0], &s->normals[1]);
+			vm_vec_normalize_quick(&nrm);
+			vm_vec_scale_add2(&c, &nrm, F1_0);
+			l = &Lamps[n++];
+			l->pos[0] = f2fl(c.x);
+			l->pos[1] = f2fl(c.y);
+			l->pos[2] = f2fl(c.z);
+			bitmap_color(t2 && TmapInfo[t2].lighting > 0 ? t2 : t1, l->col);
+			l->strength = f2fl(light);
+			l->seg = seg;
+			l->side = sn;
+		}
+	}
+	first[seg] = n;
+
+	for (seg = 0; seg <= Highest_segment_index; seg++) {
+		float best[LAMPS_PER_SEG], cx, cy, cz;
+		int head = 0, tail = 0, k, cnt = 0;
+		vms_vector c;
+		compute_segment_center(&c, &Segments[seg]);
+		cx = f2fl(c.x);
+		cy = f2fl(c.y);
+		cz = f2fl(c.z);
+		stamp++;
+		queue[tail++] = seg;
+		visit[seg] = stamp;
+		depth[seg] = 0;
+		while (head < tail) {
+			int s = queue[head++], i;
+			for (i = first[s]; i < first[s + 1]; i++) {
+				float dx = Lamps[i].pos[0] - cx, dy = Lamps[i].pos[1] - cy, dz = Lamps[i].pos[2] - cz;
+				float d2 = dx * dx + dy * dy + dz * dz, score;
+				if (d2 > LAMP_REACH * LAMP_REACH)
+					continue;
+				score = Lamps[i].strength / (1 + d2 / 900);
+				// keep the best few, best first
+				if (cnt < LAMPS_PER_SEG)
+					k = cnt++;
+				else if (score > best[LAMPS_PER_SEG - 1])
+					k = LAMPS_PER_SEG - 1;
+				else
+					continue;
+				for (; k > 0 && best[k - 1] < score; k--) {
+					best[k] = best[k - 1];
+					Seg_lamps[seg][k] = Seg_lamps[seg][k - 1];
+				}
+				best[k] = score;
+				Seg_lamps[seg][k] = i;
+			}
+			if (depth[s] < 3)
+				for (i = 0; i < MAX_SIDES_PER_SEGMENT; i++) {
+					int ch = Segments[s].children[i];
+					if (ch >= 0 && visit[ch] != stamp) {
+						visit[ch] = stamp;
+						depth[ch] = depth[s] + 1;
+						queue[tail++] = ch;
+					}
+				}
+		}
+		Seg_nlamps[seg] = cnt;
+	}
+}
+
+static void to_view(const vms_vector *p, float *out)
+{
+	vms_vector t, r;
+	vm_vec_sub(&t, p, &View_position);
+	vm_vec_rotate(&r, &t, &Unscaled_matrix);
+	out[0] = f2fl(r.x);
+	out[1] = f2fl(r.y);
+	out[2] = -f2fl(r.z);
+}
+
+static void dir_to_view(const vms_vector *d, float *out)
+{
+	vms_vector r;
+	vm_vec_rotate(&r, d, &Unscaled_matrix);
+	out[0] = f2fl(r.x);
+	out[1] = f2fl(r.y);
+	out[2] = -f2fl(r.z);
+}
+
+void plight_frame(void)
+{
+	Frame_dirty = 1;
+	Lamps_seg = -1;
+	Face.on = 0;
+}
+
+static int surfaces_enabled(void)
+{
+#ifdef __EMSCRIPTEN__
+	return d2web_option(D2WEB_OPTION_SURFACES) && ready();
+#else
+	return 0;
+#endif
+}
+
+#define SURFACE_FLAGS (TMI_VOLATILE | TMI_WATER | TMI_FORCE_FIELD)
+
+int plight_side(int segnum, int sidenum, int tmap1, int tmap2)
+{
+	int lit = plight_enabled();
+	Face.on = 0;
+	if (!lit && !(surfaces_enabled() && ((TmapInfo[tmap1].flags | (tmap2 ? TmapInfo[tmap2 & 0x3fff].flags : 0)) & SURFACE_FLAGS)))
+		return 0;
+	if (Built_level != Current_level_num || Built_segs != Highest_segment_index)
+		build_lamps();
+	Face.on = 1;
+	Face.lit = lit;
+	Face.seg = segnum;
+	Face.side = sidenum;
+	Face.tmap1 = tmap1;
+	Face.tmap2 = tmap2 & 0x3fff;
+	return lit;
+}
+
+void plight_side_done(void)
+{
+	Face.on = 0;
+}
+
+static void upload_frame(void)
+{
+	float pos[PP_MAX_LIGHTS][4], col[PP_MAX_LIGHTS][3];
+	int i;
+#ifdef __EMSCRIPTEN__
+	glUniform4f(W.tune, d2web_tune(0, 2.6f), d2web_tune(1, 5.0f), d2web_tune(2, 0.1f), d2web_tune(3, 0.9f));
+	glUniform4f(W.tune + 1, d2web_tune(4, 0.45f), d2web_tune(5, 0.8f), d2web_tune(6, 1.8f), d2web_tune(24, 1.6f));
+	glUniform4f(W.tune + 2, d2web_tune(20, 1.0f), d2web_tune(21, 0.3f), d2web_tune(22, 2.3f), d2web_tune(23, 36.0f));
+#endif
+	glUniform3f(W.unscale, 1 / f2fl(Matrix_scale.x), 1 / f2fl(Matrix_scale.y), 1 / f2fl(Matrix_scale.z));
+	glUniform1f(W.time, (float)(GameTime64 % (F1_0 * 3600LL)) / F1_0);
+	glUniform2f(W.refl, 0, 0);
+	if (!plight_enabled()) {	// only moving surfaces
+		glUniform1i(W.nlights, 0);
+		glUniform4f(W.headpos, 0, 0, 0, 0);
+		return;
+	}
+	{
+		unsigned hc, hd;
+		float reproj[16], hs[3];
+		if (d2web_option(D2WEB_OPTION_REFLECTIONS) && ogl_post_history(&hc, &hd, reproj, hs)) {
+			glActiveTexture(GL_TEXTURE1);
+			glBindTexture(GL_TEXTURE_2D, hc);
+			glActiveTexture(GL_TEXTURE2);
+			glBindTexture(GL_TEXTURE_2D, hd);
+			glActiveTexture(GL_TEXTURE0);
+			glUniformMatrix4fv(W.reproj, 1, GL_FALSE, reproj);
+			glUniform3f(W.hscale, hs[0], hs[1], hs[2]);
+			glUniform2f(W.refl, d2web_tune(19, 0.7f), 1);
+		}
+	}
+	for (i = 0; i < Pp_num_lights; i++) {
+		pp_light *l = &Pp_lights[i];
+		to_view(&l->pos, pos[i]);
+		pos[i][3] = f2fl((l->emission.r + l->emission.g + l->emission.b) / 3) * 64;
+		col[i][0] = f2fl(l->emission.r);
+		col[i][1] = f2fl(l->emission.g);
+		col[i][2] = f2fl(l->emission.b);
+	}
+	glUniform1i(W.nlights, Pp_num_lights);
+	if (Pp_num_lights) {
+		glUniform4fv(W.lpos, Pp_num_lights, pos[0]);
+		glUniform3fv(W.lcol, Pp_num_lights, col[0]);
+	}
+	if (Pp_headlight) {
+		float hp[3], hd[3];
+		to_view(&Pp_headlight->pos, hp);
+		dir_to_view(&Pp_headlight->orient.fvec, hd);
+		glUniform4f(W.headpos, hp[0], hp[1], hp[2], HEADLIGHT_EMISSION);
+		glUniform3f(W.headdir, hd[0], hd[1], hd[2]);
+	} else
+		glUniform4f(W.headpos, 0, 0, 0, 0);
+}
+
+static void upload_lamps(int seg)
+{
+	float pos[LAMPS_PER_SEG][4], col[LAMPS_PER_SEG][3];
+	int i, n = 0;
+	for (i = 0; i < Seg_nlamps[seg]; i++) {
+		lamp *l = &Lamps[Seg_lamps[seg][i]];
+		vms_vector p;
+		if (Light_subtracted[l->seg] & (1 << l->side))
+			continue;
+		p.x = fl2f(l->pos[0]);
+		p.y = fl2f(l->pos[1]);
+		p.z = fl2f(l->pos[2]);
+		to_view(&p, pos[n]);
+		pos[n][3] = l->strength;
+		memcpy(col[n], l->col, sizeof(col[n]));
+		n++;
+	}
+	glUniform1i(W.nlamps, n);
+	if (n) {
+		glUniform4fv(W.lamppos, n, pos[0]);
+		glUniform3fv(W.lampcol, n, col[0]);
+	}
+}
+
+int plight_bind(grs_bitmap *bm, int overlay)
+{
+	int tmap, lit, flags, kind;
+	texmat *m;
+	if (!Face.on || !bm->gltexture)
+		return 0;
+	tmap = overlay ? Face.tmap2 : Face.tmap1;
+	glUseProgram(W.prog);
+	if (Frame_dirty) {
+		upload_frame();
+		Frame_dirty = 0;
+	}
+	if (Lamps_seg != Face.seg) {
+		if (Face.lit)
+			upload_lamps(Face.seg);
+		else
+			glUniform1i(W.nlamps, 0);
+		Lamps_seg = Face.seg;
+	}
+	m = material(tmap);
+	lit = TmapInfo[tmap].lighting > 0;
+	if (!overlay && Face.tmap2 && bm != &GameBitmaps[Textures[Face.tmap1].index])	// merged with its overlay
+		lit |= TmapInfo[Face.tmap2].lighting > 0;
+	if (Light_subtracted[Face.seg] & (1 << Face.side))
+		lit = 0;
+	flags = surfaces_enabled() ? TmapInfo[tmap].flags : 0;
+	if (!overlay && Face.tmap2 && bm != &GameBitmaps[Textures[Face.tmap1].index])
+		flags |= surfaces_enabled() ? TmapInfo[Face.tmap2].flags : 0;
+	kind = flags & TMI_VOLATILE ? 1 : flags & TMI_WATER ? 2 : flags & TMI_FORCE_FIELD ? 3 : 0;
+	if (Face.lit)
+		glUniform4f(W.mat, lit ? 1.0f : 0.0f, m->bump, m->gloss, kind);
+	else
+		glUniform4f(W.mat, 0, 0, 0, kind);
+	glUniform1f(W.pools, Face.lit ? 1 : 0);
+	glUniform2f(W.texsize, bm->gltexture->tw, bm->gltexture->th);
+	{	// material maps (merged with its overlay: the base texture's, which share its uvs)
+		ogl_texture *t = bm->gltexture;
+		grs_bitmap *base = &GameBitmaps[Textures[Face.tmap1].index];
+		if (!overlay && Face.tmap2 && bm != base && base->gltexture)
+			t = base->gltexture;
+		glUniform3f(W.maps, t->nmap ? 1 : 0, t->gmap ? 1 : 0, t->emap ? 1 : 0);
+		if (t->nmap || t->gmap || t->emap) {
+			glActiveTexture(GL_TEXTURE3);
+			glBindTexture(GL_TEXTURE_2D, t->nmap);
+			glActiveTexture(GL_TEXTURE4);
+			glBindTexture(GL_TEXTURE_2D, t->gmap);
+			glActiveTexture(GL_TEXTURE5);
+			glBindTexture(GL_TEXTURE_2D, t->emap);
+			glActiveTexture(GL_TEXTURE0);
+		}
+	}
+	return 1;
+}
+
+void plight_unbind(void)
+{
+	glUseProgram(0);
+}
+
+int plight_haze_enabled(void)
+{
+#ifdef __EMSCRIPTEN__
+	return d2web_option(D2WEB_OPTION_HAZE) && d2web_gl_version() >= 2;
+#else
+	return 0;
+#endif
+}
+
+// The moving lights (not the ship's own glow and muzzle flashes, which would veil the whole
+// view) and the lamps that light the viewer's segment.
+int plight_haze_lights(float (*pos)[4], float (*col)[3], int max)
+{
+	int i, n = 0, seg = Viewer ? Viewer->segnum : -1;
+#ifdef __EMSCRIPTEN__
+	float lamp_gain = d2web_tune(18, 5.0f);
+#else
+	float lamp_gain = 5.0f;
+#endif
+	if (Built_level != Current_level_num || Built_segs != Highest_segment_index)
+		build_lamps();
+	for (i = 0; i < Pp_num_lights && n < max; i++) {
+		pp_light *l = &Pp_lights[i];
+		if (vm_vec_dist_quick(&l->pos, &View_position) < F1_0 * 8)
+			continue;
+		to_view(&l->pos, pos[n]);
+		pos[n][3] = 0;
+		col[n][0] = f2fl(l->emission.r);
+		col[n][1] = f2fl(l->emission.g);
+		col[n][2] = f2fl(l->emission.b);
+		n++;
+	}
+	if (seg >= 0 && seg <= Highest_segment_index)
+		for (i = 0; i < Seg_nlamps[seg] && n < max; i++) {
+			lamp *l = &Lamps[Seg_lamps[seg][i]];
+			vms_vector p;
+			if (Light_subtracted[l->seg] & (1 << l->side))
+				continue;
+			p.x = fl2f(l->pos[0]);
+			p.y = fl2f(l->pos[1]);
+			p.z = fl2f(l->pos[2]);
+			to_view(&p, pos[n]);
+			pos[n][3] = 0;
+			col[n][0] = l->col[0] * l->strength * lamp_gain;
+			col[n][1] = l->col[1] * l->strength * lamp_gain;
+			col[n][2] = l->col[2] * l->strength * lamp_gain;
+			n++;
+		}
+	return n;
+}
+
+int plight_headlight(float *pos, float *dir)
+{
+	if (!Viewer || Viewer->type != OBJ_PLAYER || !(Players[Viewer->id].flags & PLAYER_FLAGS_HEADLIGHT_ON))
+		return 0;
+	to_view(&Viewer->pos, pos);
+	dir_to_view(&Viewer->orient.fvec, dir);
+	return 1;
+}
