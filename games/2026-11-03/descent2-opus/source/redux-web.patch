+
+/* Puts robot type id dist units ahead of the ship, facing it (replacing the last one put
+ * there): with ai it moves its joints and fires like any robot, holding its place; without,
+ * it stays in its rest pose. Returns its object number or -1. */
+EMSCRIPTEN_KEEPALIVE int d2web_test_robot(int id, int dist, int ai)
+{
+	static int last = -1, last_sig;
+	vms_vector pos, back;
+	object *obj;
+	int seg;
+
+	if (last >= 0 && Objects[last].type == OBJ_ROBOT && Objects[last].signature == last_sig)
+		obj_delete(last);
+	last = -1;
+	if (!ConsoleObject || id < 0 || id >= N_robot_types)
+		return -1;
+	vm_vec_scale_add(&pos, &ConsoleObject->pos, &ConsoleObject->orient.fvec, i2f(dist));
+	if ((seg = find_point_seg(&pos, ConsoleObject->segnum)) < 0)
+		return -1;
+	if (!(obj = create_morph_robot(&Segments[seg], &pos, id)))
+		return -1;
+	back = ConsoleObject->orient.fvec;
+	vm_vec_negate(&back);
+	vm_vector_2_matrix(&obj->orient, &back, &ConsoleObject->orient.uvec, NULL);
+	obj->ctype.ai_info.behavior = AIB_STILL;
+	if (!ai)
+		obj->control_type = CT_NONE;
+	last = obj - Objects;
+	last_sig = obj->signature;
+	return last;
+}
+
+#define PAST_DOOR_MAX 4
+static int past_doors[PAST_DOOR_MAX], n_past_doors;	// seg * 6 + side of each door a robot was put behind (test)
+
+/* The i-th door d2web_place_robots_past_first_doors used, as seg * 6 + side (for d2web_test_view), or -1. */
+EMSCRIPTEN_KEEPALIVE int d2web_test_past_door(int i)
+{
+	return i >= 0 && i < n_past_doors ? past_doors[i] : -1;
+}
+
+/* One robot of type id just past the door on side door_side of door_seg, facing the door and holding its place. */
+static int place_robot_past_door(int id, int door_seg, int door_side)
+{
+	int beyond = Segments[door_seg].children[door_side], seg;
+	vms_vector door, center, dir, pos, face;
+	fix rad = Polygon_models[Robot_info[id].model_num].rad, reach;
+	object *obj;
+
+	compute_center_point_on_side(&door, &Segments[door_seg], door_side);
+	compute_segment_center(&center, &Segments[beyond]);
+	// clear of the door by its size, further in than the next segment's middle if that is too close
+	reach = vm_vec_normalized_dir(&dir, &center, &door);
+	if (reach < fixmul(rad, F1_0 * 3 / 2))
+		reach = fixmul(rad, F1_0 * 3 / 2);
+	vm_vec_scale_add(&pos, &door, &dir, reach);
+	if ((seg = find_point_seg(&pos, beyond)) < 0) {
+		pos = center;
+		seg = beyond;
+	}
+	if (!(obj = create_morph_robot(&Segments[seg], &pos, id)))
+		return -1;
+	vm_vec_sub(&face, &door, &pos);
+	vm_vector_2_matrix(&obj->orient, &face, NULL, NULL);
+	init_ai_object(obj - Objects, AIB_STILL, -1);
+	return obj - Objects;
+}
+
+int d2web_place_robots_past_first_doors(int id)
+{
+	static short queue[MAX_SEGMENTS], depth[MAX_SEGMENTS];
+	static ubyte seen[MAX_SEGMENTS];
+	int head = 0, tail = 0, found_depth = -1, placed = 0;
+
+	n_past_doors = 0;
+	if (!ConsoleObject || id < 0 || id >= N_robot_types)
+		return 0;
+	// the segments the ship can fly to without opening anything, nearest first; the doors it can open at the
+	// nearest distance (the "first doors": there can be more than one way on) each get a robot
+	memset(seen, 0, sizeof(seen));
+	queue[tail++] = ConsoleObject->segnum;
+	seen[ConsoleObject->segnum] = 1;
+	depth[ConsoleObject->segnum] = 0;
+	while (head < tail) {
+		int s = queue[head++], side;
+		if (found_depth >= 0 && depth[s] > found_depth)
+			break;
+		for (side = 0; side < MAX_SIDES_PER_SEGMENT; side++) {
+			int child = Segments[s].children[side], w = Segments[s].sides[side].wall_num;
+			if (!IS_CHILD(child) || seen[child])
+				continue;
+			if (w < 0) {
+				seen[child] = 1;
+				depth[child] = depth[s] + 1;
+				queue[tail++] = child;
+			} else if (Walls[w].type == WALL_DOOR && Walls[w].keys == KEY_NONE && !(Walls[w].flags & WALL_DOOR_LOCKED) &&
+			           n_past_doors < PAST_DOOR_MAX) {
+				seen[child] = 1;	// one robot per room past the doors
+				found_depth = depth[s];
+				if (place_robot_past_door(id, s, side) >= 0) {
+					past_doors[n_past_doors++] = s * 6 + side;
+					placed++;
+				}
+			}
+		}
+	}
+	return placed;
+}
+
+/* Sets a robot's shields to percent of its full strength (damaged robots smoke). */
+EMSCRIPTEN_KEEPALIVE void d2web_test_shields(int objnum, int percent)
+{
+	if (objnum >= 0 && objnum <= Highest_object_index && Objects[objnum].type == OBJ_ROBOT)
+		Objects[objnum].shields = Robot_info[Objects[objnum].id].strength * percent / 100;
+}
+
+/* 0 draws the game's own models instead of the loaded high-resolution ones. */
+extern int xmodel_enabled;
+EMSCRIPTEN_KEEPALIVE void d2web_test_hires_models(int on)
+{
+	xmodel_enabled = on;
+}
+
+/* Puts the ship at the far side of segment segnum, looking at the middle of side sidenum.
+ * Returns 0 if there is no such segment. */
+EMSCRIPTEN_KEEPALIVE int d2web_test_view(int segnum, int sidenum)
+{
+	vms_vector from, to, center, fvec;
+	if (!ConsoleObject || segnum < 0 || segnum > Highest_segment_index || sidenum < 0 || sidenum >= MAX_SIDES_PER_SEGMENT)
+		return 0;
+	compute_segment_center(&center, &Segments[segnum]);
+	compute_center_point_on_side(&to, &Segments[segnum], sidenum);
+	compute_center_point_on_side(&from, &Segments[segnum], Side_opposite[sidenum]);
+	vm_vec_avg(&from, &from, &center);
+	vm_vec_sub(&fvec, &to, &from);
+	vm_vector_2_matrix(&ConsoleObject->orient, &fvec, NULL, NULL);
+	ConsoleObject->pos = from;
+	vm_vec_zero(&ConsoleObject->mtype.phys_info.velocity);
+	vm_vec_zero(&ConsoleObject->mtype.phys_info.rotvel);
+	obj_relink(ConsoleObject - Objects, segnum);
+	Players[Player_num].shields = MAX_SHIELDS;	// robots there may have been shooting
+	return 1;
+}
+
+/* The first side at or after seg * 6 + side (counting that way) whose texture gives light,
+ * as seg * 6 + side, or -1. */
+EMSCRIPTEN_KEEPALIVE int d2web_test_next_light(int from)
+{
+	int i;
+	for (i = from < 0 ? 0 : from; i < (Highest_segment_index + 1) * MAX_SIDES_PER_SEGMENT; i++) {
+		side *s = &Segments[i / MAX_SIDES_PER_SEGMENT].sides[i % MAX_SIDES_PER_SEGMENT];
+		if (Segments[i / MAX_SIDES_PER_SEGMENT].children[i % MAX_SIDES_PER_SEGMENT] == -1 &&
+			(TmapInfo[s->tmap_num].lighting > 0 || (s->tmap_num2 && TmapInfo[s->tmap_num2 & 0x3fff].lighting > 0)))
+			return i;
+	}
+	return -1;
+}
+
+/* Switches the view: 0 full cockpit, 2 status bar, 3 full screen (CM_*). */
+#include "playsave.h"
+extern void init_cockpit(void);
+EMSCRIPTEN_KEEPALIVE void d2web_test_cockpit(int mode)
+{
+	PlayerCfg.CurrentCockpitMode = mode;
+	init_cockpit();
+}
+
+/* Sets player flags (PLAYER_FLAGS_*), e.g. a headlight that is on. */
+#include "player.h"
+EMSCRIPTEN_KEEPALIVE void d2web_test_player_flags(int flags)
+{
+	Players[Player_num].flags |= flags;
+}
+
+/* Like d2web_test_next_light, for sides whose texture has one of the TMI_* flags in mask
+ * (1 lava, 2 water, 4 force field). */
+EMSCRIPTEN_KEEPALIVE int d2web_test_next_surface(int from, int mask)
+{
+	int i;
+	for (i = from < 0 ? 0 : from; i < (Highest_segment_index + 1) * MAX_SIDES_PER_SEGMENT; i++) {
+		segment *sg = &Segments[i / MAX_SIDES_PER_SEGMENT];
+		side *s = &sg->sides[i % MAX_SIDES_PER_SEGMENT];
+		if ((sg->children[i % MAX_SIDES_PER_SEGMENT] == -1 || s->wall_num != -1) &&
+			((TmapInfo[s->tmap_num].flags | (s->tmap_num2 ? TmapInfo[s->tmap_num2 & 0x3fff].flags : 0)) & mask))
+			return i;
+	}
+	return -1;
+}
+
+/* Blows up a robot as if the ship shot it. */
+#include "collide.h"
+EMSCRIPTEN_KEEPALIVE void d2web_test_kill(int objnum)
+{
+	if (objnum >= 0 && objnum <= Highest_object_index && Objects[objnum].type == OBJ_ROBOT)
+		apply_damage_to_robot(&Objects[objnum], Objects[objnum].shields + F1_0, ConsoleObject - Objects);
+}
+
+/* 1 stops robots firing (for clean comparison shots). */
+#include "game.h"
+EMSCRIPTEN_KEEPALIVE void d2web_test_calm(int on)
+{
+	cheats.robotfiringsuspended = on;
+}
+
+/* Turns an object to pitch, heading and bank in degrees (for looking at a robot from all sides). */
+EMSCRIPTEN_KEEPALIVE void d2web_test_orient(int objnum, int pitch, int heading, int bank)
+{
+	vms_angvec a;
+	if (objnum < 0 || objnum > Highest_object_index)
+		return;
+	a.p = pitch * 65536 / 360;
+	a.h = heading * 65536 / 360;
+	a.b = bank * 65536 / 360;
+	vm_angles_2_matrix(&Objects[objnum].orient, &a);
+	vm_vec_zero(&Objects[objnum].mtype.phys_info.rotvel);
+}
+
+/* Sets the reticle type (2 = none, for clean screenshots). */
+EMSCRIPTEN_KEEPALIVE void d2web_test_reticle(int type)
+{
+	PlayerCfg.ReticleType = type;
+}
+
+/* Turns an object about its own up axis by heading degrees, then about its right axis by pitch. */
+EMSCRIPTEN_KEEPALIVE void d2web_test_turn(int objnum, int heading, int pitch)
+{
+	vms_matrix *m;
+	vms_vector f, r, u;
+	fix s, c;
+	if (objnum < 0 || objnum > Highest_object_index)
+		return;
+	m = &Objects[objnum].orient;
+	fix_sincos(heading * 65536 / 360, &s, &c);
+	vm_vec_copy_scale(&f, &m->fvec, c);
+	vm_vec_scale_add2(&f, &m->rvec, s);
+	vm_vec_copy_scale(&r, &m->rvec, c);
+	vm_vec_scale_add2(&r, &m->fvec, -s);
+	m->fvec = f;
+	m->rvec = r;
+	fix_sincos(pitch * 65536 / 360, &s, &c);
+	vm_vec_copy_scale(&f, &m->fvec, c);
+	vm_vec_scale_add2(&f, &m->uvec, -s);
+	vm_vec_copy_scale(&u, &m->uvec, c);
+	vm_vec_scale_add2(&u, &m->fvec, s);
+	m->fvec = f;
+	m->uvec = u;
+	vm_vec_zero(&Objects[objnum].mtype.phys_info.rotvel);
+}
+
+/* The game model number robot type id uses. */
+EMSCRIPTEN_KEEPALIVE int d2web_test_robot_model(int id)
+{
+	return id >= 0 && id < N_robot_types ? Robot_info[id].model_num : -1;
+}
+
+/* How many robots of type id the level has now. */
+EMSCRIPTEN_KEEPALIVE int d2web_test_count_robots(int id)
+{
+	int i, n = 0;
+	for (i = 0; i <= Highest_object_index; i++)
+		if (Objects[i].type == OBJ_ROBOT && Objects[i].id == id)
+			n++;
+	return n;
+}
