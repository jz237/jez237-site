+static int timer_frame_due(void)
+{
+	struct timeval tv;
+	long long now, expire;
+
+	if (!timer_started)
+		return 1;
+	gettimeofday(&tv, NULL);
+	now = (long long)tv.tv_sec * 1000000 + tv.tv_usec;
+	expire = (long long)timer_expire.tv_sec * 1000000 + timer_expire.tv_usec;
+	if (now < expire)
+		return 0;
+	if (now - expire > 1000000)	// fell far behind (tab was hidden): don't fast-forward
+		timer_start();
+	return 1;
+}
+
+static void timer_advance(void)
+{
+	int nsec;
+
+	timer_expire.tv_usec += micro_frame_delay;
+	if (timer_expire.tv_usec > 1000000)
+	{
+		nsec = timer_expire.tv_usec / 1000000;
+		timer_expire.tv_sec += nsec;
+		timer_expire.tv_usec -= nsec*1000000;
+	}
+}
+#endif
