new file mode 100644
index 0000000..7548cfc
--- /dev/null
+++ b/d2/arch/ogl/ogl_post.c
@@ -0,0 +1,807 @@
+/*
+ * Post-processing of the 3D view (browser edition, WebGL 2). The mine is drawn into an
+ * off-screen HDR image (multisampled when the page asks for antialiasing), then ambient
+ * occlusion darkens creases and contact points, light haze scatters the lights in the air
+ * (with the headlight's beam), glow (bloom) spreads from everything bright, and a filmic curve
+ * maps it to the screen, with FXAA when there is no multisampling.
+ */
+
+#define GL_GLEXT_PROTOTYPES
+#include <GL/gl.h>
+#include <GL/glext.h>
+#include <math.h>
+#include "ogl_init.h"
+#include "internal.h"
+#include "gr.h"
+#include "config.h"
+#include "console.h"
+#include "../../3d/globvars.h"
+#include "plight.h"
+#ifdef __EMSCRIPTEN__
+#include "../web/web.h"
+#endif
+
+#ifndef GL_READ_FRAMEBUFFER
+#define GL_READ_FRAMEBUFFER 0x8CA8
+#define GL_DRAW_FRAMEBUFFER 0x8CA9
+#endif
+#ifndef GL_DEPTH_COMPONENT24
+#define GL_DEPTH_COMPONENT24 0x81A6
+#endif
+#define GL_R11F_G11F_B10F_ 0x8C3A
+#define GL_RGBA16F_ 0x881A
+#define GL_HALF_FLOAT_ 0x140B
+#define GL_MAX_SAMPLES_ 0x8D57
+
+void glBlitFramebuffer(GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLbitfield, GLenum);
+void glRenderbufferStorageMultisample(GLenum, GLsizei, GLenum, GLsizei, GLsizei);
+
+#define BLOOM_LEVELS 6
+#define MAX_HAZE 16
+#define Z_NEAR 0.1f		// ogl_start_frame's projection
+#define Z_FAR 5000.0f
+
+#define LOOK_GLOW 1
+#define LOOK_AO 2
+#define LOOK_HAZE 4
+
+typedef struct target {
+	GLuint fbo, tex;
+	int w, h;
+} target;
+
+static struct {
+	int tried, ok;
+	GLenum color_format;		// of the HDR images
+	int w, h, samples;			// of the scene buffers now
+	GLuint ms_fbo, ms_color, ms_depth;	// multisampled scene
+	target scene, ldr;			// resolved scene (with depth), tone mapped before FXAA
+	GLuint depth;				// resolved depth texture
+	target bloom[BLOOM_LEVELS];
+	target ao[2];				// half size, before and after blurring one way
+	int levels;
+	int x, y;					// the view's origin in window coordinates
+	int active, look;
+	GLuint down, prefilter, up, ssao, aoblur, fxaa;
+	GLuint final[8];			// by LOOK_* bits
+} P;
+
+// last frame's view (color and depth) and where it was seen from, for reflections
+static struct {
+	target t;
+	GLuint depth;
+	int valid;
+	vms_vector pos;
+	vms_matrix orient;
+	vms_vector scale;
+} H;
+
+static const char *quad_vs =
+	"in vec4 a_position;\n"
+	"out vec2 v_uv;\n"
+	"void main() {\n"
+	"	v_uv = a_position.xy * 0.5 + 0.5;\n"
+	"	gl_Position = vec4(a_position.xy, 0.0, 1.0);\n"
+	"}\n";
+
+// View-space positions from the depth buffer, with the view's zoom and aspect undone (scale)
+// so lengths are in mine units, as plight.c gives its lights.
+static const char *depth_glsl =
+	"uniform sampler2D depth;\n"
+	"uniform vec3 scale;\n"
+	"uniform vec2 nearfar;\n"
+	"float dist_at(vec2 uv) {\n"	// along the view axis, in the view's scaled units
+	"	float z = texture(depth, uv).r * 2.0 - 1.0;\n"
+	"	return 2.0 * nearfar.x * nearfar.y / (nearfar.y + nearfar.x - z * (nearfar.y - nearfar.x));\n"
+	"}\n"
+	"vec3 view_at(vec2 uv) {\n"
+	"	float d = dist_at(uv);\n"
+	"	return vec3((uv * 2.0 - 1.0) * d, -d) / scale;\n"
+	"}\n"
+	"vec2 uv_of(vec3 p) {\n"
+	"	vec3 e = p * scale;\n"
+	"	return e.xy / max(-e.z, 1e-3) * 0.5 + 0.5;\n"
+	"}\n";
+
+// 13-tap downsample (Jimenez 2014). The first one keeps only what is brighter than the
+// threshold, with a soft knee, and weights its groups by 1/(1+luma) so single bright pixels
+// (sparks, far lamps) don't flicker.
+static const char *down_fs =
+	"uniform sampler2D src;\n"
+	"uniform vec2 texel;\n"
+	"uniform vec2 thresh;\n"
+	"in vec2 v_uv;\n"
+	"out vec4 o;\n"
+	"vec3 at(vec2 d) { return min(texture(src, v_uv + d * texel).rgb, vec3(64.0)); }\n"
+	"float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }\n"
+	"void main() {\n"
+	"	vec3 a = at(vec2(-2.0, -2.0)), b = at(vec2(0.0, -2.0)), c = at(vec2(2.0, -2.0));\n"
+	"	vec3 d = at(vec2(-1.0, -1.0)), e = at(vec2(1.0, -1.0));\n"
+	"	vec3 f = at(vec2(-2.0, 0.0)), g = at(vec2(0.0)), h = at(vec2(2.0, 0.0));\n"
+	"	vec3 i = at(vec2(-1.0, 1.0)), j = at(vec2(1.0, 1.0));\n"
+	"	vec3 k = at(vec2(-2.0, 2.0)), l = at(vec2(0.0, 2.0)), m = at(vec2(2.0, 2.0));\n"
+	"#ifdef PREFILTER\n"
+	"	vec3 g0 = (d + e + i + j) * 0.25, g1 = (a + b + f + g) * 0.25, g2 = (b + c + g + h) * 0.25;\n"
+	"	vec3 g3 = (f + g + k + l) * 0.25, g4 = (g + h + l + m) * 0.25;\n"
+	"	float w0 = 0.5 / (1.0 + luma(g0)), w1 = 0.125 / (1.0 + luma(g1)), w2 = 0.125 / (1.0 + luma(g2));\n"
+	"	float w3 = 0.125 / (1.0 + luma(g3)), w4 = 0.125 / (1.0 + luma(g4));\n"
+	"	vec3 s = (g0 * w0 + g1 * w1 + g2 * w2 + g3 * w3 + g4 * w4) / (w0 + w1 + w2 + w3 + w4);\n"
+	"	float br = mix(luma(s), max(max(s.r, s.g), s.b), 0.5);\n"	// saturated colors glow less
+	"	float soft = clamp(br - thresh.x + thresh.y, 0.0, 2.0 * thresh.y);\n"
+	"	soft = soft * soft / (4.0 * thresh.y + 1e-4);\n"
+	"	o = vec4(s * max(soft, br - thresh.x) / max(br, 1e-4), 1.0);\n"
+	"#else\n"
+	"	o = vec4((d + e + i + j) * 0.125 + (a + c + k + m) * 0.03125 + (b + f + h + l) * 0.0625 + g * 0.125, 1.0);\n"
+	"#endif\n"
+	"}\n";
+
+// 3x3 tent upsample, added onto the next larger level
+static const char *up_fs =
+	"uniform sampler2D src;\n"
+	"uniform vec2 texel;\n"
+	"uniform float scale;\n"
+	"in vec2 v_uv;\n"
+	"out vec4 o;\n"
+	"vec3 at(vec2 d) { return texture(src, v_uv + d * texel).rgb; }\n"
+	"void main() {\n"
+	"	vec3 c = at(vec2(-1.0, -1.0)) + at(vec2(1.0, -1.0)) + at(vec2(-1.0, 1.0)) + at(vec2(1.0, 1.0))\n"
+	"		+ 2.0 * (at(vec2(0.0, -1.0)) + at(vec2(-1.0, 0.0)) + at(vec2(1.0, 0.0)) + at(vec2(0.0, 1.0)))\n"
+	"		+ 4.0 * at(vec2(0.0));\n"
+	"	o = vec4(c * (scale / 16.0), 1.0);\n"
+	"}\n";
+
+// Ambient occlusion at half size: how much of the half-space above each pixel nearby surfaces
+// cover, from 12 depth samples on a spiral (turned per pixel; the blur evens that out).
+static const char *ssao_fs =
+	"uniform vec2 texel;\n"		// of the depth buffer
+	"uniform vec2 ao;\n"		// radius in units, strength
+	"in vec2 v_uv;\n"
+	"out vec4 o;\n"
+	"void main() {\n"
+	"	vec3 p = view_at(v_uv);\n"
+	"	vec3 pr = view_at(v_uv + vec2(texel.x, 0.0)) - p, pl = p - view_at(v_uv - vec2(texel.x, 0.0));\n"
+	"	vec3 pu = view_at(v_uv + vec2(0.0, texel.y)) - p, pd = p - view_at(v_uv - vec2(0.0, texel.y));\n"
+	"	vec3 n = normalize(cross(abs(pr.z) < abs(pl.z) ? pr : pl, abs(pu.z) < abs(pd.z) ? pu : pd));\n"
+	"	if (dot(n, p) > 0.0) n = -n;\n"
+	"	float d = -p.z * scale.z;\n"
+	"	if (d > 600.0) { o = vec4(1.0); return; }\n"
+	"	vec2 r = min(ao.x * scale.xy / d * 0.5, vec2(0.12));\n"
+	"	float a = fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715)))) * 6.2832;\n"
+	"	float occ = 0.0;\n"
+	"	for (int i = 0; i < 12; i++) {\n"
+	"		float t = (float(i) + 0.5) / 12.0;\n"
+	"		float ang = a + float(i) * 2.39996;\n"
+	"		vec3 v = view_at(v_uv + vec2(cos(ang), sin(ang)) * r * sqrt(t)) - p;\n"
+	"		float l = length(v);\n"
+	"		occ += max(dot(v / max(l, 1e-4), n) - 0.15, 0.0) * (1.0 - smoothstep(ao.x * 0.6, ao.x * 1.6, l));\n"
+	"	}\n"
+	"	o = vec4(vec3(clamp(1.0 - ao.y * occ / 12.0 * 1.6, 0.0, 1.0)), 1.0);\n"
+	"}\n";
+
+// separable blur that keeps edges: neighbors at another depth count less
+static const char *aoblur_fs =
+	"uniform sampler2D src;\n"
+	"uniform vec2 stepv;\n"
+	"in vec2 v_uv;\n"
+	"out vec4 o;\n"
+	"void main() {\n"
+	"	float d0 = dist_at(v_uv), sum = 0.0, wsum = 0.0;\n"
+	"	for (int i = -4; i <= 4; i++) {\n"
+	"		vec2 uv = v_uv + stepv * float(i);\n"
+	"		float w = exp(-float(i * i) / 10.0) * exp(-abs(dist_at(uv) - d0) / (0.04 * d0 + 0.2));\n"
+	"		sum += texture(src, uv).r * w;\n"
+	"		wsum += w;\n"
+	"	}\n"
+	"	o = vec4(vec3(sum / wsum), 1.0);\n"
+	"}\n";
+
+// Occlusion and haze, glow, then the filmic curve: colors up to the knee stay as the game drew
+// them, brighter ones roll off smoothly toward white instead of clipping; a little contrast and
+// vignette. Haze: light scattered toward the eye along each view ray up to the wall it hits, from
+// each light (an inverse-square integral that has a closed form) and the headlight's cone.
+static const char *final_fs =
+	"uniform sampler2D scene;\n"
+	"uniform sampler2D bloom;\n"
+	"uniform int nblast;\n"			// live blasts (fx.c): view-space centre, shockwave radius
+	"uniform vec4 bpos[8];\n"
+	"uniform vec4 bprm[8];\n"		// age 0..1, size
+	"uniform vec4 fxp;\n"			// heat ripple, light shafts, lens streaks, colour fringe
+	"uniform float ftime;\n"
+	"uniform sampler2D aotex;\n"
+	"uniform sampler2D fogtex;\n"
+	"uniform vec4 look;\n"	// bloom strength, knee, contrast, vignette
+	"uniform vec4 hazep;\n"	// light haze, beam, fog, -
+	"uniform int nhaze;\n"
+	"uniform vec4 hpos[16];\n"
+	"uniform vec3 hcol[16];\n"
+	"uniform vec4 headpos;\n"
+	"uniform vec3 headdir;\n"
+	"in vec2 v_uv;\n"
+	"out vec4 o;\n"
+	"float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }\n"
+	"float lum(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }\n"
+	"void main() {\n"
+	"	vec2 uv = v_uv;\n"
+	"	float flash = 0.0;\n"
+	"#ifdef GLOW\n"
+	// each blast's shockwave ring bends the view as it passes, and the hot air inside shimmers
+	"	for (int i = 0; i < 8; i++) {\n"
+	"		if (i >= nblast) break;\n"
+	"		vec3 L = bpos[i].xyz;\n"
+	"		vec2 cu = uv_of(L);\n"
+	"		vec2 ru = abs(vec2(uv_of(L + vec3(bpos[i].w, 0.0, 0.0)).x - cu.x, uv_of(L + vec3(0.0, bpos[i].w, 0.0)).y - cu.y));\n"
+	"		vec2 d = v_uv - cu;\n"
+	"		vec2 dn = d / max(ru, vec2(1e-4));\n"
+	"		float r = length(dn), t = bprm[i].x, fade = (1.0 - t) * (1.0 - t);\n"
+	"		float band = exp(-pow((r - 1.0) / 0.22, 2.0));\n"
+	"		uv += d / max(length(d), 1e-4) * band * fade * ru.x * 0.35 * fxp.x;\n"
+	"		float inside = smoothstep(1.1, 0.2, r) * fade;\n"
+	"		uv += vec2(sin(v_uv.y * 90.0 + ftime * 13.0), cos(v_uv.x * 80.0 - ftime * 11.0)) * inside * ru.x * 0.025 * fxp.x;\n"
+	"		flash += smoothstep(0.3, 0.0, t) * min(bprm[i].y / 6.0, 1.0);\n"
+	"	}\n"
+	"#endif\n"
+	"	vec3 c = min(texture(scene, uv).rgb, vec3(64.0));\n"	// no infinite light
+	"#ifdef GLOW\n"
+	// colour fringe: a faint one toward the edges always, a strong one in a big blast's first flash
+	"	float ca = fxp.w * (0.0012 + flash * 0.008);\n"
+	"	vec2 cd = (uv - 0.5) * ca;\n"
+	"	c.r = min(texture(scene, uv + cd).r, 64.0);\n"
+	"	c.b = min(texture(scene, uv - cd).b, 64.0);\n"
+	"#endif\n"
+	"#ifdef AO\n"
+	"	float a = texture(aotex, v_uv).r;\n"
+	"	c *= mix(a, 1.0, smoothstep(0.7, 1.5, lum(c)));\n"	// lights themselves stay bright
+	"#endif\n"
+	"#ifdef HAZE\n"
+	"	vec3 pe = view_at(v_uv);\n"
+	"	float T = length(pe);\n"
+	"	vec3 D = pe / T;\n"
+	"	vec3 hz = vec3(0.0);\n"
+	"	for (int i = 0; i < 16; i++) {\n"
+	"		if (i >= nhaze) break;\n"
+	"		vec3 L = hpos[i].xyz;\n"
+	"		float t0 = dot(L, D);\n"
+	"		float h = max(length(L - D * t0), 0.4);\n"
+	"		float s = (atan((T - t0) / h) - atan(-t0 / h)) / h;\n"
+	"		vec2 lu = uv_of(L);\n"			// is the light itself behind a wall?
+	"		float vis = 0.5;\n"
+	"		if (L.z < 0.0 && all(greaterThan(lu, vec2(0.0))) && all(lessThan(lu, vec2(1.0))))\n"
+	"			vis = smoothstep(-2.0, 2.0, length(view_at(lu)) - length(L));\n"
+	"		hz += hcol[i] * s * vis;\n"
+	"	}\n"
+	"	hz *= hazep.x;\n"
+	"	if (headpos.w > 0.0) {\n"
+	"		float te = min(T, 160.0), beam = 0.0, dt = te / 12.0;\n"
+	"		float j = hash(gl_FragCoord.xy + 0.5);\n"
+	"		for (int i = 0; i < 12; i++) {\n"
+	"			vec3 x = D * ((float(i) + j) * dt) - headpos.xyz;\n"
+	"			float d = length(x);\n"
+	"			float cd = dot(x / max(d, 1e-3), headdir);\n"
+	"			beam += smoothstep(0.62, 0.92, cd) / (1.0 + d * d / 6000.0);\n"
+	"		}\n"
+	"		hz += vec3(1.0, 0.97, 0.9) * beam * dt * hazep.y;\n"
+	"	}\n"
+	"	hz += texture(fogtex, v_uv).rgb * (1.0 - exp(-T * hazep.z));\n"	// the room's own glow, far away
+	"	c += hz;\n"
+	"#endif\n"
+	"#ifdef GLOW\n"
+	"	c += texture(bloom, v_uv).rgb * look.x;\n"
+	// light shafts: the bloom smeared out from each blast's centre, rays through the smoke and dust
+	"	for (int i = 0; i < 8; i++) {\n"
+	"		if (i >= nblast) break;\n"
+	"		vec2 cu = uv_of(bpos[i].xyz);\n"
+	"		vec2 dir = (cu - v_uv) / 14.0;\n"
+	"		vec3 acc = vec3(0.0);\n"
+	"		float w = 1.0, j = hash(gl_FragCoord.xy + float(i));\n"
+	"		for (int k = 0; k < 14; k++) {\n"
+	"			acc += texture(bloom, v_uv + dir * (float(k) + j)).rgb * w;\n"
+	"			w *= 0.9;\n"
+	"		}\n"
+	"		float t = bprm[i].x;\n"
+	"		c += acc / 14.0 * (1.0 - t) * min(bprm[i].y / 3.0, 1.5) * fxp.y;\n"
+	"	}\n"
+	// anamorphic lens streaks: bright light smeared sideways, tinted cool
+	"	vec3 st = vec3(0.0);\n"
+	"	for (int k = 1; k <= 8; k++) {\n"
+	"		float o = float(k) * 0.014, wk = 1.0 - float(k) / 9.0;\n"
+	"		st += (texture(bloom, v_uv + vec2(o, 0.0)).rgb + texture(bloom, v_uv - vec2(o, 0.0)).rgb) * wk;\n"
+	"	}\n"
+	"	c += st * vec3(0.5, 0.68, 1.0) * fxp.z * 0.12;\n"
+	"	float m = max(max(c.r, c.g), c.b);\n"
+	"	float k = look.y;\n"
+	"	float t = m <= k ? m : k + (1.0 - k) * (1.0 - exp((k - m) / (1.0 - k)));\n"
+	"	c *= t / max(m, 1e-4);\n"
+	"	c = mix(c, vec3(t), smoothstep(1.5, 8.0, m) * 0.35);\n"	// very bright light burns white
+	"	c = clamp(c, 0.0, 1.0);\n"
+	"	c = mix(c, c * c * (3.0 - 2.0 * c), look.z);\n"
+	"	vec2 q = v_uv - 0.5;\n"
+	"	c *= 1.0 - look.w * dot(q, q) * 2.0;\n"
+	"#endif\n"
+	"	c += (hash(gl_FragCoord.xy) - 0.5) / 255.0;\n"
+	"	o = vec4(c, 1.0);\n"
+	"}\n";
+
+// FXAA (after Timothy Lottes' console version) when the view isn't multisampled
+static const char *fxaa_fs =
+	"uniform sampler2D src;\n"
+	"uniform vec2 texel;\n"
+	"in vec2 v_uv;\n"
+	"out vec4 o;\n"
+	"float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }\n"
+	"void main() {\n"
+	"	vec3 nw = texture(src, v_uv + vec2(-1.0, -1.0) * texel).rgb;\n"
+	"	vec3 ne = texture(src, v_uv + vec2(1.0, -1.0) * texel).rgb;\n"
+	"	vec3 sw = texture(src, v_uv + vec2(-1.0, 1.0) * texel).rgb;\n"
+	"	vec3 se = texture(src, v_uv + vec2(1.0, 1.0) * texel).rgb;\n"
+	"	vec3 mc = texture(src, v_uv).rgb;\n"
+	"	float lnw = luma(nw), lne = luma(ne), lsw = luma(sw), lse = luma(se), lm = luma(mc);\n"
+	"	float lmin = min(lm, min(min(lnw, lne), min(lsw, lse)));\n"
+	"	float lmax = max(lm, max(max(lnw, lne), max(lsw, lse)));\n"
+	"	vec2 dir = vec2(-((lnw + lne) - (lsw + lse)), (lnw + lsw) - (lne + lse));\n"
+	"	float red = max((lnw + lne + lsw + lse) * 0.03125, 1.0 / 128.0);\n"
+	"	float rcp = 1.0 / (min(abs(dir.x), abs(dir.y)) + red);\n"
+	"	dir = clamp(dir * rcp, -8.0, 8.0) * texel;\n"
+	"	vec3 a = 0.5 * (texture(src, v_uv - dir / 6.0).rgb + texture(src, v_uv + dir / 6.0).rgb);\n"
+	"	vec3 b = a * 0.5 + 0.25 * (texture(src, v_uv - dir * 0.5).rgb + texture(src, v_uv + dir * 0.5).rgb);\n"
+	"	float lb = luma(b);\n"
+	"	o = vec4(lb < lmin || lb > lmax ? a : b, 1.0);\n"
+	"}\n";
+
+static GLuint program(const char *defines, const char *fs, int with_depth)
+{
+	static const char *samplers[] = { "src", "scene", "bloom", "aotex", "fogtex", "depth" };
+	static const int units[] = { 0, 0, 1, 2, 3, 4 };
+	char body[16384];
+	GLuint p;
+	int i;
+	snprintf(body, sizeof(body), "%s%s", with_depth ? depth_glsl : "", fs);
+	if (!(p = ogl_program3(quad_vs, defines, body)))
+		return 0;
+	glUseProgram(p);
+	for (i = 0; i < 6; i++) {
+		GLint loc = glGetUniformLocation(p, samplers[i]);
+		if (loc >= 0)
+			glUniform1i(loc, units[i]);
+	}
+	return p;
+}
+
+static int format_renders(GLenum ifmt)
+{
+	GLuint t, f;
+	int ok;
+	glGenTextures(1, &t);
+	glBindTexture(GL_TEXTURE_2D, t);
+	glTexImage2D(GL_TEXTURE_2D, 0, ifmt, 4, 4, 0, ifmt == GL_RGBA16F_ ? GL_RGBA : GL_RGB, GL_HALF_FLOAT_, NULL);
+	glGenFramebuffers(1, &f);
+	glBindFramebuffer(GL_FRAMEBUFFER, f);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t, 0);
+	ok = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	glDeleteFramebuffers(1, &f);
+	glDeleteTextures(1, &t);
+	return ok;
+}
+
+static int ready(void)
+{
+	if (P.tried)
+		return P.ok;
+	P.tried = 1;
+#ifdef __EMSCRIPTEN__
+	if (d2web_gl_version() < 2)
+		return 0;
+#endif
+	P.down = program("", down_fs, 0);
+	P.prefilter = program("#define PREFILTER 1\n", down_fs, 0);
+	P.up = program("", up_fs, 0);
+	P.ssao = program("", ssao_fs, 1);
+	P.aoblur = program("", aoblur_fs, 1);
+	P.fxaa = program("", fxaa_fs, 0);
+	glUseProgram(0);
+	P.ok = P.down && P.prefilter && P.up && P.ssao && P.aoblur && P.fxaa;
+	if (!P.ok)
+		return 0;
+	P.color_format = format_renders(GL_R11F_G11F_B10F_) ? GL_R11F_G11F_B10F_ : format_renders(GL_RGBA16F_) ? GL_RGBA16F_ : GL_RGBA;
+	con_printf(CON_NORMAL, "post: HDR format %#x\n", P.color_format);
+	return 1;
+}
+
+static GLuint final_program(int look)
+{
+	if (!P.final[look]) {
+		char defines[96];
+		snprintf(defines, sizeof(defines), "%s%s%s", look & LOOK_GLOW ? "#define GLOW 1\n" : "",
+			look & LOOK_AO ? "#define AO 1\n" : "", look & LOOK_HAZE ? "#define HAZE 1\n" : "");
+		P.final[look] = program(defines, final_fs, 1);
+	}
+	return P.final[look];
+}
+
+static GLuint texture_make(int w, int h, GLenum ifmt)
+{
+	GLuint t;
+	GLenum fmt = ifmt == GL_R11F_G11F_B10F_ ? GL_RGB : ifmt == GL_DEPTH_COMPONENT24 ? GL_DEPTH_COMPONENT : GL_RGBA;
+	GLenum type = ifmt == GL_DEPTH_COMPONENT24 ? GL_UNSIGNED_INT : ifmt == GL_RGBA ? GL_UNSIGNED_BYTE : GL_HALF_FLOAT_;
+	GLenum filter = ifmt == GL_DEPTH_COMPONENT24 ? GL_NEAREST : GL_LINEAR;
+	glGenTextures(1, &t);
+	glBindTexture(GL_TEXTURE_2D, t);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glTexImage2D(GL_TEXTURE_2D, 0, ifmt, w, h, 0, fmt, type, NULL);
+	return t;
+}
+
+static void target_make(target *t, int w, int h, GLenum ifmt, GLuint depth)
+{
+	t->w = w;
+	t->h = h;
+	t->tex = texture_make(w, h, ifmt);
+	glGenFramebuffers(1, &t->fbo);
+	glBindFramebuffer(GL_FRAMEBUFFER, t->fbo);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t->tex, 0);
+	if (depth)
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, depth, 0);
+}
+
+static void target_free(target *t)
+{
+	if (t->fbo)
+		glDeleteFramebuffers(1, &t->fbo);
+	if (t->tex)
+		glDeleteTextures(1, &t->tex);
+	t->fbo = t->tex = 0;
+}
+
+static void buffers_free(void)
+{
+	int i;
+	target_free(&P.scene);
+	target_free(&P.ldr);
+	target_free(&P.ao[0]);
+	target_free(&P.ao[1]);
+	for (i = 0; i < BLOOM_LEVELS; i++)
+		target_free(&P.bloom[i]);
+	if (P.depth)
+		glDeleteTextures(1, &P.depth);
+	if (P.ms_fbo) {
+		glDeleteFramebuffers(1, &P.ms_fbo);
+		glDeleteRenderbuffers(1, &P.ms_color);
+		glDeleteRenderbuffers(1, &P.ms_depth);
+	}
+	P.depth = P.ms_fbo = P.ms_color = P.ms_depth = 0;
+	P.w = P.h = 0;
+}
+
+static void buffers_make(int w, int h, int samples)
+{
+	int i, bw = w, bh = h;
+	buffers_free();
+	P.w = w;
+	P.h = h;
+	P.samples = samples;
+	P.depth = texture_make(w, h, GL_DEPTH_COMPONENT24);
+	target_make(&P.scene, w, h, P.color_format, P.depth);
+	if (samples) {
+		glGenRenderbuffers(1, &P.ms_color);
+		glBindRenderbuffer(GL_RENDERBUFFER, P.ms_color);
+		glRenderbufferStorageMultisample(GL_RENDERBUFFER, samples, P.color_format == GL_RGBA ? GL_RGBA8 : P.color_format, w, h);
+		glGenRenderbuffers(1, &P.ms_depth);
+		glBindRenderbuffer(GL_RENDERBUFFER, P.ms_depth);
+		glRenderbufferStorageMultisample(GL_RENDERBUFFER, samples, GL_DEPTH_COMPONENT24, w, h);
+		glGenFramebuffers(1, &P.ms_fbo);
+		glBindFramebuffer(GL_FRAMEBUFFER, P.ms_fbo);
+		glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, P.ms_color);
+		glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, P.ms_depth);
+		if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+			con_printf(CON_URGENT, "post: no multisampling\n");
+			glDeleteFramebuffers(1, &P.ms_fbo);
+			glDeleteRenderbuffers(1, &P.ms_color);
+			glDeleteRenderbuffers(1, &P.ms_depth);
+			P.ms_fbo = P.ms_color = P.ms_depth = 0;
+			P.samples = 0;
+		}
+	}
+	target_make(&P.ldr, w, h, GL_RGBA, 0);
+	target_make(&P.ao[0], (w + 1) / 2, (h + 1) / 2, GL_RGBA, 0);
+	target_make(&P.ao[1], (w + 1) / 2, (h + 1) / 2, GL_RGBA, 0);
+	for (P.levels = 0; P.levels < BLOOM_LEVELS && bw > 16 && bh > 16; P.levels++) {
+		bw = (bw + 1) / 2;
+		bh = (bh + 1) / 2;
+		target_make(&P.bloom[P.levels], bw, bh, P.color_format, 0);
+	}
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	glBindRenderbuffer(GL_RENDERBUFFER, 0);
+}
+
+int ogl_post_active(void)
+{
+	return P.active;
+}
+
+// Last frame's view for reflections, and the matrix from this view's space (unscaled, GL axes)
+// to that one's. 0 when there is none to use.
+int ogl_post_history(unsigned *color, unsigned *depth, float *reproj, float *scale)
+{
+	float rc[3][3], rp[3][3], dp[3], m[3][3];
+	const float s[3] = { 1, 1, -1 };
+	const vms_vector *rows_c[3] = { &Unscaled_matrix.rvec, &Unscaled_matrix.uvec, &Unscaled_matrix.fvec };
+	const vms_vector *rows_p[3] = { &H.orient.rvec, &H.orient.uvec, &H.orient.fvec };
+	int i, j, k;
+	if (!P.active || !H.valid || H.t.w != P.w || H.t.h != P.h)
+		return 0;
+	for (i = 0; i < 3; i++) {
+		rc[i][0] = f2fl(rows_c[i]->x); rc[i][1] = f2fl(rows_c[i]->y); rc[i][2] = f2fl(rows_c[i]->z);
+		rp[i][0] = f2fl(rows_p[i]->x); rp[i][1] = f2fl(rows_p[i]->y); rp[i][2] = f2fl(rows_p[i]->z);
+	}
+	dp[0] = f2fl(View_position.x - H.pos.x);
+	dp[1] = f2fl(View_position.y - H.pos.y);
+	dp[2] = f2fl(View_position.z - H.pos.z);
+	for (i = 0; i < 3; i++)
+		for (j = 0; j < 3; j++) {
+			m[i][j] = 0;
+			for (k = 0; k < 3; k++)
+				m[i][j] += rp[i][k] * rc[j][k];
+			reproj[j * 4 + i] = s[i] * s[j] * m[i][j];
+		}
+	for (i = 0; i < 3; i++) {
+		float t = 0;
+		for (k = 0; k < 3; k++)
+			t += rp[i][k] * dp[k];
+		reproj[12 + i] = s[i] * t;
+		reproj[i * 4 + 3] = 0;
+	}
+	reproj[15] = 1;
+	scale[0] = f2fl(H.scale.x);
+	scale[1] = f2fl(H.scale.y);
+	scale[2] = f2fl(H.scale.z);
+	*color = H.t.tex;
+	*depth = H.depth;
+	return 1;
+}
+
+static void history_keep(void)
+{
+	int want = 0;
+#ifdef __EMSCRIPTEN__
+	want = d2web_option(D2WEB_OPTION_REFLECTIONS) && d2web_option(D2WEB_OPTION_LIGHTING);
+#endif
+	H.valid = 0;
+	if (!want)
+		return;
+	if (H.t.w != P.w || H.t.h != P.h) {
+		target_free(&H.t);
+		if (H.depth)
+			glDeleteTextures(1, &H.depth);
+		H.depth = texture_make(P.w, P.h, GL_DEPTH_COMPONENT24);
+		target_make(&H.t, P.w, P.h, P.color_format, H.depth);
+	}
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, P.scene.fbo);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, H.t.fbo);
+	glBlitFramebuffer(0, 0, P.w, P.h, 0, 0, P.w, P.h, GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+	H.pos = View_position;
+	H.orient = Unscaled_matrix;
+	H.scale = Matrix_scale;
+	H.valid = 1;
+}
+
+void ogl_post_origin(int *x, int *y)
+{
+	*x = P.active ? P.x : 0;
+	*y = P.active ? P.y : 0;
+}
+
+// Before the 3D view of the main window is drawn into the current canvas.
+int ogl_post_begin(void)
+{
+	grs_bitmap *bm = &grd_curcanv->cv_bitmap;
+	int samples = 0;
+
+	P.active = 0;
+	P.look = 0;
+#ifdef __EMSCRIPTEN__
+	P.look = (d2web_option(D2WEB_OPTION_GLOW) ? LOOK_GLOW : 0) | (d2web_option(D2WEB_OPTION_AO) ? LOOK_AO : 0) |
+		(d2web_option(D2WEB_OPTION_HAZE) ? LOOK_HAZE : 0);
+#endif
+	if (!P.look || !ready() || bm->bm_w < 64 || bm->bm_h < 64)
+		return 0;
+	if (GameCfg.Multisample) {
+		GLint max = 0;
+		glGetIntegerv(GL_MAX_SAMPLES_, &max);
+		samples = max < 4 ? max : 4;
+	}
+	if (P.w != bm->bm_w || P.h != bm->bm_h || (P.samples != samples && samples))
+		buffers_make(bm->bm_w, bm->bm_h, samples);
+	P.x = bm->bm_x;
+	P.y = grd_curscreen->sc_h - bm->bm_y - bm->bm_h;
+	glBindFramebuffer(GL_FRAMEBUFFER, P.samples ? P.ms_fbo : P.scene.fbo);
+	glDisable(GL_SCISSOR_TEST);
+	glViewport(0, 0, P.w, P.h);
+	last_width = P.w;
+	last_height = P.h;
+	glClearColor(0, 0, 0, 1);
+	glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+	P.active = 1;
+	return 1;
+}
+
+static void draw_quad(void)
+{
+	static const GLfloat quad[8] = { -1, -1, 1, -1, 1, 1, -1, 1 };
+	glEnableClientState(GL_VERTEX_ARRAY);
+	glVertexPointer(2, GL_FLOAT, 0, quad);
+	glDrawArrays(GL_TRIANGLE_FAN, 0, 4);
+	glDisableClientState(GL_VERTEX_ARRAY);
+}
+
+static void bind_target(target *t)
+{
+	glBindFramebuffer(GL_FRAMEBUFFER, t->fbo);
+	glViewport(0, 0, t->w, t->h);
+}
+
+static void bind_texture(int unit, GLuint tex)
+{
+	glActiveTexture(GL_TEXTURE0 + unit);
+	glBindTexture(GL_TEXTURE_2D, tex);
+}
+
+// the depth-reading programs' view uniforms
+static void set_view(GLuint p)
+{
+	glUniform3f(glGetUniformLocation(p, "scale"), f2fl(Matrix_scale.x), f2fl(Matrix_scale.y), f2fl(Matrix_scale.z));
+	glUniform2f(glGetUniformLocation(p, "nearfar"), Z_NEAR, Z_FAR);
+}
+
+static void bloom(void)
+{
+	int i;
+	target *src = &P.scene;
+	for (i = 0; i < P.levels; i++) {
+		GLuint p = i ? P.down : P.prefilter;
+		glUseProgram(p);
+		glUniform2f(glGetUniformLocation(p, "texel"), 1.0f / src->w, 1.0f / src->h);
+		if (!i)
+			glUniform2f(glGetUniformLocation(p, "thresh"), d2web_tune(7, 0.6f), d2web_tune(8, 0.36f));
+		bind_target(&P.bloom[i]);
+		bind_texture(0, src->tex);
+		draw_quad();
+		src = &P.bloom[i];
+	}
+	glUseProgram(P.up);
+	glEnable(GL_BLEND);
+	glBlendFunc(GL_ONE, GL_ONE);
+	for (i = P.levels - 1; i > 0; i--) {
+		glUniform2f(glGetUniformLocation(P.up, "texel"), 1.0f / P.bloom[i].w, 1.0f / P.bloom[i].h);
+		glUniform1f(glGetUniformLocation(P.up, "scale"), 1.0f);
+		bind_target(&P.bloom[i - 1]);
+		bind_texture(0, P.bloom[i].tex);
+		draw_quad();
+	}
+	glDisable(GL_BLEND);
+}
+
+static void occlusion(void)
+{
+	glUseProgram(P.ssao);
+	set_view(P.ssao);
+	glUniform2f(glGetUniformLocation(P.ssao, "texel"), 1.0f / P.w, 1.0f / P.h);
+	glUniform2f(glGetUniformLocation(P.ssao, "ao"), d2web_tune(16, 6.0f), d2web_tune(17, 2.0f));
+	bind_target(&P.ao[0]);
+	bind_texture(4, P.depth);
+	draw_quad();
+	glUseProgram(P.aoblur);
+	set_view(P.aoblur);
+	glUniform2f(glGetUniformLocation(P.aoblur, "stepv"), 1.0f / P.ao[0].w, 0);
+	bind_target(&P.ao[1]);
+	bind_texture(0, P.ao[0].tex);
+	draw_quad();
+	glUniform2f(glGetUniformLocation(P.aoblur, "stepv"), 0, 1.0f / P.ao[0].h);
+	bind_target(&P.ao[0]);
+	bind_texture(0, P.ao[1].tex);
+	draw_quad();
+}
+
+int fx_blasts(float (*pos)[4], float (*prm)[4], int max);	// main/fx.c
+extern fix64 GameTime64;	// main/game.c
+
+static void blast_uniforms(GLuint p)
+{
+	float pos[8][4], prm[8][4];
+	int n = fx_blasts(pos, prm, 8);
+	glUniform1i(glGetUniformLocation(p, "nblast"), n);
+	if (n) {
+		glUniform4fv(glGetUniformLocation(p, "bpos"), n, pos[0]);
+		glUniform4fv(glGetUniformLocation(p, "bprm"), n, prm[0]);
+	}
+	// heat ripple, light shafts, lens streaks, colour fringe
+	glUniform4f(glGetUniformLocation(p, "fxp"), d2web_tune(40, 4.0f), d2web_tune(41, 4.0f), d2web_tune(42, 2.5f), d2web_tune(43, 2.0f));
+	glUniform1f(glGetUniformLocation(p, "ftime"), f2fl(GameTime64 & 0xffffffff));
+}
+
+static void haze_uniforms(GLuint p)
+{
+	float pos[MAX_HAZE][4], col[MAX_HAZE][3], hp[3], hd[3];
+	int n = plight_haze_lights(pos, col, MAX_HAZE);
+	glUniform4f(glGetUniformLocation(p, "hazep"), d2web_tune(13, 0.06f), d2web_tune(14, 0.0025f), d2web_tune(15, 0.0015f), 0);
+	glUniform1i(glGetUniformLocation(p, "nhaze"), n);
+	if (n) {
+		glUniform4fv(glGetUniformLocation(p, "hpos"), n, pos[0]);
+		glUniform3fv(glGetUniformLocation(p, "hcol"), n, col[0]);
+	}
+	if (plight_headlight(hp, hd)) {
+		glUniform4f(glGetUniformLocation(p, "headpos"), hp[0], hp[1], hp[2], 1);
+		glUniform3f(glGetUniformLocation(p, "headdir"), hd[0], hd[1], hd[2]);
+	} else
+		glUniform4f(glGetUniformLocation(p, "headpos"), 0, 0, 0, 0);
+}
+
+// After the 3D view is drawn: process it and show it in its place on the screen.
+void ogl_post_end(void)
+{
+	int fxaa;
+	GLuint fin;
+
+	if (!P.active)
+		return;
+	P.active = 0;
+	if (P.samples) {
+		glBindFramebuffer(GL_READ_FRAMEBUFFER, P.ms_fbo);
+		glBindFramebuffer(GL_DRAW_FRAMEBUFFER, P.scene.fbo);
+		glBlitFramebuffer(0, 0, P.w, P.h, 0, 0, P.w, P.h, GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+	}
+	glDisable(GL_BLEND);
+	glDisable(GL_DEPTH_TEST);
+	glDisable(GL_CULL_FACE);
+	glDisable(GL_SCISSOR_TEST);
+
+	history_keep();
+	if (P.look & (LOOK_GLOW | LOOK_HAZE))	// haze takes its far glow from the bloom images
+		bloom();
+	if (P.look & LOOK_AO)
+		occlusion();
+
+	fxaa = !P.samples;
+	fin = final_program(P.look);
+	glUseProgram(fin);
+	glUniform4f(glGetUniformLocation(fin, "look"), d2web_tune(9, 0.65f), d2web_tune(10, 0.8f), d2web_tune(11, 0.26f), d2web_tune(12, 0.32f));
+	set_view(fin);
+	if (P.look & LOOK_GLOW)
+		blast_uniforms(fin);
+	if (P.look & LOOK_HAZE)
+		haze_uniforms(fin);
+	if (fxaa)
+		bind_target(&P.ldr);
+	else {
+		glBindFramebuffer(GL_FRAMEBUFFER, 0);
+		glViewport(P.x, P.y, P.w, P.h);
+	}
+	bind_texture(4, P.depth);
+	bind_texture(3, P.levels ? P.bloom[P.levels - 1].tex : 0);
+	bind_texture(2, P.ao[0].tex);
+	bind_texture(1, P.levels ? P.bloom[0].tex : 0);
+	bind_texture(0, P.scene.tex);
+	draw_quad();
+	if (fxaa) {
+		glUseProgram(P.fxaa);
+		glUniform2f(glGetUniformLocation(P.fxaa, "texel"), 1.0f / P.w, 1.0f / P.h);
+		glBindFramebuffer(GL_FRAMEBUFFER, 0);
+		glViewport(P.x, P.y, P.w, P.h);
+		bind_texture(0, P.ldr.tex);
+		draw_quad();
+	}
+
+	glUseProgram(0);
+	bind_texture(4, 0);
+	bind_texture(3, 0);
+	bind_texture(2, 0);
+	bind_texture(1, 0);
+	glActiveTexture(GL_TEXTURE0);
+	glEnable(GL_BLEND);
+	glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	glViewport(0, 0, grd_curscreen->sc_w, grd_curscreen->sc_h);
+	last_width = grd_curscreen->sc_w;
+	last_height = grd_curscreen->sc_h;
+}
diff --git a/d2/arch/ogl/ogl_shader.c b/d2/arch/ogl/ogl_shader.c
new file mode 100644
index 0000000..f8df115
--- /dev/null
+++ b/d2/arch/ogl/ogl_shader.c
@@ -0,0 +1,304 @@
+/*
+ * Shaders for 2D art drawn much larger than its pixels (browser edition). Movies get an
+ * edge-aware sharp upscale and HUD, menu and title art a sharp Catmull-Rom one, instead of a
+ * bilinear stretch; font glyphs keep their shapes with smooth edges at screen resolution
+ * instead of blurred or blocky pixels.
+ *
+ * The GL emulation runs these as user programs: it rewrites the legacy built-ins (gl_Vertex,
+ * gl_MultiTexCoord0, gl_Color, ftransform()) and keeps feeding the client arrays as usual.
+ */
+
+#define GL_GLEXT_PROTOTYPES
+#include <GL/gl.h>
+#include <GL/glext.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "ogl_init.h"
+#include "console.h"
+#ifdef __EMSCRIPTEN__
+#include "../web/web.h"
+#endif
+
+static const char *vs_src =
+	"void main() {\n"
+	"	gl_TexCoord[0] = gl_MultiTexCoord0;\n"
+	"	gl_FrontColor = gl_Color;\n"
+	"	gl_Position = ftransform();\n"
+	"}\n";
+
+// Catmull-Rom in nine bilinear taps (positions in texels), the result clamped to the four
+// nearest texels so edges stay sharp without halos. lim keeps taps inside the image (textures
+// are padded to a power of two, and HUD pieces can share one). Movies (MOVIE defined) also
+// blend Catmull-Rom samples along each edge, which smooths the staircase of their low-res
+// pixels, then sharpen. Transparent texels are black with alpha 0, so dividing by alpha keeps
+// dark fringes off the edges of cut-out art.
+static const char *upscale_fs_src =
+	"uniform sampler2D tex;\n"
+	"uniform vec2 size;\n"
+	"uniform vec4 lim;\n"
+	"vec4 at(vec2 t) { return texture2D(tex, clamp(t / size, lim.xy, lim.zw)); }\n"
+	"vec4 cr(vec2 p) {\n"
+	"	vec2 t1 = floor(p - 0.5) + 0.5;\n"
+	"	vec2 f = p - t1;\n"
+	"	vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));\n"
+	"	vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);\n"
+	"	vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));\n"
+	"	vec2 w3 = f * f * (-0.5 + 0.5 * f);\n"
+	"	vec2 w12 = w1 + w2;\n"
+	"	vec2 u0 = t1 - 1.0, u3 = t1 + 2.0, u12 = t1 + w2 / w12;\n"
+	"	return (at(vec2(u0.x, u0.y)) * w0.x + at(vec2(u12.x, u0.y)) * w12.x + at(vec2(u3.x, u0.y)) * w3.x) * w0.y\n"
+	"		+ (at(vec2(u0.x, u12.y)) * w0.x + at(vec2(u12.x, u12.y)) * w12.x + at(vec2(u3.x, u12.y)) * w3.x) * w12.y\n"
+	"		+ (at(vec2(u0.x, u3.y)) * w0.x + at(vec2(u12.x, u3.y)) * w12.x + at(vec2(u3.x, u3.y)) * w3.x) * w3.y;\n"
+	"}\n"
+	"float lum(vec4 c) { return dot(c.rgb, vec3(0.3, 0.59, 0.11)); }\n"
+	"void main() {\n"
+	"	vec2 p = gl_TexCoord[0].xy * size;\n"
+	"	vec4 c = cr(p);\n"
+	"#ifdef MOVIE\n"
+	"	vec2 g = vec2(lum(at(p + vec2(1.0, 0.0))) - lum(at(p - vec2(1.0, 0.0))),\n"
+	"		lum(at(p + vec2(0.0, 1.0))) - lum(at(p - vec2(0.0, 1.0))));\n"
+	"	float gm = length(g) + 1e-6;\n"
+	"	vec2 t = vec2(-g.y, g.x) / gm;\n"
+	"	vec4 along = (c * 0.4 + (cr(p - t * 0.75) + cr(p + t * 0.75)) * 0.3 + (cr(p - t * 1.5) + cr(p + t * 1.5)) * 0.15) / 1.3;\n"
+	"	c = mix(c, along, clamp(gm * 6.0, 0.0, 1.0));\n"
+	"	vec4 blur = (at(p + vec2(0.7, 0.7)) + at(p + vec2(-0.7, 0.7)) + at(p + vec2(0.7, -0.7)) + at(p + vec2(-0.7, -0.7))) * 0.25;\n"
+	"	c += (c - blur) * 0.6;\n"
+	"#endif\n"
+	"	vec2 n = floor(p - 0.5) + 0.5;\n"
+	"	vec4 a = at(n), b = at(n + vec2(1.0, 0.0)), d = at(n + vec2(0.0, 1.0)), e = at(n + 1.0);\n"
+	"	c = clamp(c, min(min(a, b), min(d, e)), max(max(a, b), max(d, e)));\n"
+	"	gl_FragColor = vec4(c.rgb / max(c.a, 0.004), c.a) * gl_Color;\n"
+	"}\n";
+
+// The 0.5 coverage edge of the bilinear-filtered glyph, antialiased over one screen pixel.
+// Transparent texels are black with alpha 0, so rgb / alpha is the glyph's own color.
+static const char *glyph_fs_src =
+	"uniform sampler2D tex;\n"
+	"uniform float soft;\n"
+	"void main() {\n"
+	"	vec4 c = texture2D(tex, gl_TexCoord[0].xy);\n"
+	"	float a = smoothstep(0.5 - soft, 0.5 + soft, c.a);\n"
+	"	gl_FragColor = vec4(c.rgb / max(c.a, 0.004), a) * gl_Color;\n"
+	"}\n";
+
+static GLuint compile(GLenum type, const char *defines, const char *src)
+{
+	GLint ok = 0;
+	GLuint s = glCreateShader(type);
+	const char *parts[2] = { defines, src };
+	glShaderSource(s, 2, parts, NULL);
+	glCompileShader(s);
+	glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		char log[512];
+		glGetShaderInfoLog(s, sizeof(log), NULL, log);
+		con_printf(CON_URGENT, "shader: %s\n", log);
+		glDeleteShader(s);
+		return 0;
+	}
+	return s;
+}
+
+static GLuint link(const char *defines, const char *fs_src)
+{
+	GLint ok = 0;
+	GLuint vs = compile(GL_VERTEX_SHADER, "", vs_src), fs = compile(GL_FRAGMENT_SHADER, defines, fs_src), p;
+	if (!vs || !fs)
+		return 0;
+	p = glCreateProgram();
+	glAttachShader(p, vs);
+	glAttachShader(p, fs);
+	glLinkProgram(p);
+	glGetProgramiv(p, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		char log[512];
+		glGetProgramInfoLog(p, sizeof(log), NULL, log);
+		con_printf(CON_URGENT, "shader link: %s\n", log);
+		glDeleteProgram(p);
+		return 0;
+	}
+	return p;
+}
+
+typedef struct upscale_shader {
+	GLuint prog;
+	GLint size, lim;
+} upscale_shader;
+static upscale_shader upscale[2];	// art, movies
+static GLuint glyph_prog, active;
+static GLint glyph_soft;
+static int tried;
+
+static void upscale_init(upscale_shader *u, const char *defines)
+{
+	if (!(u->prog = link(defines, upscale_fs_src)))
+		return;
+	glUseProgram(u->prog);
+	glUniform1i(glGetUniformLocation(u->prog, "tex"), 0);
+	u->size = glGetUniformLocation(u->prog, "size");
+	u->lim = glGetUniformLocation(u->prog, "lim");
+}
+
+static int ogl_shaders_ready(void)
+{
+	if (!tried) {
+		tried = 1;
+		upscale_init(&upscale[0], "");
+		upscale_init(&upscale[1], "#define MOVIE 1\n");
+		if ((glyph_prog = link("", glyph_fs_src))) {
+			glUseProgram(glyph_prog);
+			glUniform1i(glGetUniformLocation(glyph_prog, "tex"), 0);
+			glyph_soft = glGetUniformLocation(glyph_prog, "soft");
+		}
+		glUseProgram(0);
+	}
+	return upscale[0].prog && upscale[1].prog && glyph_prog;
+}
+
+// A WebGL 2 program from GLSL ES 3.00 sources (without #version, which is added), handed to
+// WebGL unchanged. Inputs and matrices use the GL emulation's names (a_position, a_texCoord0,
+// a_color, a_normal, u_modelView, u_projection), so it feeds them from the usual client arrays.
+GLuint ogl_program3(const char *vs_body, const char *defines, const char *fs_body)
+{
+#ifdef __EMSCRIPTEN__
+	const char *bodies[2] = { vs_body, fs_body };
+	GLuint s[2], p;
+	GLint ok = 0;
+	int i;
+	for (i = 0; i < 2; i++) {
+		const char *head = i ? "#version 300 es\nprecision highp float;\nprecision highp int;\n" : "#version 300 es\nprecision highp float;\n";
+		size_t n = strlen(head) + strlen(defines) + strlen(bodies[i]) + 1;
+		char *src = malloc(n);
+		snprintf(src, n, "%s%s%s", head, defines, bodies[i]);
+		s[i] = glCreateShader(i ? GL_FRAGMENT_SHADER : GL_VERTEX_SHADER);
+		d2web_shader_source(s[i], src);
+		free(src);
+		glCompileShader(s[i]);
+		glGetShaderiv(s[i], GL_COMPILE_STATUS, &ok);
+		if (!ok) {
+			char log[1024];
+			glGetShaderInfoLog(s[i], sizeof(log), NULL, log);
+			con_printf(CON_URGENT, "shader: %s\n", log);
+			return 0;
+		}
+	}
+	p = glCreateProgram();
+	glAttachShader(p, s[0]);
+	glAttachShader(p, s[1]);
+	glLinkProgram(p);
+	glGetProgramiv(p, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		char log[1024];
+		glGetProgramInfoLog(p, sizeof(log), NULL, log);
+		con_printf(CON_URGENT, "shader link: %s\n", log);
+		return 0;
+	}
+	return p;
+#else
+	return 0;
+#endif
+}
+
+// Sprites that give light (explosions, glowing shots): their cut-out edges and the sprite's
+// square border fade softly instead of ending in blocky pixels, and with the HDR view they are
+// brighter than white so they glow. Additive sprites keep their colors premultiplied.
+static const char *sprite_vs =
+	"in vec4 a_position;\n"
+	"in vec4 a_texCoord0;\n"
+	"in vec4 a_color;\n"
+	"uniform mat4 u_modelView;\n"
+	"uniform mat4 u_projection;\n"
+	"out vec2 v_uv;\n"
+	"out vec4 v_color;\n"
+	"void main() {\n"
+	"	v_uv = a_texCoord0.xy;\n"
+	"	v_color = a_color;\n"
+	"	gl_Position = u_projection * u_modelView * a_position;\n"
+	"}\n";
+
+static const char *sprite_fs =
+	"uniform sampler2D tex;\n"
+	"uniform vec4 sp;\n"	// brightness, texture u and v extent, additive
+	"uniform vec2 texel;\n"
+	"in vec2 v_uv;\n"
+	"in vec4 v_color;\n"
+	"out vec4 o;\n"
+	"void main() {\n"
+	// the cut-out mask blurred over a texel and cut again: round outlines, not the
+	// staircase of the magnified pixels (transparent texels are black, so colors stay true)
+	"	vec2 t = texel * 0.8;\n"
+	"	vec4 c = (texture(tex, v_uv) * 2.0 + texture(tex, v_uv + t) + texture(tex, v_uv - t)\n"
+	"		+ texture(tex, v_uv + vec2(t.x, -t.y)) + texture(tex, v_uv + vec2(-t.x, t.y))) / 6.0;\n"
+	"	vec2 q = v_uv / sp.yz;\n"
+	"	float edge = smoothstep(0.0, 0.14, min(min(q.x, 1.0 - q.x), min(q.y, 1.0 - q.y)));\n"
+	"	float a = smoothstep(0.18, 0.62, c.a) * edge * v_color.a;\n"
+	"	if (a < 0.004) discard;\n"
+	"	vec3 rgb = c.rgb / max(c.a, 0.004) * v_color.rgb * sp.x;\n"
+	"	o = sp.w > 0.5 ? vec4(rgb * a, a) : vec4(rgb, a);\n"
+	"}\n";
+
+static GLuint sprite_prog;
+static GLint sprite_sp, sprite_texel;
+
+int ogl_sprite_begin(ogl_texture *tex, float brightness, int additive)
+{
+	static int tried;
+	if (!tried) {
+		tried = 1;
+#ifdef __EMSCRIPTEN__
+		if (d2web_gl_version() >= 2 && (sprite_prog = ogl_program3(sprite_vs, "", sprite_fs))) {
+			glUseProgram(sprite_prog);
+			glUniform1i(glGetUniformLocation(sprite_prog, "tex"), 0);
+			sprite_sp = glGetUniformLocation(sprite_prog, "sp");
+			sprite_texel = glGetUniformLocation(sprite_prog, "texel");
+			glUseProgram(0);
+		}
+#endif
+	}
+	if (!sprite_prog || active || !tex->u || !tex->v)
+		return 0;
+	glUseProgram(active = sprite_prog);
+	glUniform4f(sprite_sp, brightness, tex->u, tex->v, additive ? 1 : 0);
+	glUniform2f(sprite_texel, 1.0f / tex->tw, 1.0f / tex->th);
+	return 1;
+}
+
+int ogl_sharp_enabled(void)
+{
+#ifdef __EMSCRIPTEN__
+	return d2web_option(D2WEB_OPTION_SHARP) && ogl_shaders_ready();
+#else
+	return 0;
+#endif
+}
+
+#define MIN_SCALE 1.25f
+
+// For the part u1,v1 - u2,v2 of a texture drawn magnified (scale = screen pixels per texel).
+// Not while glyphs are drawn: they have their own shader.
+int ogl_upscale_begin(ogl_texture *tex, float u1, float v1, float u2, float v2, float scale, int movie)
+{
+	upscale_shader *u = &upscale[movie ? 1 : 0];
+	if (scale < MIN_SCALE || active || !tex->tw || !tex->th || !ogl_sharp_enabled())
+		return 0;
+	glUseProgram(active = u->prog);
+	glUniform2f(u->size, tex->tw, tex->th);
+	glUniform4f(u->lim, u1 + 0.5f / tex->tw, v1 + 0.5f / tex->th, u2 - 0.5f / tex->tw, v2 - 0.5f / tex->th);
+	return 1;
+}
+
+// scale = screen pixels per glyph texel
+int ogl_glyph_begin(float scale)
+{
+	if (scale < MIN_SCALE || !ogl_sharp_enabled())
+		return 0;
+	glUseProgram(active = glyph_prog);
+	glUniform1f(glyph_soft, 0.5f / scale);
+	return 1;
+}
+
+void ogl_shader_end(void)
+{
+	glUseProgram(active = 0);
+}
