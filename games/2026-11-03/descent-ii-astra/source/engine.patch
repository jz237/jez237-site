+static void astra_impact_sound(object *o)
+{
+    static fix64 last=-F1_0;int kind=astra_effect_type(o);
+    if(kind<0 || !Viewer || o->size<F1_0/2)return;
+    fix64 now=GameTime64;
+    if(now>=last && now-last<(o->size>i2f(6)?F1_0/32:F1_0/13))return;
+    /* Accent the original shot with a separately positioned Descent II sample. */
+    const int sounds[8][3]={
+        {SOUND_ROBOT_DESTROYED,SOUND_LASER_HIT_CLUTTER,SOUND_WEAPON_HIT_BLASTABLE},
+        {SOUND_FORCEFIELD_BOUNCE_WEAPON,SOUND_ROBOT_HIT,SOUND_WEAPON_HIT_DOOR},
+        {SOUND_WEAPON_HIT_DOOR,SOUND_LASER_HIT_CLUTTER,SOUND_ROBOT_HIT},
+        {SOUND_BADASS_EXPLOSION,SOUND_ROBOT_DESTROYED,SOUND_MINE_BLEW_UP},
+        {SOUND_FORCEFIELD_BOUNCE_WEAPON,SOUND_PLAYER_GOT_HIT,SOUND_ROBOT_HIT},
+        {SOUND_ROBOT_HIT,SOUND_LASER_HIT_CLUTTER,SOUND_BADASS_EXPLOSION},
+        {SOUND_MINE_BLEW_UP,SOUND_ROBOT_DESTROYED,SOUND_BADASS_EXPLOSION},
+        {SOUND_PLAYER_GOT_HIT,SOUND_FORCEFIELD_BOUNCE_WEAPON,SOUND_BADASS_EXPLOSION}};
+    unsigned seed=astra_effect_seed(o);
+    int sample=sounds[kind][(seed>>8)%3];
+    if(digi_xlat_sound(sample)<0)return;
+    int volume,pan;
+    extern void digi_get_sound_loc(vms_matrix*,vms_vector*,int,vms_vector*,int,fix,int*,int*,fix);
+    digi_get_sound_loc(&Viewer->orient,&Viewer->pos,Viewer->segnum,&o->pos,o->segnum,
+        F1_0/3+(seed%8192)+(o->size>i2f(6)?F1_0/5:0),&volume,&pan,i2f(105));
+    if(volume<=0)return;
+    last=now;
+    digi_play_sample_3d(sample,pan,volume,0);
+    EM_ASM(Module.blastSounds=(Module.blastSounds||0)+1;Module.blastSoundMask=(Module.blastSoundMask||0)|(1<<($0%31));,sample);
+}
