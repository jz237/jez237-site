+static unsigned death_hash(unsigned x){x^=x>>16;x*=0x7feb352du;x^=x>>15;x*=0x846ca68bu;return x^(x>>16);}
+static void astra_track_plume(object *o,int tier,fix elapsed)
+{
+    int kind=astra_effect_type(o);if(kind<0)return;
+    int index=(int)(o-Objects);
+    if(pyro_known[index] && pyro_registered[index]==o->signature)return;
+    pyro_known[index]=1;pyro_registered[index]=o->signature;
+    unsigned key=astra_effect_seed(o);int free_slot=-1,victim=-1;
+    for(int i=0;i<ASTRA_PLUMES;i++){
+        astra_event *e=pyro_events+i;
+        /* D2 creates a second damage-free clip at the exact point and tick
+         * of hull breakup. Represent the pair with the dedicated ship event. */
+        if(e->tier==2 && e->born==GameTime64 && tier<2 && e->room==o->segnum &&
+           o->pos.x==e->pos.x && o->pos.y==e->pos.y && o->pos.z==e->pos.z)return;
+        if(!pyro_alive(e)){if(free_slot<0)free_slot=i;continue;}
+        if(e->tier<=tier && (victim<0 || e->tier<pyro_events[victim].tier ||
+            (e->tier==pyro_events[victim].tier && e->born<pyro_events[victim].born)))victim=i;
+    }
+    int slot=free_slot>=0?free_slot:victim;if(slot<0)return;
+    unsigned seed=key;
+    if(tier==2){
+        if(!death_salt)death_salt=(unsigned)EM_ASM_INT({var a=new Uint32Array(1);globalThis.crypto.getRandomValues(a);return a[0]|0;})|1u;
+        seed=death_hash(key^death_salt^(++death_serial*2654435761u));
+    }
+    float jitter=(seed&255)/255.f;
+    float seconds=tier==2?5.9f+1.1f*jitter:tier==1?2.40f+.23f*jitter:.50f+.32f*jitter;
+    int profile=astra_choose_pattern(tier,seed);
+    if(profile)seconds=astra_pattern_length(profile,seed);
+    else if(tier==1&&((seed>>8)%5)>=3)seconds=2.0f+.25f*jitter;
+    /* Routine hits on our hull clear promptly, before they hide the next
+     * attacker. Distant deaths and the player's own breakup keep their scale. */
+    int closeImpact=tier<2 && !Player_is_dead && ConsoleObject &&
+        vm_vec_dist(&ConsoleObject->pos,&o->pos)<ConsoleObject->size*3;
+    if(closeImpact)seconds=tier==1?.46f+.18f*jitter:.20f+.12f*jitter;
+    if(elapsed>=fl2f(seconds))return;
+    fix radius=o->size;
+    if(tier==2){
+        radius=fixmul(radius,fl2f(1.96f+.20f*jitter));
+        if(Viewer && Viewer!=ConsoleObject){
+            /* Frame the complete breakup at ignition even in a tight shaft.
+             * The resulting size is fixed in world space for its whole life. */
+            fix room_for_camera=fixmul(vm_vec_dist(&Viewer->pos,&o->pos),fl2f(.36f));
+            if(room_for_camera>F1_0 && radius>room_for_camera)radius=room_for_camera;
+        }
+    }
+    if(profile)radius=fixmul(radius,fl2f(astra_detonations[profile].scale));
+    else if(tier==1&&((seed>>8)%5)>=3)radius=fixmul(radius,fl2f(.62f));
+    if(tier==0)radius=fixmul(radius,fl2f(.79f));
+    if(closeImpact)radius=fixmul(radius,fl2f(.62f));
+    pyro_events[slot]=(astra_event){o->pos,radius,GameTime64-elapsed,fl2f(seconds),seed,kind,tier,o->segnum,0,closeImpact,profile};
+}
+static int astra_owns_plume(object *o)
+{
+    if(astra_effect_type(o)<0 || !astra_pyro_ready())return 0;
+    /* Recordings and old saves can contain a fireball that was never spawned
+     * in this session. Reconstruct its age from the original clip. */
+    astra_track_plume(o,o->size>=i2f(5),Vclip[o->id].play_time-o->lifeleft);
+    return 1;
+}
+void astra_render_plumes(const short *rooms,int room_count,int window_num)
+{
+    int order[ASTRA_PLUMES],n=0;fix depth[ASTRA_PLUMES];
+    for(int i=0;i<ASTRA_PLUMES;i++){
+        astra_event *e=pyro_events+i;if(!pyro_alive(e))continue;
+        int room=0;while(room<room_count && rooms[room]!=e->room)room++;
+        if(room==room_count)continue;
+        g3s_point p;g3_rotate_point(&p,&e->pos);int j=n;
+        while(j>0 && depth[j-1]<p.p3_z){order[j]=order[j-1];depth[j]=depth[j-1];j--;}
+        order[j]=i;depth[j]=p.p3_z;n++;
+    }
+    for(int i=0;i<n;i++){
+        astra_event *e=&pyro_events[order[i]];float seconds=f2fl((fix)(GameTime64-e->born));
+        float progress=seconds/f2fl(e->length);
+        if(e->profile)astra_pattern_blast(&e->pos,e->radius,progress,e->seed,e->profile,e->tier);
+        else astra_blast(&e->pos,e->radius,progress,e->seed,e->kind,e->tier);
+        extern void astra_debris(vms_vector*,fix,float,float,unsigned,int,int,int);
+        astra_debris(&e->pos,e->radius,seconds,f2fl(e->length),e->seed,e->tier,e->room,window_num);
+        if(!window_num)EM_ASM({if(Module.traceAstraBlast)Module.traceAstraBlast($0,$1>>>0,$2,$3,$4,$5);},e->tier,e->seed,seconds,f2fl(e->length),f2fl(depth[i]),e->kind);
+    }
+}
+float astra_death_burst_time(unsigned seed,int i)
+{return .17f+i*.105f+((death_hash(seed+i*197u)>>16)/65535.f)*.047f;}
+static float pyro_chain_heat(float t,float onset)
+{float u=(t-onset)/.34f;return u<=0||u>=1?0:sinf(u*3.14159265f)*(1-u);}
+#include "astra_death_chain.inc"
+void astra_burst_audio(void)
+{
+    for(int i=0;i<ASTRA_PLUMES;i++){
+        astra_event *e=pyro_events+i;if(e->tier!=2||!pyro_alive(e)||!Viewer)continue;
+        astra_death_chain(e->seed,(float)(GameTime64-e->born)/e->length,&e->nextSound,0,e->room,&e->pos);
+    }
+}
+void astra_plume_lights(int room,const vms_vector *center,float rank[3],float pos[3][4],float colors[3][4])
+{
+    for(int i=0;i<ASTRA_PLUMES;i++){
+        const astra_event *e=pyro_events+i;
+        if(e->room!=room || !pyro_alive(e))continue;
+        float t=(float)(GameTime64-e->born)/e->length,r=f2fl(e->radius);
+        float glow=.65f*expf(-t*18)+1.35f*(1-expf(-t*11))*(1-t)*(1-t);
+        if(e->tier==2)for(int j=0;j<4;j++)glow+=.67f*pyro_chain_heat(t,astra_death_burst_time(e->seed,j));
+        if(e->profile)glow=astra_pattern_light(e->profile,t);
+        float reach=fminf(85,7+r*5.1f),power=glow*(.70f+fminf(1.8f,r*.125f));
+        if(e->closeImpact){power*=.38f;reach*=.68f;}
+        float dist=f2fl(vm_vec_dist_quick(center,&e->pos)),weight=power/(1+dist*dist/(reach*reach));
+        int k=0;for(int n=1;n<3;n++)if(rank[n]<rank[k])k=n;
+        if(weight<=rank[k])continue;
+        rank[k]=weight;pos[k][0]=f2fl(e->pos.x);pos[k][1]=f2fl(e->pos.y);pos[k][2]=f2fl(e->pos.z);pos[k][3]=reach;
+        int palette=e->profile?astra_detonations[e->profile].palette:e->kind;
+        const float *original=astra_effect_color(palette);
+        float accent=e->profile?.84f:(e->tier?.035f:.30f);
+        const float fire[]={1.f,.28f+.32f*(1-t),.046f+.12f*expf(-t*9)};
+        for(int a=0;a<3;a++)colors[k][a]=power*(fire[a]*(1-accent)+original[a]*accent);
+        colors[k][3]=1;
+    }
+}
