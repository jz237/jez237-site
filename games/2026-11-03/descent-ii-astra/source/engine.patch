+    int volume,pan;
+    extern void digi_get_sound_loc(vms_matrix*,vms_vector*,int,vms_vector*,int,fix,int*,int*,fix);
+    digi_get_sound_loc(&Viewer->orient,&Viewer->pos,Viewer->segnum,&o->pos,o->segnum,
+        F1_0/3+(seed%8192)+(o->size>i2f(6)?F1_0/5:0),&volume,&pan,i2f(105));
