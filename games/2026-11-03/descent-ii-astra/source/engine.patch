+static int astra_fire_clip(int id, const char *name)
+{
+    if(id==VCLIP_SMALL_EXPLOSION || id==VCLIP_VOLATILE_WALL_HIT || (name && !strncmp(name,"exp",3)))return 1;
+    if(id==VCLIP_WATER_HIT || id==VCLIP_AFTERBURNER_BLOB || id==VCLIP_POWERUP_DISAPPEARANCE ||
+       id==VCLIP_PLAYER_APPEARANCE || id==VCLIP_MORPHING_ROBOT)return 0;
+    for(int i=0;i<N_weapon_types;i++)if(id==Weapon_info[i].wall_hit_vclip || id==Weapon_info[i].robot_hit_vclip)return 1;
+    for(int i=0;i<N_robot_types;i++)
+        if(id==Robot_info[i].exp2_vclip_num)return 1;
+    return 0;
+}
+/* Derived only from immutable object data. Visual and audio choices never touch the gameplay RNG. */
+unsigned astra_effect_seed(const object *o)
+{
+    unsigned h=(unsigned)o->signature*747796405u+(unsigned)o->id*2891336453u;
+    h=((h>>((h>>28)+4))^h)*277803737u;
+    return (h>>22)^h;
+}
+int astra_effect_type(object *o)
+{
+    static int enabled=-1;
+    if(enabled<0)enabled=EM_ASM_INT(return !!Module.astra);
+    if(!enabled || o->type!=OBJ_FIREBALL || o->id>=Num_vclips || Vclip[o->id].play_time<=0)return -1;
+    const char *name=piggy_game_bitmap_name(&GameBitmaps[Vclip[o->id].frames[0].index]);
+    if(!astra_fire_clip(o->id,name))return -1;
+    unsigned h=astra_effect_seed(o);
+    static const unsigned char small[]={0,1,2,3,4,5,1,2},heavy[]={3,4,5,6,7,0,6,7};
+    return (o->size>=i2f(6)?heavy:small)[h&7];
+}
+const float *astra_effect_color(int type)
+{
+    static const float rgb[][3]={{1,.42f,.08f},{.18f,.72f,1},{1,.62f,.15f},{1,.20f,.055f},
+        {.58f,.38f,1},{1,.77f,.29f},{1,.32f,.10f},{.26f,.92f,.82f}};
+    return rgb[type];
+}
+/* Presentation-only events outlive their original Descent damage objects.
+ * SFX, damage, robot drops, respawn input and the death camera stay in D2. */
+#include "astra_detonations.h"
+enum { ASTRA_PLUMES=32 };
+typedef struct {vms_vector pos;fix radius;fix64 born;fix length;unsigned seed;int kind,tier,room,nextSound,closeImpact,profile;} astra_event;
+static astra_event pyro_events[ASTRA_PLUMES];
+static unsigned death_salt,death_serial;
+static int pyro_registered[MAX_OBJECTS];static unsigned char pyro_known[MAX_OBJECTS];
+extern int astra_pyro_ready(void);
+extern void astra_blast(vms_vector*,fix,float,unsigned,int,int);
+extern void astra_pattern_blast(vms_vector*,fix,float,unsigned,int,int);
+extern void astra_debris_clear(void);
+void astra_clear_plumes(void){astra_debris_clear();memset(pyro_events,0,sizeof(pyro_events));memset(pyro_known,0,sizeof(pyro_known));}
