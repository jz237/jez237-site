+/* Derived only from immutable object data. Visual and audio choices never touch the gameplay RNG. */
+unsigned astra_effect_seed(const object *o)
+{
+    unsigned h=(unsigned)o->signature*747796405u+(unsigned)o->id*2891336453u;
+    h=((h>>((h>>28)+4))^h)*277803737u;
