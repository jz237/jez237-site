{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steel-duel-online",
  "main": "src/index.js",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "SteelDuelRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "SteelDuelLobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SteelDuelRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SteelDuelLobby"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
