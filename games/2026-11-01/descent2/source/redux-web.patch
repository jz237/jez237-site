+// D2X-XL texture packs store an animation as one vertical strip of frames in name#0.png
+// (frame k in row k). Reads the replacement for one frame: name#k.png, or row k of the strip.
+static int read_texture_png(const char *bitmapname, png_data *pdata)
+{
+	static char strip_name[64];
