+// the bitmap's palette indices, RLE decoded (into decodebuf)
+static unsigned char *ogl_bitmap_indices(grs_bitmap *bm)
+{
+	unsigned char *sbits, *dbits;
+	int i, data_offset = bm->bm_flags & BM_FLAG_RLE_BIG ? 2 : 1;
+
+	if (!(bm->bm_flags & BM_FLAG_RLE))
+		return bm->bm_data;
+	sbits = &bm->bm_data[4 + (bm->bm_h * data_offset)];
+	dbits = decodebuf;
+	for (i = 0; i < bm->bm_h; i++) {
+		gr_rle_decode(sbits, dbits);
+		if (bm->bm_flags & BM_FLAG_RLE_BIG)
+			sbits += (int)INTEL_SHORT(*((short *)&(bm->bm_data[4 + (i * data_offset)])));
+		else
+			sbits += (int)bm->bm_data[4 + i];
+		dbits += bm->bm_w;
+	}
+	return decodebuf;
+}
+
+// Scales an RGBA image's colors so its average matches the game bitmap it replaces, as the
+// current palette shows that bitmap (orig: its palette indices).
+static void ogl_match_colors(grs_bitmap *bm, const unsigned char *orig, unsigned char *rgba, int n)
+{
+	double osum[3] = { 0, 0, 0 }, psum[3] = { 0, 0, 0 }, gain[3];
+	int on = 0, pn = 0, i, k;
+
+	for (i = 0; i < bm->bm_w * bm->bm_h; i++)
+		if (orig[i] < 254) {
+			for (k = 0; k < 3; k++)
+				osum[k] += ogl_pal[orig[i] * 3 + k] * 4;
+			on++;
+		}
+	for (i = 0; i < n; i++)
+		if (rgba[i * 4 + 3] >= 128) {
+			for (k = 0; k < 3; k++)
+				psum[k] += rgba[i * 4 + k];
+			pn++;
+		}
+	if (!on || !pn)
+		return;
+	for (k = 0; k < 3; k++) {
+		gain[k] = psum[k] > 0 ? (osum[k] / on) / (psum[k] / pn) : 1;
+		gain[k] = gain[k] < 0.5 ? 0.5 : gain[k] > 3 ? 3 : gain[k];
+	}
+	if (fabs(gain[0] - 1) < 0.03 && fabs(gain[1] - 1) < 0.03 && fabs(gain[2] - 1) < 0.03)
+		return;
+	for (i = 0; i < n; i++)
+		for (k = 0; k < 3; k++) {
+			double v = rgba[i * 4 + k] * gain[k];
+			rgba[i * 4 + k] = v > 255 ? 255 : (unsigned char)v;
+		}
+}
+
+// The bitmap's average color (0..1) as the current palette shows it (xmodel.cpp).
+void ogl_bitmap_average(grs_bitmap *bm, float *rgb)
+{
+	const unsigned char *orig;
+	double sum[3] = { 0, 0, 0 };
+	int n = 0, i, k;
+
+	rgb[0] = rgb[1] = rgb[2] = 0;
+	if (!bm || !bm->bm_data || !bm->bm_w || !bm->bm_h)
+		return;
+	orig = ogl_bitmap_indices(bm);
+	for (i = 0; i < bm->bm_w * bm->bm_h; i++)
+		if (orig[i] < 254) {
+			for (k = 0; k < 3; k++)
+				sum[k] += ogl_pal[orig[i] * 3 + k];
+			n++;
+		}
+	if (n)
+		for (k = 0; k < 3; k++)
+			rgb[k] = sum[k] / n / 63;
+}
+
+// For replacements of model textures (xmodel.cpp): match the game bitmap's colors.
+void ogl_match_bitmap_colors(grs_bitmap *bm, unsigned char *rgba, int w, int h)
+{
+	if (bm && bm->bm_data && bm->bm_w && bm->bm_h)
+		ogl_match_colors(bm, ogl_bitmap_indices(bm), rgba, w * h);
+}
+
+#ifdef HAVE_LIBPNG
+// Fits a replacement texture to the game bitmap it stands for. The hi-res packs were made
+// from one palette, often come out darker, and some lack the transparency the game needs
+// (muzzle flashes on black, say). So the copy takes the original's transparency where the
+// image has none, and the original's average color as this level's palette shows it.
+// Returns a new RGBA buffer.
+static unsigned char *ogl_fit_png(grs_bitmap *bm, png_data *pdata)
+{
+	int w = pdata->width, h = pdata->height, n = w * h, bpp = pdata->paletted ? 1 : pdata->channels, i;
+	unsigned char *rgba = malloc(n * 4), *orig = bm->bm_data ? ogl_bitmap_indices(bm) : NULL;
+	int alpha = pdata->alpha && !pdata->paletted && bpp == 4;
+
+	for (i = 0; i < n; i++) {
+		const unsigned char *s = pdata->paletted ? pdata->palette + pdata->data[i] * 3 : pdata->data + i * bpp;
+		unsigned char *d = rgba + i * 4;
+		d[0] = s[0];
+		d[1] = s[1];
+		d[2] = s[2];
+		d[3] = alpha ? s[3] : 255;
+		if (orig && !alpha) {
+			int c = orig[(i / w * bm->bm_h / h) * bm->bm_w + (i % w) * bm->bm_w / w];
+			if ((c == 255 && (bm->bm_flags & BM_FLAG_TRANSPARENT)) || (c == 254 && (bm->bm_flags & BM_FLAG_SUPER_TRANSPARENT)))
+				d[3] = 0;
+		}
+		if (d[0] == 120 && d[1] == 88 && d[2] == 128)	// D2X-XL's super transparency color
+			d[3] = 0;
+	}
+	if (orig)
+		ogl_match_colors(bm, orig, rgba, n);
+	return rgba;
+}
+
+// D2X-XL texture packs store an animation as one vertical strip of frames in name#0.png
+// (frame k in row k). Reads the replacement for one frame: name#k.png, or row k of the strip.
+static int read_texture_png(const char *bitmapname, png_data *pdata)
+{
+	static char strip_name[64];
+	static png_data strip;	// the last strip read, kept since its frames load one after another
+	const char *hash = strchr(bitmapname, '#');
+	int frame = hash ? atoi(hash + 1) : 0, bpp, size;
+	char filename[64];
+
+	snprintf(filename, sizeof(filename), "%s.png", bitmapname);
+	if (read_png(filename, pdata)) {
+		if (!hash || pdata->height <= pdata->width || pdata->height % pdata->width)
+			return 1;
+		frame = 0;	// a frame 0 file that holds the whole strip
+	} else {
+		if (!hash)
+			return 0;
+		snprintf(filename, sizeof(filename), "%.*s#0.png", (int)(hash - bitmapname), bitmapname);
+		if (strcmp(filename, strip_name)) {
+			if (strip.data)
+				free(strip.data);
+			if (strip.palette)
+				free(strip.palette);
+			strip.data = strip.palette = NULL;
+			strip_name[0] = 0;
+			if (!read_png(filename, &strip))
+				return 0;
+			strcpy(strip_name, filename);
+		}
+		if (strip.height <= strip.width || strip.height % strip.width)
+			return 0;
+		*pdata = strip;
+		if (strip.palette) {
+			pdata->palette = malloc(strip.num_palette * 3);
+			memcpy(pdata->palette, strip.palette, strip.num_palette * 3);
+		}
+		pdata->data = NULL;
+	}
+	bpp = pdata->paletted ? 1 : pdata->channels;
+	size = pdata->width * pdata->width * bpp;
+	frame %= pdata->height / pdata->width;
+	unsigned char *data = malloc(size);
+	memcpy(data, (pdata->data ? pdata->data : strip.data) + frame * size, size);
+	if (pdata->data)
+		free(pdata->data);
+	pdata->data = data;
+	pdata->height = pdata->width;
+	return 1;
+}
