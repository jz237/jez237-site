+// How bright a model looks: its surface's average luminance per unit area, textured faces at
+// a typical light, flat ones unlit as the game draws its flat polygons.
+#define TYPICAL_LIGHT 0.75f
+static float luminance(const float *c) { return 0.3f * c[0] + 0.59f * c[1] + 0.11f * c[2]; }
+static float flat_rgb(short c, float *rgb) {
+	rgb[0] = ((c >> 10) & 31) / 31.0f;
+	rgb[1] = ((c >> 5) & 31) / 31.0f;
+	rgb[2] = (c & 31) / 31.0f;
+	return luminance(rgb);
+}
+
+static double polygon_area(const vms_vector *pts, const unsigned short *idx, int nv) {
+	double a = 0;
+	for (int i = 2; i < nv; i++) {
+		const vms_vector *p0 = &pts[idx[0]], *p1 = &pts[idx[i - 1]], *p2 = &pts[idx[i]];
+		double ux = f2fl(p1->x - p0->x), uy = f2fl(p1->y - p0->y), uz = f2fl(p1->z - p0->z);
+		double vx = f2fl(p2->x - p0->x), vy = f2fl(p2->y - p0->y), vz = f2fl(p2->z - p0->z);
+		double cx = uy * vz - uz * vy, cy = uz * vx - ux * vz, cz = ux * vy - uy * vx;
+		a += sqrt(cx * cx + cy * cy + cz * cz) / 2;
+	}
+	return a;
+}
