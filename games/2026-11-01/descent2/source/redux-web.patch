new file mode 100644
index 0000000..e6a9c5e
--- /dev/null
+++ b/d2/arch/web/web.c
@@ -0,0 +1,196 @@
+/*
+ * Browser (Emscripten) replacements for desktop-only pieces:
+ * message boxes, GLU mipmapping and GL 1.1 calls WebGL lacks.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <emscripten.h>
+#include <SDL.h>
+#include "ogl_init.h"
+#include "messagebox.h"
+#include "hmp.h"
+#include "u_mem.h"
+#include "web.h"
+
+EM_JS(void, d2web_show_message, (const char *msg, int is_error), {
+	const text = UTF8ToString(msg);
+	if (is_error) console.error(text); else console.warn(text);
+	if (Module.onGameMessage) Module.onGameMessage(text, !!is_error);
+});
+
+void msgbox_warning(char *message)
+{
+	d2web_show_message(message, 0);
+}
+
+void msgbox_error(const char *message)
+{
+	d2web_show_message(message, 1);
+}
+
+int d2web_play_hmp(const char *filename, int loop)
+{
+	unsigned char *mid = NULL;
+	unsigned int len = 0;
+	int ok;
+
+	hmp2mid((char *)filename, &mid, &len);
+	if (!mid)
+		return 0;
+	ok = len ? d2web_midi_play(mid, len, loop) : 0;
+	d_free(mid);
+	return ok;
+}
+
+static int is_pow2(int v)
+{
+	return v > 0 && (v & (v - 1)) == 0;
+}
+
+GLint gluBuild2DMipmaps(GLenum target, GLint internalFormat, GLsizei width, GLsizei height,
+	GLenum format, GLenum type, const void *data)
+{
+	// WebGL wants the internal format to match the upload format
+	glTexImage2D(target, 0, format, width, height, 0, format, type, data);
+	if (is_pow2(width) && is_pow2(height))
+		glGenerateMipmap(target);
+	return 0;
+}
+
+void glPrioritizeTextures(GLsizei n, const GLuint *textures, const GLclampf *priorities)
+{
+}
+
+// WebGL always reads back from the buffer being drawn, which is what the game asks for
+void glReadBuffer(GLenum mode)
+{
+}
+
+/*
+ * Emscripten's JS SDL leaves SDL_AllocRW unimplemented and its own RWops can't be
+ * read through the function pointers SDL_RWread uses, so provide real ones in C.
+ */
+SDL_RWops *SDL_AllocRW(void)
+{
+	return calloc(1, sizeof(SDL_RWops));
+}
+
+void SDL_FreeRW(SDL_RWops *area)
+{
+	free(area);
+}
+
+static long mem_seek(SDL_RWops *rw, long offset, int whence)
+{
+	Uint8 *p;
+
+	switch (whence)
+	{
+		case RW_SEEK_SET: p = rw->hidden.mem.base + offset; break;
+		case RW_SEEK_CUR: p = rw->hidden.mem.here + offset; break;
+		case RW_SEEK_END: p = rw->hidden.mem.stop + offset; break;
+		default: return -1;
+	}
+	if (p < rw->hidden.mem.base)
+		p = rw->hidden.mem.base;
+	if (p > rw->hidden.mem.stop)
+		p = rw->hidden.mem.stop;
+	rw->hidden.mem.here = p;
+	return (long)(p - rw->hidden.mem.base);
+}
+
+static size_t mem_read(SDL_RWops *rw, void *ptr, size_t size, size_t maxnum)
+{
+	size_t avail, n;
+
+	if (!size)
+		return 0;
+	avail = (size_t)(rw->hidden.mem.stop - rw->hidden.mem.here);
+	n = maxnum;
+	if (n * size > avail)
+		n = avail / size;
+	memcpy(ptr, rw->hidden.mem.here, n * size);
+	rw->hidden.mem.here += n * size;
+	return n;
+}
+
+static size_t mem_nowrite(SDL_RWops *rw, const void *ptr, size_t size, size_t num)
+{
+	return 0;
+}
+
+static int mem_close(SDL_RWops *rw)
+{
+	SDL_FreeRW(rw);
+	return 0;
+}
+
+SDL_RWops *SDL_RWFromConstMem(const void *mem, int size)
+{
+	SDL_RWops *rw = SDL_AllocRW();
+
+	if (!rw)
+		return NULL;
+	rw->seek = mem_seek;
+	rw->read = mem_read;
+	rw->write = mem_nowrite;
+	rw->close = mem_close;
+	rw->hidden.mem.base = (Uint8 *)mem;
+	rw->hidden.mem.here = rw->hidden.mem.base;
+	rw->hidden.mem.stop = rw->hidden.mem.base + size;
+	return rw;
+}
+
+/* Test tools for the page (never called in normal play). */
+#include "object.h"
+#include "robot.h"
+#include "gameseg.h"
+#include "fuelcen.h"
+#include "ai.h"
+
+/* Puts robot type id dist units ahead of the ship, facing it (replacing the last one put
+ * there): with ai it moves its joints and fires like any robot, holding its place; without,
+ * it stays in its rest pose. Returns its object number or -1. */
+EMSCRIPTEN_KEEPALIVE int d2web_test_robot(int id, int dist, int ai)
+{
+	static int last = -1, last_sig;
+	vms_vector pos, back;
+	object *obj;
+	int seg;
+
+	if (last >= 0 && Objects[last].type == OBJ_ROBOT && Objects[last].signature == last_sig)
+		obj_delete(last);
+	last = -1;
+	if (!ConsoleObject || id < 0 || id >= N_robot_types)
+		return -1;
+	vm_vec_scale_add(&pos, &ConsoleObject->pos, &ConsoleObject->orient.fvec, i2f(dist));
+	if ((seg = find_point_seg(&pos, ConsoleObject->segnum)) < 0)
+		return -1;
+	if (!(obj = create_morph_robot(&Segments[seg], &pos, id)))
+		return -1;
+	back = ConsoleObject->orient.fvec;
+	vm_vec_negate(&back);
+	vm_vector_2_matrix(&obj->orient, &back, &ConsoleObject->orient.uvec, NULL);
+	obj->ctype.ai_info.behavior = AIB_STILL;
+	if (!ai)
+		obj->control_type = CT_NONE;
+	last = obj - Objects;
+	last_sig = obj->signature;
+	return last;
+}
+
+/* Sets a robot's shields to percent of its full strength (damaged robots smoke). */
+EMSCRIPTEN_KEEPALIVE void d2web_test_shields(int objnum, int percent)
+{
+	if (objnum >= 0 && objnum <= Highest_object_index && Objects[objnum].type == OBJ_ROBOT)
+		Objects[objnum].shields = Robot_info[Objects[objnum].id].strength * percent / 100;
+}
+
+/* 0 draws the game's own models instead of the loaded high-resolution ones. */
+extern int xmodel_enabled;
+EMSCRIPTEN_KEEPALIVE void d2web_test_hires_models(int on)
+{
+	xmodel_enabled = on;
+}
