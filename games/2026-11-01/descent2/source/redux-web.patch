+// The game model's flat-shaded polygon colors (15-bit RGB), each once, in the order the
+// interpreter meets them: what the models' "colour N" materials stand for.
+#define W(p) (*(short *)(p))
+static void flat_colors(ubyte *p, short *colors, int *n) {
+	for (;;)
+		switch (W(p)) {
+			case 0:	// OP_EOF
+				return;
+			case 1:	// OP_DEFPOINTS
+				p += W(p + 2) * sizeof(vms_vector) + 4;
+				break;
+			case 7:	// OP_DEFP_START
+				p += W(p + 2) * sizeof(vms_vector) + 8;
+				break;
+			case 2: {	// OP_FLATPOLY
+				int i;
+				for (i = 0; i < *n && colors[i] != W(p + 28); i++)
+					;
+				if (i == *n && *n < 16)
+					colors[(*n)++] = W(p + 28);
+				p += 30 + ((W(p + 2) & ~1) + 1) * 2;
+				break;
+			}
+			case 3:	// OP_TMAPPOLY
+				p += 30 + ((W(p + 2) & ~1) + 1) * 2 + W(p + 2) * 12;
+				break;
+			case 4:	// OP_SORTNORM
+				flat_colors(p + W(p + 28), colors, n);
+				flat_colors(p + W(p + 30), colors, n);
+				p += 32;
+				break;
+			case 5:	// OP_RODBM
+				p += 36;
+				break;
+			case 6:	// OP_SUBCALL
+				flat_colors(p + W(p + 16), colors, n);
+				p += 20;
+				break;
+			case 8:	// OP_GLOW
+				p += 4;
+				break;
+			default:
+				return;
+		}
+}
+#undef W
