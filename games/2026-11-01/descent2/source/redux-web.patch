+#ifdef HAVE_LIBPNG
+extern "C" {
+#include "pngfile.h"
+}
+
+// Model textures named "x.tga" in a model ship as x.png (D2X-XL 2.x); animated ones are
+// vertical frame strips (name#0.png, frame k in row k): name#k is its own file or row k of
+// the strip. Loads as RGBA.
+static int32_t ReadPNG (CBitmap* pBm, const char *pszFile, int32_t alpha)
+{
+	char		szName [FILENAME_LEN], *psz, *pszHash;
+	png_data	pdata;
+	int32_t	nFrame = 0;
+
+CFile::SplitPath (pszFile, NULL, szName, NULL);
+if ((psz = strrchr (szName, '.')))
+	*psz = '\0';
+if ((pszHash = strchr (szName, '#')))
+	nFrame = atoi (pszHash + 1);
+strcat (szName, ".png");
+if (read_png (szName, &pdata))
+	nFrame = 0;	// a file of its own, or a strip it is the first frame of
+else {
+	if (!nFrame)
+		return 0;
+	strcpy (pszHash, "#0.png");
+	if (!read_png (szName, &pdata))
+		return 0;
+	}
+int32_t w = pdata.width, h = pdata.height, bpp = pdata.paletted ? 1 : pdata.channels, nOffset = 0;
+if (pdata.depth != 8 || (pdata.paletted && !pdata.palette)) {
+	free (pdata.data);
+	if (pdata.palette)
+		free (pdata.palette);
+	return 0;
+	}
+if (pszHash && h > w && !(h % w)) {
+	nOffset = (nFrame % (h / w)) * w * w;
+	h = w;
+	}
+pBm->SetName (pszFile);
+pBm->SetWidth (w);
+pBm->SetHeight (h);
+pBm->SetBPP (4);
+pBm->CreateBuffer ();
+uint8_t *d = pBm->Buffer ();
+for (int32_t i = nOffset; i < nOffset + w * h; i++, d += 4) {
+	const uint8_t *s = pdata.paletted ? pdata.palette + pdata.data [i] * 3 : pdata.data + i * bpp;
+	if (bpp >= 3 || pdata.paletted) {
+		d [0] = s [0];
+		d [1] = s [1];
+		d [2] = s [2];
+		}
+	else
+		d [0] = d [1] = d [2] = s [0];
+	d [3] = (bpp == 4) ? s [3] : (bpp == 2) ? s [1] : 255;
+	if ((d [0] == 120) && (d [1] == 88) && (d [2] == 128))	// D2X-XL super transparency
+		d [3] = 0;
+	else if (alpha >= 0)
+		d [3] = alpha;
+	}
+free (pdata.data);
+if (pdata.palette)
+	free (pdata.palette);
+return 1;
+}
