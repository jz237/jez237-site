+		switch (W(p)) {
+			case 1: {	// OP_DEFPOINTS
+				int n = W(p + 2);
+				if (n <= MAX_SURFACE_POINTS)
+					memcpy(pts, p + 4, n * sizeof(vms_vector));
+				p += n * sizeof(vms_vector) + 4;
+				break;
+			}
+			case 7: {	// OP_DEFP_START
+				int n = W(p + 2), start = W(p + 4);
+				if (start >= 0 && start + n <= MAX_SURFACE_POINTS)
+					memcpy(pts + start, p + 8, n * sizeof(vms_vector));
+				p += n * sizeof(vms_vector) + 8;
+				break;
+			}
+			case 2:	// OP_FLATPOLY
+			case 3: {	// OP_TMAPPOLY
+				int nv = W(p + 2), ok = 1;
+				const unsigned short *idx = (const unsigned short *)(p + 30);
+				for (int i = 0; i < nv; i++)
