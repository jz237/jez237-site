diff --git a/d2/arch/ogl/ogl_shader.c b/d2/arch/ogl/ogl_shader.c
new file mode 100644
index 0000000..e726f89
--- /dev/null
+++ b/d2/arch/ogl/ogl_shader.c
@@ -0,0 +1,194 @@
+/*
+ * Shaders for 2D art drawn much larger than its pixels (browser edition). Movies get an
+ * edge-aware sharp upscale and HUD, menu and title art a sharp Catmull-Rom one, instead of a
+ * bilinear stretch; font glyphs keep their shapes with smooth edges at screen resolution
+ * instead of blurred or blocky pixels.
+ *
+ * The GL emulation runs these as user programs: it rewrites the legacy built-ins (gl_Vertex,
+ * gl_MultiTexCoord0, gl_Color, ftransform()) and keeps feeding the client arrays as usual.
+ */
+
+#define GL_GLEXT_PROTOTYPES
+#include <GL/gl.h>
+#include <GL/glext.h>
+#include <stdio.h>
+#include "ogl_init.h"
+#include "console.h"
+#ifdef __EMSCRIPTEN__
+#include "../web/web.h"
+#endif
+
+static const char *vs_src =
+	"void main() {\n"
+	"	gl_TexCoord[0] = gl_MultiTexCoord0;\n"
+	"	gl_FrontColor = gl_Color;\n"
+	"	gl_Position = ftransform();\n"
+	"}\n";
+
+// Catmull-Rom in nine bilinear taps (positions in texels), the result clamped to the four
+// nearest texels so edges stay sharp without halos. lim keeps taps inside the image (textures
+// are padded to a power of two, and HUD pieces can share one). Movies (MOVIE defined) also
+// blend Catmull-Rom samples along each edge, which smooths the staircase of their low-res
+// pixels, then sharpen. Transparent texels are black with alpha 0, so dividing by alpha keeps
+// dark fringes off the edges of cut-out art.
+static const char *upscale_fs_src =
+	"uniform sampler2D tex;\n"
+	"uniform vec2 size;\n"
+	"uniform vec4 lim;\n"
+	"vec4 at(vec2 t) { return texture2D(tex, clamp(t / size, lim.xy, lim.zw)); }\n"
+	"vec4 cr(vec2 p) {\n"
+	"	vec2 t1 = floor(p - 0.5) + 0.5;\n"
+	"	vec2 f = p - t1;\n"
+	"	vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));\n"
+	"	vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);\n"
+	"	vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));\n"
+	"	vec2 w3 = f * f * (-0.5 + 0.5 * f);\n"
+	"	vec2 w12 = w1 + w2;\n"
+	"	vec2 u0 = t1 - 1.0, u3 = t1 + 2.0, u12 = t1 + w2 / w12;\n"
+	"	return (at(vec2(u0.x, u0.y)) * w0.x + at(vec2(u12.x, u0.y)) * w12.x + at(vec2(u3.x, u0.y)) * w3.x) * w0.y\n"
+	"		+ (at(vec2(u0.x, u12.y)) * w0.x + at(vec2(u12.x, u12.y)) * w12.x + at(vec2(u3.x, u12.y)) * w3.x) * w12.y\n"
+	"		+ (at(vec2(u0.x, u3.y)) * w0.x + at(vec2(u12.x, u3.y)) * w12.x + at(vec2(u3.x, u3.y)) * w3.x) * w3.y;\n"
+	"}\n"
+	"float lum(vec4 c) { return dot(c.rgb, vec3(0.3, 0.59, 0.11)); }\n"
+	"void main() {\n"
+	"	vec2 p = gl_TexCoord[0].xy * size;\n"
+	"	vec4 c = cr(p);\n"
+	"#ifdef MOVIE\n"
+	"	vec2 g = vec2(lum(at(p + vec2(1.0, 0.0))) - lum(at(p - vec2(1.0, 0.0))),\n"
+	"		lum(at(p + vec2(0.0, 1.0))) - lum(at(p - vec2(0.0, 1.0))));\n"
+	"	float gm = length(g) + 1e-6;\n"
+	"	vec2 t = vec2(-g.y, g.x) / gm;\n"
+	"	vec4 along = (c * 0.4 + (cr(p - t * 0.75) + cr(p + t * 0.75)) * 0.3 + (cr(p - t * 1.5) + cr(p + t * 1.5)) * 0.15) / 1.3;\n"
+	"	c = mix(c, along, clamp(gm * 6.0, 0.0, 1.0));\n"
+	"	vec4 blur = (at(p + vec2(0.7, 0.7)) + at(p + vec2(-0.7, 0.7)) + at(p + vec2(0.7, -0.7)) + at(p + vec2(-0.7, -0.7))) * 0.25;\n"
+	"	c += (c - blur) * 0.6;\n"
+	"#endif\n"
+	"	vec2 n = floor(p - 0.5) + 0.5;\n"
+	"	vec4 a = at(n), b = at(n + vec2(1.0, 0.0)), d = at(n + vec2(0.0, 1.0)), e = at(n + 1.0);\n"
+	"	c = clamp(c, min(min(a, b), min(d, e)), max(max(a, b), max(d, e)));\n"
+	"	gl_FragColor = vec4(c.rgb / max(c.a, 0.004), c.a) * gl_Color;\n"
+	"}\n";
+
+// The 0.5 coverage edge of the bilinear-filtered glyph, antialiased over one screen pixel.
+// Transparent texels are black with alpha 0, so rgb / alpha is the glyph's own color.
+static const char *glyph_fs_src =
+	"uniform sampler2D tex;\n"
+	"uniform float soft;\n"
+	"void main() {\n"
+	"	vec4 c = texture2D(tex, gl_TexCoord[0].xy);\n"
+	"	float a = smoothstep(0.5 - soft, 0.5 + soft, c.a);\n"
+	"	gl_FragColor = vec4(c.rgb / max(c.a, 0.004), a) * gl_Color;\n"
+	"}\n";
+
+static GLuint compile(GLenum type, const char *defines, const char *src)
+{
+	GLint ok = 0;
+	GLuint s = glCreateShader(type);
+	const char *parts[2] = { defines, src };
+	glShaderSource(s, 2, parts, NULL);
+	glCompileShader(s);
+	glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		char log[512];
+		glGetShaderInfoLog(s, sizeof(log), NULL, log);
+		con_printf(CON_URGENT, "shader: %s\n", log);
+		glDeleteShader(s);
+		return 0;
+	}
+	return s;
+}
+
+static GLuint link(const char *defines, const char *fs_src)
+{
+	GLint ok = 0;
+	GLuint vs = compile(GL_VERTEX_SHADER, "", vs_src), fs = compile(GL_FRAGMENT_SHADER, defines, fs_src), p;
+	if (!vs || !fs)
+		return 0;
+	p = glCreateProgram();
+	glAttachShader(p, vs);
+	glAttachShader(p, fs);
+	glLinkProgram(p);
+	glGetProgramiv(p, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		char log[512];
+		glGetProgramInfoLog(p, sizeof(log), NULL, log);
+		con_printf(CON_URGENT, "shader link: %s\n", log);
+		glDeleteProgram(p);
+		return 0;
+	}
+	return p;
+}
+
+typedef struct upscale_shader {
+	GLuint prog;
+	GLint size, lim;
+} upscale_shader;
+static upscale_shader upscale[2];	// art, movies
+static GLuint glyph_prog, active;
+static GLint glyph_soft;
+static int tried;
+
+static void upscale_init(upscale_shader *u, const char *defines)
+{
+	if (!(u->prog = link(defines, upscale_fs_src)))
+		return;
+	glUseProgram(u->prog);
+	glUniform1i(glGetUniformLocation(u->prog, "tex"), 0);
+	u->size = glGetUniformLocation(u->prog, "size");
+	u->lim = glGetUniformLocation(u->prog, "lim");
+}
+
+static int ogl_shaders_ready(void)
+{
+	if (!tried) {
+		tried = 1;
+		upscale_init(&upscale[0], "");
+		upscale_init(&upscale[1], "#define MOVIE 1\n");
+		if ((glyph_prog = link("", glyph_fs_src))) {
+			glUseProgram(glyph_prog);
+			glUniform1i(glGetUniformLocation(glyph_prog, "tex"), 0);
+			glyph_soft = glGetUniformLocation(glyph_prog, "soft");
+		}
+		glUseProgram(0);
+	}
+	return upscale[0].prog && upscale[1].prog && glyph_prog;
+}
+
+int ogl_sharp_enabled(void)
+{
+#ifdef __EMSCRIPTEN__
+	return d2web_option(D2WEB_OPTION_SHARP) && ogl_shaders_ready();
+#else
+	return 0;
+#endif
+}
+
+#define MIN_SCALE 1.25f
+
+// For the part u1,v1 - u2,v2 of a texture drawn magnified (scale = screen pixels per texel).
+// Not while glyphs are drawn: they have their own shader.
+int ogl_upscale_begin(ogl_texture *tex, float u1, float v1, float u2, float v2, float scale, int movie)
+{
+	upscale_shader *u = &upscale[movie ? 1 : 0];
+	if (scale < MIN_SCALE || active || !tex->tw || !tex->th || !ogl_sharp_enabled())
+		return 0;
+	glUseProgram(active = u->prog);
+	glUniform2f(u->size, tex->tw, tex->th);
+	glUniform4f(u->lim, u1 + 0.5f / tex->tw, v1 + 0.5f / tex->th, u2 - 0.5f / tex->tw, v2 - 0.5f / tex->th);
+	return 1;
+}
+
+// scale = screen pixels per glyph texel
+int ogl_glyph_begin(float scale)
+{
+	if (scale < MIN_SCALE || !ogl_sharp_enabled())
+		return 0;
+	glUseProgram(active = glyph_prog);
+	glUniform1f(glyph_soft, 0.5f / scale);
+	return 1;
+}
+
+void ogl_shader_end(void)
+{
+	glUseProgram(active = 0);
+}
