+// The game model's own textures settle the look: a robot's eye color is a frame of an
+// animated texture, which the models name as frame 0, and the colors should match the
+// game bitmaps (see ogl_fit_png).
+static void fit_textures(render_model& rm, polymodel *po) {
+	int changed = 0, nflat = 0;
+	short flat[16];
+	flat_colors(po->model_data, flat, &nflat);
+	for (int i = 0; i < rm.m.m_textures.m_nBitmaps; i++) {
+		CBitmap& bm = rm.m.m_textures.m_bitmaps[i];
+		const char *file = rm.m.m_textures.m_names[i].Buffer();
+		char name[64];
+		int c = rm.m.m_nFlat[i];
+		if (c >= 0 && c < nflat && bm.Buffer()) {	// as gr_find_closest_color_15bpp reads it
+			uint8_t *d = bm.Buffer();
+			d[0] = ((flat[c] >> 10) & 31) * 255 / 31;
+			d[1] = ((flat[c] >> 5) & 31) * 255 / 31;
+			d[2] = (flat[c] & 31) * 255 / 31;
+			changed = 1;
+		}
+		if (!file || bm.BPP() != 4)
+			continue;
+		snprintf(name, sizeof(name), "%s", file);
+		if (char *p = strrchr(name, '.'))
+			*p = '\0';
+		size_t base = strcspn(name, "#");
+		int t;
+		for (t = 0; t < po->n_textures; t++) {
+			bitmap_index bi = ObjBitmaps[ObjBitmapPtrs[po->first_texture + t]];
+			PIGGY_PAGE_IN(bi);
+			grs_bitmap *gb = &GameBitmaps[bi.index];
+			const char *gname = piggy_game_bitmap_name(gb);
+			if (!gname || strncmp(gname, name, base) || (gname[base] && gname[base] != '#'))
+				continue;
+			if (strcmp(gname, name)) {
+				char gfile[64];
+				snprintf(gfile, sizeof(gfile), "%s.png", gname);
+				CTGA tga(&bm);
+				if (!tga.ReadModelTexture(gfile, 0))
+					break;
+			}
+			ogl_match_bitmap_colors(gb, bm.Buffer(), bm.Width(), bm.Height());
+			changed = 1;
+			int objbm = ObjBitmapPtrs[po->first_texture + t];
+			for (int e = 0; e < Num_effects; e++) {
+				vclip& vc = Effects[e].vc;
+				if (Effects[e].changing_object_texture != objbm || rm.nanims >= MAX_ANIM_TEX || vc.num_frames <= 0)
+					continue;
+				if (!rm.anims)
+					rm.anims = new anim_tex[MAX_ANIM_TEX]();
+				anim_tex& at = rm.anims[rm.nanims++];
+				at.bitmap = i;
+				at.objbm = objbm;
+				at.nframes = vc.num_frames < VCLIP_MAX_FRAMES ? vc.num_frames : VCLIP_MAX_FRAMES;
+				for (int k = 0; k < at.nframes; k++) {
+					grs_bitmap *fb = &GameBitmaps[at.game[k] = vc.frames[k].index];
+					const char *fname = piggy_game_bitmap_name(fb);
+					char ffile[64];
+					if (!fname)
+						continue;
+					snprintf(ffile, sizeof(ffile), "%s.png", fname);
+					CTGA ftga(&at.frames[k]);
+					if (!ftga.ReadModelTexture(ffile, 0))
+						continue;
+					PIGGY_PAGE_IN(vc.frames[k]);
+					ogl_match_bitmap_colors(fb, at.frames[k].Buffer(), at.frames[k].Width(), at.frames[k].Height());
+				}
+				break;
+			}
+			break;
+		}
+		// a texture the game model doesn't use (Vertigo's robots have textures of their own)
+		// still matches the game bitmap it is named after
+		if (t == po->n_textures) {
+			bitmap_index bi = piggy_find_bitmap(name);
+			if (bi.index > 0) {
+				PIGGY_PAGE_IN(bi);
+				ogl_match_bitmap_colors(&GameBitmaps[bi.index], bm.Buffer(), bm.Width(), bm.Height());
+				changed = 1;
+			}
+		}
+	}
+	fit_brightness(rm, po);
+	if (changed)
+		xmodel_free_gl(&rm);
+}
