+// Shades like the game's own models: a quarter of the light, plus the rest on faces turned
+// toward the viewer. view is the view direction in model coordinates.
+static void shade(render_model& rm, const float *view, float rot[][9], g3s_lrgb *light, float alpha, int parts) {
+	float a = alpha;
+	for (int r = 0; r < rm.nranges; r++) {
+		range& rg = rm.ranges[r];
+		const float *m = rot[rg.sub];
+		float gain = parts ? rm.part_gain[rg.sub] : rm.gain;
+		float lr = f2fl(light->r) * gain, lg = f2fl(light->g) * gain, lb = f2fl(light->b) * gain;
+		if (rm.m.m_nFlat[rg.bitmap] != -2) {	// flat colors: the game draws its flat polygons unlit
+			for (int i = rg.first; i < rg.first + rg.count; i++) {
+				float *c = rm.verts[i].color;
+				c[0] = c[1] = c[2] = 1;
+				c[3] = a;
+			}
+			continue;
+		}
+		// the view direction in the part's rest-pose axes
+		float d[3] = {
+			m[0] * view[0] + m[1] * view[1] + m[2] * view[2],
+			m[3] * view[0] + m[4] * view[1] + m[5] * view[2],
+			m[6] * view[0] + m[7] * view[1] + m[8] * view[2] };
+		for (int i = rg.first; i < rg.first + rg.count; i++) {
+			const float *n = rm.normals + i * 3;
+			// either side: some parts are modelled with the opposite winding, and faces turned
+			// away are hidden behind the near ones anyway
+			float f = fabsf(n[0] * d[0] + n[1] * d[1] + n[2] * d[2]);
+			float l = 0.25f + 0.75f * f;
+			float *c = rm.verts[i].color;
+			c[0] = l * lr;
+			c[1] = l * lg;
+			c[2] = l * lb;
+			c[3] = a;
+		}
+	}
+}
