@@ -191,6 +194,40 @@ static void timer_start(void)
 	timer_started=1;
 }
 
+#ifdef __EMSCRIPTEN__
+// The browser can't block mid-frame (it would show a half-drawn screen), so instead of
+// sleeping until the next movie frame is due we report whether it is due yet.
+static int timer_frame_due(void)
+{
+	struct timeval tv;
+	long long now, expire;
+
+	if (!timer_started)
+		return 1;
+	gettimeofday(&tv, NULL);
+	now = (long long)tv.tv_sec * 1000000 + tv.tv_usec;
+	expire = (long long)timer_expire.tv_sec * 1000000 + timer_expire.tv_usec;
+	if (now < expire)
+		return 0;
+	if (now - expire > 1000000)	// fell far behind (tab was hidden): don't fast-forward
+		timer_start();
+	return 1;
+}
+
+static void timer_advance(void)
+{
+	int nsec;
+
+	timer_expire.tv_usec += micro_frame_delay;
+	if (timer_expire.tv_usec > 1000000)
+	{
+		nsec = timer_expire.tv_usec / 1000000;
+		timer_expire.tv_sec += nsec;
+		timer_expire.tv_usec -= nsec*1000000;
+	}
+}
+#endif
+
 static void do_timer_wait(void)
 {
 	int nsec=0;
@@ -216,6 +253,8 @@ static void do_timer_wait(void)
 	Sleep(ts.tv_sec * 1000 + ts.tv_nsec / 1000000);
 #elif defined(macintosh)
 	Delay(ts.tv_sec * 1000 + ts.tv_nsec / 1000000, NULL);
+#elif defined(__EMSCRIPTEN__)
+	emscripten_sleep(ts.tv_sec * 1000 + ts.tv_nsec / 1000000);
 #else
 	if (nanosleep(&ts, NULL) == -1  &&  errno == EINTR)
 		exit(1);
@@ -745,6 +784,16 @@ int MVE_rmStepMovie()
 	if (!timer_started)
 		timer_start();
 
+#ifdef __EMSCRIPTEN__
+	if (init_timer && !timer_frame_due())
+	{
+		// next movie frame isn't due: redraw the current one for this display frame
+		if (g_vBackBuf1 && video_initialized)
+			mve_showframe(g_vBackBuf1, g_destX, g_destY, g_width, g_height, g_screenWidth, g_screenHeight);
+		return 0;
+	}
+#endif
+
 	while (cont && !g_frameUpdated) // make a "step" be a frame, not a chunk...
 		cont = mve_play_next_chunk(mve);
 	g_frameUpdated = 0;
@@ -757,7 +806,12 @@ int MVE_rmStepMovie()
 		init_timer = 1;
 	}
 
+#ifdef __EMSCRIPTEN__
+	if (init_timer)
+		timer_advance();
+#else
 	do_timer_wait();
+#endif
 
 	return 0;
 }
